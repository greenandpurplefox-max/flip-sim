    <Item class="StarterPlayerScripts" referent="45">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="46">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local UiStyleFix = require(script.UiStyleFix)
local DungeonRunClient = require(script.DungeonRunClient)
local BlacksmithDialogueClient = require(script.BlacksmithDialogueClient)
local TreasureChestClient = require(script.TreasureChestClient)
local LobbyHubClient = require(script.LobbyHubClient)
local WeaponClient = require(script.WeaponClient)
local WeaponMenuClient = require(script.WeaponMenuClient)
local GrimoireOpenClient = require(script.GrimoireOpenClient)
local SpellMenuClient = require(script.SpellMenuClient)
local InfuserMenuClient = require(script.InfuserMenuClient)
local SpellClient = require(script.SpellClient)
local StaminaBarUI = require(script.StaminaBarUI)
local HealthBarUI = require(script.HealthBarUI)
local BossHealthBarUI = require(script.BossHealthBarUI)
local MovementClient = require(script.MovementClient)

UiStyleFix.init()
WeaponClient.init()
LobbyHubClient.init()
BlacksmithDialogueClient.init()
GrimoireOpenClient.init()
WeaponMenuClient.init()
SpellMenuClient.init()
InfuserMenuClient.init()
SpellClient.init()
StaminaBarUI.init()
HealthBarUI.init()
BossHealthBarUI.init()
MovementClient.init()
TreasureChestClient.init()
DungeonRunClient.init()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">BlacksmithDialogueClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local BlacksmithConfig = require(ReplicatedStorage.Shared.BlacksmithConfig)
local BobConfig = require(ReplicatedStorage.Shared.BobConfig)
local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local UiCorner = require(script.Parent.UiCorner)
local InfuserMenuClient = require(script.Parent.InfuserMenuClient)
local WeaponMenuClient = require(script.Parent.WeaponMenuClient)

local BlacksmithDialogueClient = {}

local GOLD = Color3.fromRGB(214, 176, 72)
local PANEL = Color3.fromRGB(24, 18, 16)
local PANEL_LIGHT = Color3.fromRGB(42, 34, 28)
local TEXT = Color3.fromRGB(244, 228, 196)
local TEXT_DIM = Color3.fromRGB(170, 154, 128)

type DialogueNpc = {
	objectText: string,
	lines: { string },
}

function BlacksmithDialogueClient.init()
	if not LobbyConfig.USE_LOBBY then
		return
	end

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local phaseStateEvent = ReplicatedStorage:WaitForChild("PlayerPhaseState") :: RemoteEvent

	local currentPhase = "Lobby"
	local dialogueOpen = false
	local dialogueIndex = 1
	local activeNpc: DialogueNpc? = nil

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "NpcDialogueUI"
	screenGui.ResetOnSpawn = false
	screenGui.Enabled = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.Name = "DialoguePanel"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -24)
	panel.Size = UDim2.fromOffset(560, 190)
	panel.BackgroundColor3 = PANEL
	panel.BorderSizePixel = 0
	panel.Parent = screenGui

	UiCorner.apply(panel, 14)

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = GOLD
	panelStroke.Thickness = 2
	panelStroke.Parent = panel

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.fromOffset(20, 14)
	nameLabel.Size = UDim2.new(1, -40, 0, 28)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Text = ""
	nameLabel.TextColor3 = GOLD
	nameLabel.TextSize = 22
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = panel

	local bodyLabel = Instance.new("TextLabel")
	bodyLabel.BackgroundTransparency = 1
	bodyLabel.Position = UDim2.fromOffset(20, 48)
	bodyLabel.Size = UDim2.new(1, -40, 0, 88)
	bodyLabel.Font = Enum.Font.Gotham
	bodyLabel.Text = ""
	bodyLabel.TextColor3 = TEXT
	bodyLabel.TextSize = 17
	bodyLabel.TextWrapped = true
	bodyLabel.TextXAlignment = Enum.TextXAlignment.Left
	bodyLabel.TextYAlignment = Enum.TextYAlignment.Top
	bodyLabel.Parent = panel

	local progressLabel = Instance.new("TextLabel")
	progressLabel.BackgroundTransparency = 1
	progressLabel.AnchorPoint = Vector2.new(1, 1)
	progressLabel.Position = UDim2.new(1, -20, 1, -16)
	progressLabel.Size = UDim2.fromOffset(80, 22)
	progressLabel.Font = Enum.Font.Gotham
	progressLabel.Text = "1/5"
	progressLabel.TextColor3 = TEXT_DIM
	progressLabel.TextSize = 14
	progressLabel.TextXAlignment = Enum.TextXAlignment.Right
	progressLabel.Parent = panel

	local continueButton = Instance.new("TextButton")
	continueButton.AnchorPoint = Vector2.new(0, 1)
	continueButton.Position = UDim2.new(0, 20, 1, -16)
	continueButton.Size = UDim2.fromOffset(140, 40)
	continueButton.BackgroundColor3 = GOLD
	continueButton.BorderSizePixel = 0
	continueButton.Font = Enum.Font.GothamBold
	continueButton.Text = "Continue"
	continueButton.TextColor3 = Color3.fromRGB(24, 18, 12)
	continueButton.TextSize = 16
	continueButton.Parent = panel

	UiCorner.apply(continueButton, 10)

	local leaveButton = Instance.new("TextButton")
	leaveButton.AnchorPoint = Vector2.new(0, 1)
	leaveButton.Position = UDim2.new(0, 170, 1, -16)
	leaveButton.Size = UDim2.fromOffset(120, 40)
	leaveButton.BackgroundColor3 = PANEL_LIGHT
	leaveButton.BorderSizePixel = 0
	leaveButton.Font = Enum.Font.GothamBold
	leaveButton.Text = "Leave"
	leaveButton.TextColor3 = TEXT
	leaveButton.TextSize = 16
	leaveButton.Parent = panel

	UiCorner.apply(leaveButton, 10)

	local function renderLine()
		if not activeNpc then
			return
		end

		nameLabel.Text = activeNpc.objectText
		bodyLabel.Text = activeNpc.lines[dialogueIndex] or ""
		progressLabel.Text = `{dialogueIndex}/{#activeNpc.lines}`
		continueButton.Text = if dialogueIndex >= #activeNpc.lines then "Done" else "Continue"
	end

	local function closeDialogue()
		dialogueOpen = false
		activeNpc = nil
		screenGui.Enabled = false
	end

	local function openDialogue(npc: DialogueNpc)
		if currentPhase ~= "Lobby" then
			return
		end

		activeNpc = npc
		dialogueIndex = 1
		dialogueOpen = true
		screenGui.Enabled = true
		renderLine()
	end

	local function advanceDialogue()
		if not activeNpc then
			return
		end

		if dialogueIndex >= #activeNpc.lines then
			closeDialogue()
			return
		end

		dialogueIndex += 1
		renderLine()
	end

	continueButton.MouseButton1Click:Connect(advanceDialogue)
	leaveButton.MouseButton1Click:Connect(closeDialogue)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not dialogueOpen then
			return
		end

		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Return then
			advanceDialogue()
		elseif input.KeyCode == Enum.KeyCode.Escape then
			closeDialogue()
		end
	end)

	phaseStateEvent.OnClientEvent:Connect(function(phase: string)
		if phase == "Lobby" or phase == "Dungeon" then
			currentPhase = phase
			if phase ~= "Lobby" then
				closeDialogue()
			end
		end
	end)

	local function bindDialogueNpc(model: Model, npc: DialogueNpc)
		local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end

		local prompt = root:FindFirstChildOfClass("ProximityPrompt")
		if not prompt then
			return
		end

		prompt.Triggered:Connect(function(triggerPlayer)
			if triggerPlayer ~= player or currentPhase ~= "Lobby" then
				return
			end

			if dialogueOpen and activeNpc == npc then
				advanceDialogue()
			else
				openDialogue(npc)
			end
		end)
	end

	local function bindInfuser(model: Model)
		local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end

		local prompt = root:FindFirstChildOfClass("ProximityPrompt")
		if not prompt then
			return
		end

		prompt.Triggered:Connect(function(triggerPlayer)
			if triggerPlayer ~= player or currentPhase ~= "Lobby" then
				return
			end

			InfuserMenuClient.open()
		end)
	end

	local function bindBlacksmith(model: Model)
		local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end

		local prompt = root:FindFirstChildOfClass("ProximityPrompt")
		if not prompt then
			return
		end

		prompt.Triggered:Connect(function(triggerPlayer)
			if triggerPlayer ~= player or currentPhase ~= "Lobby" then
				return
			end

			WeaponMenuClient.openToTab("Upgrade")
		end)
	end

	local bobNpc: DialogueNpc = {
		objectText = BobConfig.PROMPT_OBJECT_TEXT,
		lines = BobConfig.getDialogueLines(),
	}

	task.spawn(function()
		local lobby = workspace:WaitForChild("Lobby", 30)
		if not lobby then
			return
		end

		local function tryBind(child: Instance)
			if not child:IsA("Model") then
				return
			end

			if child.Name == "Blacksmith" then
				bindBlacksmith(child)
			elseif child.Name == "Bob" then
				bindDialogueNpc(child, bobNpc)
			elseif child.Name == "Infuser" then
				bindInfuser(child)
			end
		end

		for _, child in lobby:GetChildren() do
			tryBind(child)
		end

		lobby.ChildAdded:Connect(tryBind)
	end)
end

return BlacksmithDialogueClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">BossHealthBarUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local BossConfig = require(ReplicatedStorage.Shared.BossConfig)
local DungeonConfig = require(ReplicatedStorage.Shared.DungeonConfig)
local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local UiCorner = require(script.Parent.UiCorner)

local BossHealthBarUI = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local PALETTE = {
	shadow = Color3.fromRGB(8, 4, 10),
	woodDark = Color3.fromRGB(36, 18, 14),
	woodMid = Color3.fromRGB(58, 30, 22),
	gold = Color3.fromRGB(228, 188, 84),
	goldBright = Color3.fromRGB(255, 228, 140),
	goldDim = Color3.fromRGB(148, 112, 42),
	ruby = Color3.fromRGB(168, 24, 48),
	crimson = Color3.fromRGB(132, 20, 32),
	parchment = Color3.fromRGB(244, 228, 196),
	bossRed = Color3.fromRGB(220, 60, 60),
	bossRedBright = Color3.fromRGB(255, 110, 90),
}

local screenGui: ScreenGui
local container: Frame
local fillBar: Frame
local fillGlow: Frame
local nameLabel: TextLabel
local healthLabel: TextLabel

local watchingBossFight = false
local inDungeon = false
local boundBoss: Model? = nil
local boundHumanoid: Humanoid? = nil
local bossConnections: { RBXScriptConnection } = {}

local function disconnectBoss()
	for _, connection in bossConnections do
		connection:Disconnect()
	end
	table.clear(bossConnections)
	boundBoss = nil
	boundHumanoid = nil
end

local function addCorner(instance: GuiObject, radius: number)
	UiCorner.apply(instance, radius)
end

local function addStroke(instance: GuiObject, color: Color3, thickness: number, transparency: number?)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Transparency = transparency or 0
	stroke.Parent = instance
end

local function styleText(label: TextLabel, size: number, color: Color3?)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Antique
	label.TextColor3 = color or PALETTE.parchment
	label.TextSize = size
	label.TextStrokeColor3 = PALETTE.shadow
	label.TextStrokeTransparency = 0.15
end

local function updateBar(health: number, maxHealth: number)
	local ratio = if maxHealth > 0 then math.clamp(health / maxHealth, 0, 1) else 0

	fillBar.BackgroundColor3 = PALETTE.bossRed
	fillGlow.BackgroundColor3 = PALETTE.bossRedBright
	TweenService:Create(fillBar, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(ratio, 0, 1, 0),
	}):Play()

	healthLabel.Text = `{math.floor(health)} / {math.floor(maxHealth)}`
end

local function hideBar()
	disconnectBoss()
	container.Visible = false
end

local function showBar(humanoid: Humanoid)
	container.Visible = true
	updateBar(humanoid.Health, humanoid.MaxHealth)
end

local function bindBoss(boss: Model, humanoid: Humanoid)
	if boundBoss == boss then
		return
	end

	disconnectBoss()
	boundBoss = boss
	boundHumanoid = humanoid

	nameLabel.Text = BossConfig.DISPLAY_NAME
	showBar(humanoid)

	table.insert(bossConnections, humanoid.HealthChanged:Connect(function(newHealth)
		updateBar(newHealth, humanoid.MaxHealth)
		if newHealth <= 0 then
			hideBar()
		end
	end))

	table.insert(bossConnections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		updateBar(humanoid.Health, humanoid.MaxHealth)
	end))

	table.insert(bossConnections, boss.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			hideBar()
		end
	end))

	table.insert(bossConnections, humanoid.Died:Connect(function()
		hideBar()
	end))
end

local function findPlayerBoss(): (Model?, Humanoid?)
	local monstersFolder = workspace:FindFirstChild("WaveMonsters")
	if not monstersFolder then
		return nil, nil
	end

	for _, child in monstersFolder:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("IsBoss") == true then
			if child:GetAttribute("DungeonOwner") == player.UserId then
				local humanoid = child:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					return child, humanoid
				end
			end
		end
	end

	return nil, nil
end

local function refreshBossBinding()
	if not inDungeon or not watchingBossFight then
		hideBar()
		return
	end

	local boss, humanoid = findPlayerBoss()
	if boss and humanoid then
		bindBoss(boss, humanoid)
	elseif boundBoss then
		hideBar()
	end
end

local function setWatchingBossFight(active: boolean)
	watchingBossFight = active
	if not active then
		hideBar()
	end
end

local function createUI()
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BossHealthBarUI"
	screenGui.ResetOnSpawn = false
	screenGui.Enabled = true
	screenGui.Parent = playerGui

	container = Instance.new("Frame")
	container.Name = "BossHealthContainer"
	container.AnchorPoint = Vector2.new(0.5, 0)
	container.BackgroundColor3 = PALETTE.woodDark
	container.BorderSizePixel = 0
	container.Position = UDim2.new(0.5, 0, 0, 14)
	container.Size = UDim2.fromOffset(420, 58)
	container.Visible = false
	container.ZIndex = 20
	container.Parent = screenGui
	addCorner(container, 10)
	addStroke(container, PALETTE.gold, 2)
	addStroke(container, PALETTE.shadow, 4, 0.35)

	local crestBand = Instance.new("Frame")
	crestBand.Name = "CrestBand"
	crestBand.BackgroundColor3 = PALETTE.woodMid
	crestBand.BorderSizePixel = 0
	crestBand.Position = UDim2.fromOffset(10, 8)
	crestBand.Size = UDim2.new(1, -20, 0, 18)
	crestBand.ZIndex = 21
	crestBand.Parent = container
	addCorner(crestBand, 5)
	addStroke(crestBand, PALETTE.goldDim, 1)

	nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "BossName"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.fromOffset(8, 0)
	nameLabel.Size = UDim2.new(0.55, 0, 1, 0)
	nameLabel.Text = BossConfig.DISPLAY_NAME
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.ZIndex = 22
	styleText(nameLabel, 16, PALETTE.goldBright)
	nameLabel.Parent = crestBand

	healthLabel = Instance.new("TextLabel")
	healthLabel.Name = "HealthLabel"
	healthLabel.BackgroundTransparency = 1
	healthLabel.Position = UDim2.new(1, -108, 0, 0)
	healthLabel.Size = UDim2.fromOffset(100, 18)
	healthLabel.Text = "0 / 0"
	healthLabel.TextXAlignment = Enum.TextXAlignment.Right
	healthLabel.ZIndex = 22
	styleText(healthLabel, 14, PALETTE.parchment)
	healthLabel.Parent = crestBand

	local barFrame = Instance.new("Frame")
	barFrame.Name = "BarFrame"
	barFrame.BackgroundColor3 = PALETTE.shadow
	barFrame.BorderSizePixel = 0
	barFrame.Position = UDim2.fromOffset(12, 32)
	barFrame.Size = UDim2.new(1, -24, 0, 16)
	barFrame.ClipsDescendants = true
	barFrame.ZIndex = 21
	barFrame.Parent = container
	addCorner(barFrame, 4)
	addStroke(barFrame, PALETTE.goldDim, 1)

	local barInset = Instance.new("Frame")
	barInset.Name = "BarInset"
	barInset.BackgroundColor3 = Color3.fromRGB(18, 12, 14)
	barInset.BorderSizePixel = 0
	barInset.Size = UDim2.new(1, -4, 1, -4)
	barInset.Position = UDim2.fromOffset(2, 2)
	barInset.ClipsDescendants = true
	barInset.ZIndex = 22
	barInset.Parent = barFrame
	addCorner(barInset, 3)

	fillBar = Instance.new("Frame")
	fillBar.Name = "Fill"
	fillBar.BackgroundColor3 = PALETTE.bossRed
	fillBar.BorderSizePixel = 0
	fillBar.Size = UDim2.fromScale(1, 1)
	fillBar.ZIndex = 23
	fillBar.Parent = barInset

	fillGlow = Instance.new("Frame")
	fillGlow.Name = "FillGlow"
	fillGlow.BackgroundColor3 = PALETTE.bossRedBright
	fillGlow.BackgroundTransparency = 0.65
	fillGlow.BorderSizePixel = 0
	fillGlow.Size = UDim2.new(1, 0, 0.45, 0)
	fillGlow.ZIndex = 24
	fillGlow.Parent = fillBar
end

function BossHealthBarUI.init()
	if not DungeonConfig.USE_DUNGEON_MODE then
		return
	end

	createUI()

	local dungeonRunStateEvent = ReplicatedStorage:WaitForChild("DungeonRunState") :: RemoteEvent
	dungeonRunStateEvent.OnClientEvent:Connect(function(state: any)
		if not state then
			setWatchingBossFight(false)
			return
		end

		local shouldWatch = state.status == "fighting" and state.isBossRoom == true
		setWatchingBossFight(shouldWatch)
		refreshBossBinding()
	end)

	if LobbyConfig.USE_LOBBY then
		local phaseStateEvent = ReplicatedStorage:WaitForChild("PlayerPhaseState") :: RemoteEvent
		phaseStateEvent.OnClientEvent:Connect(function(phase: string)
			inDungeon = phase == "Dungeon"
			if not inDungeon then
				setWatchingBossFight(false)
			end
		end)
	else
		inDungeon = true
	end

	RunService.Heartbeat:Connect(function()
		if watchingBossFight and inDungeon and not boundBoss then
			refreshBossBinding()
		end
	end)
end

return BossHealthBarUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">DungeonRunClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardConfig = require(ReplicatedStorage.Shared.CardConfig)
local DungeonConfig = require(ReplicatedStorage.Shared.DungeonConfig)
local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local UiCorner = require(script.Parent.UiCorner)

local DungeonRunClient = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local GOLD = Color3.fromRGB(214, 176, 72)
local PANEL = Color3.fromRGB(24, 18, 16)
local TEXT = Color3.fromRGB(244, 228, 196)

local screenGui: ScreenGui
local statusLabel: TextLabel
local cardPanel: Frame
local cardButtons: { TextButton } = {}
local cardConnections: { RBXScriptConnection } = {}

local function createUI()
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "DungeonRunUI"
	screenGui.ResetOnSpawn = false
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "RunStatus"
	statusLabel.AnchorPoint = Vector2.new(0.5, 1)
	statusLabel.Size = UDim2.fromOffset(520, 56)
	statusLabel.Position = UDim2.new(0.5, 0, 1, -12)
	statusLabel.BackgroundColor3 = PANEL
	statusLabel.BorderSizePixel = 0
	statusLabel.Font = Enum.Font.GothamBold
	statusLabel.Text = "Entering the dungeon..."
	statusLabel.TextColor3 = TEXT
	statusLabel.TextSize = 17
	statusLabel.TextWrapped = true
	statusLabel.ZIndex = 8
	statusLabel.Parent = screenGui

	UiCorner.apply(statusLabel, 10)

	local statusStroke = Instance.new("UIStroke")
	statusStroke.Color = GOLD
	statusStroke.Thickness = 2
	statusStroke.Parent = statusLabel

	cardPanel = Instance.new("Frame")
	cardPanel.Name = "CardDraftPanel"
	cardPanel.AnchorPoint = Vector2.new(0.5, 0.5)
	cardPanel.Position = UDim2.fromScale(0.5, 0.5)
	cardPanel.Size = UDim2.fromOffset(720, 260)
	cardPanel.BackgroundColor3 = PANEL
	cardPanel.BorderSizePixel = 0
	cardPanel.Visible = false
	cardPanel.Parent = screenGui

	UiCorner.apply(cardPanel, 14)

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = GOLD
	panelStroke.Thickness = 2
	panelStroke.Parent = cardPanel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(20, 16)
	title.Size = UDim2.new(1, -40, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.Text = "Choose a Relic"
	title.TextColor3 = GOLD
	title.TextSize = 24
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = cardPanel

	local subtitle = Instance.new("TextLabel")
	subtitle.BackgroundTransparency = 1
	subtitle.Position = UDim2.fromOffset(20, 44)
	subtitle.Size = UDim2.new(1, -40, 0, 20)
	subtitle.Font = Enum.Font.Gotham
	subtitle.Text = "Pick one card to empower your dungeon run."
	subtitle.TextColor3 = TEXT
	subtitle.TextSize = 14
	subtitle.TextXAlignment = Enum.TextXAlignment.Left
	subtitle.Parent = cardPanel

	local list = Instance.new("Frame")
	list.Name = "CardList"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromOffset(20, 82)
	list.Size = UDim2.new(1, -40, 1, -98)
	list.Parent = cardPanel

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 12)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	for index = 1, 3 do
		local button = Instance.new("TextButton")
		button.Name = `CardButton{index}`
		button.Size = UDim2.fromOffset(210, 140)
		button.BackgroundColor3 = Color3.fromRGB(42, 32, 28)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.GothamBold
		button.TextColor3 = TEXT
		button.TextSize = 16
		button.TextWrapped = true
		button.Visible = false
		button.LayoutOrder = index
		button.Parent = list

		UiCorner.apply(button, 10)

		table.insert(cardButtons, button)
	end
end

local function clearCardConnections()
	for _, connection in cardConnections do
		connection:Disconnect()
	end
	table.clear(cardConnections)
end

local function hideCardDraft()
	clearCardConnections()
	cardPanel.Visible = false
	for _, button in cardButtons do
		button.Visible = false
	end
end

local function showCardDraft(options: { string }, pickEvent: RemoteEvent)
	clearCardConnections()

	for index, cardId in options do
		local card = CardConfig.getCard(cardId)
		local button = cardButtons[index]
		if card and button then
			button.Text = `{card.name}\n\n{card.description}`
			button.Visible = true
			table.insert(
				cardConnections,
				button.MouseButton1Click:Connect(function()
					pickEvent:FireServer(cardId)
					hideCardDraft()
				end)
			)
		end
	end

	cardPanel.Visible = true
end

local function renderRunState(state: any)
	if not state then
		statusLabel.Text = "Run ended."
		hideCardDraft()
		return
	end

	local bossText = if state.isBossRoom then "  |  BOSS ROOM" else ""
	local cardCount = if state.activeCards then #state.activeCards else 0
	local chestCount = if typeof(state.runChestCount) == "number" then state.runChestCount else 0
	local chestText = if chestCount > 0 then `  |  Chests: {chestCount}` else ""

	if state.status == "fighting" then
		statusLabel.Text =
			`Depth {state.room}{bossText}  |  Beasts left: {state.monstersRemaining}  |  Gold: {state.gold}{chestText}  |  Relics: {cardCount}`
	elseif state.status == "card_draft" then
		statusLabel.Text = `Depth {state.room} cleared  |  Gold: {state.gold}{chestText}  |  Choose a relic...`
	elseif state.status == "intermission" then
		statusLabel.Text = `Depth {state.room} cleared  |  Gold: {state.gold}{chestText}  |  Deeper...`
	else
		statusLabel.Text = `Depth {state.room}  |  Gold: {state.gold}{chestText}  |  Relics: {cardCount}`
	end
end

function DungeonRunClient.init()
	if not DungeonConfig.USE_DUNGEON_MODE then
		return
	end

	createUI()

	local dungeonRunStateEvent = ReplicatedStorage:WaitForChild("DungeonRunState") :: RemoteEvent
	local cardDraftPickEvent = ReplicatedStorage:WaitForChild("CardDraftPick") :: RemoteEvent

	dungeonRunStateEvent.OnClientEvent:Connect(function(state, draftOptions: { string }?)
		renderRunState(state)
		if draftOptions and #draftOptions > 0 then
			showCardDraft(draftOptions, cardDraftPickEvent)
		elseif not state or state.status ~= "card_draft" then
			hideCardDraft()
		end
	end)

	if LobbyConfig.USE_LOBBY then
		local phaseStateEvent = ReplicatedStorage:WaitForChild("PlayerPhaseState") :: RemoteEvent
		phaseStateEvent.OnClientEvent:Connect(function(phase: string)
			screenGui.Enabled = phase == "Dungeon"
			if phase == "Dungeon" then
				statusLabel.Text = "Entering the dungeon..."
			elseif phase ~= "Dungeon" then
				hideCardDraft()
			end
		end)
	end
end

return DungeonRunClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">GrimoireOpenClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local SpellConfig = require(ReplicatedStorage.Shared.SpellConfig)

local GrimoireOpenClient = {}

local GRIMOIRE = Color3.fromRGB(180, 120, 255)
local GRIMOIRE_BRIGHT = Color3.fromRGB(220, 180, 255)
local PAGE = Color3.fromRGB(236, 224, 196)
local SHADOW = Color3.fromRGB(8, 4, 10)
local REQUIRED_TAPS = 3

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local useGrimoireEvent: RemoteEvent
local grimoireUsedEvent: RemoteEvent

local screenGui: ScreenGui
local backdrop: Frame
local container: Frame
local spellRevealLabel: TextLabel
local tapHintLabel: TextLabel
local viewportHost: Frame
local activeToken = 0
local pendingRevealHandler: ((any) -> ())? = nil

local function smoothstep(alpha: number): number
	alpha = math.clamp(alpha, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

local function weld(part0: BasePart, part1: BasePart)
	local weldConstraint = Instance.new("WeldConstraint")
	weldConstraint.Part0 = part0
	weldConstraint.Part1 = part1
	weldConstraint.Parent = part0
end

local function buildBookModel(): (Model, { BasePart }, BasePart, BasePart)
	local book = Instance.new("Model")
	book.Name = "GrimoireBook"

	local cover = Instance.new("Part")
	cover.Name = "Cover"
	cover.Size = Vector3.new(0.62, 0.82, 0.1)
	cover.Color = GRIMOIRE
	cover.Material = Enum.Material.SmoothPlastic
	cover.Anchored = true
	cover.CanCollide = false
	cover.Parent = book

	local spine = Instance.new("Part")
	spine.Name = "Spine"
	spine.Size = Vector3.new(0.12, 0.82, 0.14)
	spine.Color = Color3.fromRGB(92, 58, 128)
	spine.Material = Enum.Material.SmoothPlastic
	spine.Anchored = true
	spine.CanCollide = false
	spine.Parent = book

	local back = Instance.new("Part")
	back.Name = "BackCover"
	back.Size = Vector3.new(0.58, 0.78, 0.08)
	back.Color = Color3.fromRGB(120, 82, 168)
	back.Material = Enum.Material.SmoothPlastic
	back.Anchored = true
	back.CanCollide = false
	back.Parent = book

	local revealPage = Instance.new("Part")
	revealPage.Name = "RevealPage"
	revealPage.Size = Vector3.new(0.54, 0.74, 0.05)
	revealPage.Color = PAGE
	revealPage.Material = Enum.Material.SmoothPlastic
	revealPage.Anchored = true
	revealPage.CanCollide = false
	revealPage.Parent = book

	local rune = Instance.new("Part")
	rune.Name = "Rune"
	rune.Size = Vector3.new(0.22, 0.22, 0.04)
	rune.Color = GRIMOIRE_BRIGHT
	rune.Material = Enum.Material.Neon
	rune.Anchored = true
	rune.CanCollide = false
	rune.Parent = revealPage

	cover.CFrame = CFrame.new(0.16, 0, 0.04)
	spine.CFrame = CFrame.new(-0.18, 0, 0)
	back.CFrame = CFrame.new(-0.16, 0, -0.02)
	revealPage.CFrame = CFrame.new(0.12, 0, 0.01)
	rune.CFrame = revealPage.CFrame * CFrame.new(0, 0.08, 0.03)

	weld(cover, spine)
	weld(cover, back)

	local pages: { BasePart } = {}
	for index = 1, REQUIRED_TAPS do
		local page = Instance.new("Part")
		page.Name = `FlipPage_{index}`
		page.Size = Vector3.new(0.52, 0.72, 0.03)
		page.Color = if index == REQUIRED_TAPS then PAGE else Color3.fromRGB(220, 208, 180)
		page.Material = Enum.Material.SmoothPlastic
		page.Anchored = true
		page.CanCollide = false
		page.Parent = book
		page.CFrame = CFrame.new(-0.18, 0, 0.02 + index * 0.015)
			* CFrame.new(0.26, 0, 0)
		table.insert(pages, page)
	end

	local light = Instance.new("PointLight")
	light.Color = GRIMOIRE_BRIGHT
	light.Brightness = 2
	light.Range = 7
	light.Parent = cover

	book.PrimaryPart = spine
	return book, pages, revealPage, rune
end

local function pageCFrame(spinePosition: Vector3, angleRadians: number, pageHalfWidth: number, lift: number): CFrame
	return CFrame.new(spinePosition)
		* CFrame.Angles(0, angleRadians, 0)
		* CFrame.new(pageHalfWidth, lift, 0.02)
end

local function flipPage(page: BasePart, spine: BasePart, onComplete: () -> ())
	local duration = 0.34
	local startTime = os.clock()
	local endAngle = -math.rad(168)
	local pageHalfWidth = 0.26
	local lift = (tonumber(string.match(page.Name, "%d+")) or 1) * 0.012

	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		if not page.Parent or not spine.Parent then
			connection:Disconnect()
			return
		end

		local spinePosition = spine.Position
		local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
		local angle = endAngle * smoothstep(alpha)
		page.CFrame = pageCFrame(spinePosition, angle, pageHalfWidth, lift)

		if alpha >= 1 then
			connection:Disconnect()
			page.Transparency = 1
			onComplete()
		end
	end)
end

local function ensureUI()
	if screenGui then
		return
	end

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "GrimoireOpenUI"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 22
	screenGui.Enabled = true
	screenGui.Parent = playerGui

	backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.BackgroundColor3 = Color3.new(0, 0, 0)
	backdrop.BackgroundTransparency = 0.42
	backdrop.BorderSizePixel = 0
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.Visible = false
	backdrop.ZIndex = 1
	backdrop.Parent = screenGui

	container = Instance.new("Frame")
	container.Name = "GrimoireOpenContainer"
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.BackgroundTransparency = 1
	container.Position = UDim2.fromScale(0.5, 0.5)
	container.Size = UDim2.fromOffset(620, 540)
	container.Visible = false
	container.ZIndex = 2
	container.Parent = screenGui

	spellRevealLabel = Instance.new("TextLabel")
	spellRevealLabel.Name = "SpellReveal"
	spellRevealLabel.AnchorPoint = Vector2.new(0.5, 0)
	spellRevealLabel.BackgroundTransparency = 1
	spellRevealLabel.Position = UDim2.new(0.5, 0, 0, 0)
	spellRevealLabel.Size = UDim2.fromOffset(520, 56)
	spellRevealLabel.Font = Enum.Font.Antique
	spellRevealLabel.Text = ""
	spellRevealLabel.TextColor3 = GRIMOIRE_BRIGHT
	spellRevealLabel.TextSize = 34
	spellRevealLabel.TextStrokeColor3 = SHADOW
	spellRevealLabel.TextStrokeTransparency = 0.1
	spellRevealLabel.TextTransparency = 1
	spellRevealLabel.ZIndex = 4
	spellRevealLabel.Parent = container

	tapHintLabel = Instance.new("TextLabel")
	tapHintLabel.Name = "TapHint"
	tapHintLabel.AnchorPoint = Vector2.new(0.5, 1)
	tapHintLabel.BackgroundTransparency = 1
	tapHintLabel.Position = UDim2.new(0.5, 0, 1, -4)
	tapHintLabel.Size = UDim2.fromOffset(420, 36)
	tapHintLabel.Font = Enum.Font.Antique
	tapHintLabel.Text = "Tap the grimoire to read it!"
	tapHintLabel.TextColor3 = GRIMOIRE
	tapHintLabel.TextSize = 24
	tapHintLabel.TextStrokeColor3 = SHADOW
	tapHintLabel.TextStrokeTransparency = 0.15
	tapHintLabel.ZIndex = 4
	tapHintLabel.Parent = container

	viewportHost = Instance.new("Frame")
	viewportHost.Name = "ViewportHost"
	viewportHost.BackgroundTransparency = 1
	viewportHost.Position = UDim2.fromOffset(0, 58)
	viewportHost.Size = UDim2.new(1, 0, 1, -108)
	viewportHost.ClipsDescendants = false
	viewportHost.Parent = container
end

local function closeSession(token: number)
	if token ~= activeToken then
		return
	end

	pendingRevealHandler = nil
	backdrop.Visible = false
	container.Visible = false
	for _, child in viewportHost:GetChildren() do
		child:Destroy()
	end
end

local function playReveal(
	token: number,
	camera: Camera,
	revealPage: BasePart,
	rune: BasePart,
	spellName: string,
	subtitle: string
)
	if token ~= activeToken then
		return
	end

	spellRevealLabel.Text = spellName
	spellRevealLabel.TextTransparency = 1
	spellRevealLabel.TextStrokeTransparency = 1
	tapHintLabel.Visible = true
	tapHintLabel.Text = subtitle

	local baseCamera = camera.CFrame
	local focus = revealPage.Position + Vector3.new(0.08, 0.04, 0)
	local zoomCamera = CFrame.new(focus + Vector3.new(0.55, 0.35, 1.35), focus + Vector3.new(0, 0.05, 0))

	local zoomStart = os.clock()
	local zoomDuration = 0.65
	local zoomConnection: RBXScriptConnection
	zoomConnection = RunService.RenderStepped:Connect(function()
		if token ~= activeToken or not camera.Parent then
			zoomConnection:Disconnect()
			return
		end

		local alpha = smoothstep(math.clamp((os.clock() - zoomStart) / zoomDuration, 0, 1))
		camera.CFrame = baseCamera:Lerp(zoomCamera, alpha)

		if alpha >= 1 then
			zoomConnection:Disconnect()
		end
	end)

	TweenService:Create(spellRevealLabel, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		TextTransparency = 0,
		TextStrokeTransparency = 0.1,
	}):Play()

	TweenService:Create(rune, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.32, 0.32, 0.05),
	}):Play()

	task.wait(2.8)
	if token ~= activeToken then
		return
	end

	local fade = TweenService:Create(spellRevealLabel, TweenInfo.new(0.35), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	fade:Play()
	fade.Completed:Wait()
	closeSession(token)
end

function GrimoireOpenClient.mountPreview(parent: Instance, size: number)
	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.fromOffset(size, size)
	viewport.BackgroundTransparency = 1
	viewport.Parent = parent

	local book, _, _, _ = buildBookModel()
	book:PivotTo(CFrame.Angles(0, math.rad(24), math.rad(-12)))
	book.Parent = viewport

	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.new(Vector3.new(1.8, 1.1, 2.2), Vector3.new(0.1, 0, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	return viewport
end

function GrimoireOpenClient.open(onFinished: ((boolean) -> ())?)
	if pendingRevealHandler then
		return
	end

	ensureUI()
	activeToken += 1
	local token = activeToken

	for _, child in viewportHost:GetChildren() do
		child:Destroy()
	end

	backdrop.Visible = true
	container.Visible = true
	spellRevealLabel.Text = ""
	spellRevealLabel.TextTransparency = 1
	spellRevealLabel.TextStrokeTransparency = 1
	tapHintLabel.Visible = true
	tapHintLabel.Text = `Tap the grimoire to read it! (0/{REQUIRED_TAPS})`

	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "GrimoireViewport"
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.BackgroundTransparency = 1
	viewport.ZIndex = 2
	viewport.Parent = viewportHost

	local book, pages, revealPage, rune = buildBookModel()
	book:PivotTo(CFrame.Angles(0, math.rad(18), math.rad(-8)))
	book.Parent = viewport

	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.new(Vector3.new(1.9, 1.15, 2.35), Vector3.new(0.05, 0, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local spine = book.PrimaryPart :: BasePart

	local tapButton = Instance.new("TextButton")
	tapButton.Name = "TapTarget"
	tapButton.Size = UDim2.fromScale(1, 1)
	tapButton.BackgroundTransparency = 1
	tapButton.Text = ""
	tapButton.AutoButtonColor = false
	tapButton.ZIndex = 10
	tapButton.Parent = viewportHost

	local tapCount = 0
	local finished = false
	local tapConnection: RBXScriptConnection

	pendingRevealHandler = function(payload)
		if finished or token ~= activeToken then
			return
		end

		finished = true
		pendingRevealHandler = nil
		tapConnection:Disconnect()
		tapButton:Destroy()
		tapHintLabel.Visible = false

		local spellId = if typeof(payload.spellId) == "string" then payload.spellId else ""
		local spell = SpellConfig.getSpell(spellId)
		local spellName = if spell then spell.displayName else "Unknown Spell"
		local subtitle = if typeof(payload.message) == "string" then payload.message else "Spell learned!"

		task.spawn(function()
			playReveal(token, camera, revealPage, rune, spellName, subtitle)
			if onFinished then
				onFinished(true)
			end
		end)
	end

	tapConnection = tapButton.MouseButton1Click:Connect(function()
		if finished or token ~= activeToken then
			return
		end

		tapCount += 1
		local page = pages[tapCount]
		if not page then
			return
		end

		tapHintLabel.Text = if tapCount < REQUIRED_TAPS
			then `Tap the grimoire to read it! ({tapCount}/{REQUIRED_TAPS})`
			else "The final page turns..."

		flipPage(page, spine, function()
			if tapCount < REQUIRED_TAPS or finished or token ~= activeToken then
				return
			end

			useGrimoireEvent:FireServer()

			task.delay(2.5, function()
				if pendingRevealHandler and token == activeToken and not finished then
					pendingRevealHandler = nil
					closeSession(token)
					if onFinished then
						onFinished(false)
					end
				end
			end)
		end)
	end)
end

function GrimoireOpenClient.init()
	useGrimoireEvent = ReplicatedStorage:WaitForChild("UseGrimoire") :: RemoteEvent
	grimoireUsedEvent = ReplicatedStorage:WaitForChild("GrimoireUsed") :: RemoteEvent

	grimoireUsedEvent.OnClientEvent:Connect(function(payload)
		if pendingRevealHandler then
			pendingRevealHandler(payload)
		end
	end)
end

return GrimoireOpenClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">HealthBarUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local TreasureConfig = require(ReplicatedStorage.Shared.TreasureConfig)
local UiCorner = require(script.Parent.UiCorner)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local HealthBarUI = {}

local HIT_SOUND_ID = "rbxassetid://12222216"
local BASE_PITCH = 1
local PITCH_STEP = 0.07
local MAX_PITCH = 1.85
local PITCH_RESET_SECONDS = 5

local screenGui: ScreenGui
local container: Frame
local fillBar: Frame
local fillGlow: Frame
local healthLabel: TextLabel
local emblemLabel: TextLabel
local chestNotifyLabel: TextLabel
local hitSound: Sound

local segmentCount = 24
local lastHealth = 0
local activeCharacter: Model? = nil
local characterConnections: { RBXScriptConnection } = {}
local damageIndicatorIndex = 0
local hitPitch = BASE_PITCH
local pitchResetToken = 0
local chestNotifyToken = 0

local PALETTE = {
	shadow = Color3.fromRGB(8, 4, 10),
	woodDark = Color3.fromRGB(36, 18, 14),
	woodMid = Color3.fromRGB(58, 30, 22),
	woodLight = Color3.fromRGB(82, 48, 34),
	gold = Color3.fromRGB(228, 188, 84),
	goldBright = Color3.fromRGB(255, 228, 140),
	goldDim = Color3.fromRGB(148, 112, 42),
	ruby = Color3.fromRGB(168, 24, 48),
	emerald = Color3.fromRGB(36, 148, 88),
	crimson = Color3.fromRGB(132, 20, 32),
	parchment = Color3.fromRGB(244, 228, 196),
	parchmentDim = Color3.fromRGB(196, 170, 132),
	damage = Color3.fromRGB(255, 96, 96),
	manaGlow = Color3.fromRGB(255, 120, 120),
}

local function disconnectCharacterConnections()
	for _, connection in characterConnections do
		connection:Disconnect()
	end
	table.clear(characterConnections)
end

local function styleFantasyText(label: TextLabel, size: number, color: Color3?)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Antique
	label.TextColor3 = color or PALETTE.parchment
	label.TextSize = size
	label.TextStrokeColor3 = PALETTE.shadow
	label.TextStrokeTransparency = 0.15
end

local function addStroke(instance: GuiObject, color: Color3, thickness: number, transparency: number?)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Transparency = transparency or 0
	stroke.Parent = instance
	return stroke
end

local function addCorner(instance: GuiObject, radius: number)
	UiCorner.apply(instance, radius)
end

local function createGem(parent: Instance, position: UDim2, zIndex: number)
	local gem = Instance.new("Frame")
	gem.Name = "CornerGem"
	gem.AnchorPoint = Vector2.new(0.5, 0.5)
	gem.BackgroundColor3 = PALETTE.ruby
	gem.BorderSizePixel = 0
	gem.Position = position
	gem.Rotation = 45
	gem.Size = UDim2.fromOffset(10, 10)
	gem.ZIndex = zIndex
	gem.Parent = parent
	addStroke(gem, PALETTE.goldBright, 1)
	addCorner(gem, 1)

	local gemGlow = Instance.new("Frame")
	gemGlow.BackgroundColor3 = PALETTE.goldBright
	gemGlow.BackgroundTransparency = 0.55
	gemGlow.BorderSizePixel = 0
	gemGlow.Size = UDim2.fromOffset(4, 4)
	gemGlow.Position = UDim2.fromOffset(2, 2)
	gemGlow.ZIndex = zIndex + 1
	gemGlow.Parent = gem
end

local function createDivider(parent: Instance, position: UDim2, size: UDim2, zIndex: number)
	local divider = Instance.new("Frame")
	divider.BackgroundColor3 = PALETTE.goldDim
	divider.BorderSizePixel = 0
	divider.Position = position
	divider.Size = size
	divider.ZIndex = zIndex
	divider.Parent = parent

	local shine = Instance.new("Frame")
	shine.BackgroundColor3 = PALETTE.goldBright
	shine.BackgroundTransparency = 0.35
	shine.BorderSizePixel = 0
	shine.Size = UDim2.new(1, 0, 0, 1)
	shine.ZIndex = zIndex + 1
	shine.Parent = divider
end

local function getHealthColor(health: number, maxHealth: number): Color3
	local ratio = if maxHealth > 0 then health / maxHealth else 0
	if ratio > 0.55 then
		return PALETTE.emerald
	elseif ratio > 0.25 then
		return PALETTE.gold
	end
	return PALETTE.crimson
end

local function playHitSound()
	hitPitch = math.min(hitPitch + PITCH_STEP, MAX_PITCH)
	hitSound.PlaybackSpeed = hitPitch
	hitSound:Play()

	pitchResetToken += 1
	local token = pitchResetToken
	task.delay(PITCH_RESET_SECONDS, function()
		if pitchResetToken == token then
			hitPitch = BASE_PITCH
		end
	end)
end

local function pulseBarOnHit()
	local originalPosition = container.Position
	TweenService:Create(container, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = originalPosition + UDim2.fromOffset(4, 0),
	}):Play()
	task.delay(0.08, function()
		if container.Parent then
			TweenService:Create(container, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = originalPosition,
			}):Play()
		end
	end)

	TweenService:Create(fillGlow, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.45,
	}):Play()
	task.delay(0.12, function()
		if fillGlow.Parent then
			TweenService:Create(fillGlow, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = 0.78,
			}):Play()
		end
	end)
end

local function updateBar(health: number, maxHealth: number)
	local ratio = if maxHealth > 0 then math.clamp(health / maxHealth, 0, 1) else 0
	local color = getHealthColor(health, maxHealth)

	fillBar.BackgroundColor3 = color
	fillGlow.BackgroundColor3 = color:Lerp(PALETTE.goldBright, 0.35)
	TweenService:Create(fillBar, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(ratio, 0, 1, 0),
	}):Play()

	healthLabel.Text = `{math.floor(health)} / {math.floor(maxHealth)}`
	emblemLabel.Text = if ratio > 0.25 then "♥" else "♡"
	emblemLabel.TextColor3 = if ratio > 0.25 then PALETTE.ruby else PALETTE.parchmentDim
end

local function showDamageIndicator(amount: number)
	if amount <= 0 then
		return
	end

	damageIndicatorIndex += 1
	local indicator = Instance.new("TextLabel")
	indicator.Name = `DamageIndicator_{damageIndicatorIndex}`
	indicator.AnchorPoint = Vector2.new(0.5, 0.5)
	indicator.BackgroundTransparency = 1
	indicator.Size = UDim2.fromOffset(72, 24)
	indicator.Text = `-{math.floor(amount)}`
	indicator.TextColor3 = PALETTE.damage
	indicator.TextSize = 18
	indicator.Font = Enum.Font.Fantasy
	indicator.TextStrokeColor3 = PALETTE.shadow
	indicator.TextStrokeTransparency = 0
	indicator.ZIndex = 30
	indicator.Parent = screenGui

	local barPos = container.AbsolutePosition
	local barSize = container.AbsoluteSize
	local startX = barPos.X + math.random(math.floor(barSize.X * 0.18), math.floor(barSize.X * 0.88))
	local startY = barPos.Y + math.random(8, math.floor(barSize.Y * 0.55))
	indicator.Position = UDim2.fromOffset(startX, startY)

	local velocity = Vector2.new(math.random(35, 100), -math.random(100, 170))
	local gravity = 430
	local lifetime = 0

	task.spawn(function()
		while indicator.Parent and lifetime < 2.5 do
			local deltaTime = RunService.RenderStepped:Wait()
			lifetime += deltaTime
			velocity += Vector2.new(0, gravity * deltaTime)
			startX += velocity.X * deltaTime
			startY += velocity.Y * deltaTime
			indicator.Position = UDim2.fromOffset(startX, startY)

			if lifetime > 0.9 then
				local fade = math.clamp((lifetime - 0.9) * 2.2, 0, 1)
				indicator.TextTransparency = fade
				indicator.TextStrokeTransparency = fade
			end

			local screenSize = screenGui.AbsoluteSize
			if startY > screenSize.Y + 40 or startX < -40 or startX > screenSize.X + 40 then
				break
			end
		end

		if indicator.Parent then
			indicator:Destroy()
		end
	end)
end

local function onDamageTaken(amount: number)
	playHitSound()
	pulseBarOnHit()
	showDamageIndicator(amount)
end

local function bindCharacter(character: Model)
	disconnectCharacterConnections()
	activeCharacter = character

	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	lastHealth = humanoid.Health
	updateBar(humanoid.Health, humanoid.MaxHealth)

	table.insert(characterConnections, humanoid.HealthChanged:Connect(function(newHealth)
		if newHealth < lastHealth then
			onDamageTaken(lastHealth - newHealth)
		end
		lastHealth = newHealth
		updateBar(newHealth, humanoid.MaxHealth)
	end))

	table.insert(characterConnections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		updateBar(humanoid.Health, humanoid.MaxHealth)
	end))

	table.insert(characterConnections, character.AncestryChanged:Connect(function(_, parent)
		if parent == nil and activeCharacter == character then
			disconnectCharacterConnections()
			activeCharacter = nil
			updateBar(0, humanoid.MaxHealth)
		end
	end))
end

local function createUI()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "HealthBarUI"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	hitSound = Instance.new("Sound")
	hitSound.Name = "HitSound"
	hitSound.SoundId = HIT_SOUND_ID
	hitSound.Volume = 0.55
	hitSound.Parent = screenGui

	local glowBackdrop = Instance.new("Frame")
	glowBackdrop.Name = "GlowBackdrop"
	glowBackdrop.AnchorPoint = Vector2.new(0, 1)
	glowBackdrop.BackgroundColor3 = PALETTE.gold
	glowBackdrop.BackgroundTransparency = 0.82
	glowBackdrop.BorderSizePixel = 0
	glowBackdrop.Position = UDim2.new(0, 10, 1, -10)
	glowBackdrop.Size = UDim2.fromOffset(318, 98)
	glowBackdrop.Parent = screenGui
	addCorner(glowBackdrop, 12)

	container = Instance.new("Frame")
	container.Name = "HealthBarContainer"
	container.AnchorPoint = Vector2.new(0, 1)
	container.BackgroundColor3 = PALETTE.woodDark
	container.BorderSizePixel = 0
	container.Position = UDim2.new(0, 16, 1, -16)
	container.Size = UDim2.fromOffset(300, 86)
	container.Parent = screenGui
	addCorner(container, 10)
	addStroke(container, PALETTE.gold, 2)
	addStroke(container, PALETTE.shadow, 4, 0.35)

	createGem(container, UDim2.fromOffset(0, 0), 8)
	createGem(container, UDim2.new(1, 0, 0, 0), 8)
	createGem(container, UDim2.new(0, 0, 1, 0), 8)
	createGem(container, UDim2.new(1, 0, 1, 0), 8)

	local crestBand = Instance.new("Frame")
	crestBand.Name = "CrestBand"
	crestBand.BackgroundColor3 = PALETTE.woodMid
	crestBand.BorderSizePixel = 0
	crestBand.Position = UDim2.fromOffset(10, 8)
	crestBand.Size = UDim2.new(1, -20, 0, 28)
	crestBand.ZIndex = 2
	crestBand.Parent = container
	addCorner(crestBand, 6)
	addStroke(crestBand, PALETTE.goldDim, 1)

	local crestShine = Instance.new("Frame")
	crestShine.BackgroundColor3 = PALETTE.goldBright
	crestShine.BackgroundTransparency = 0.78
	crestShine.BorderSizePixel = 0
	crestShine.Size = UDim2.new(1, 0, 0, 8)
	crestShine.ZIndex = 3
	crestShine.Parent = crestBand

	emblemLabel = Instance.new("TextLabel")
	emblemLabel.Name = "Emblem"
	emblemLabel.BackgroundTransparency = 1
	emblemLabel.Position = UDim2.fromOffset(8, 2)
	emblemLabel.Size = UDim2.fromOffset(24, 24)
	emblemLabel.Text = "♥"
	emblemLabel.ZIndex = 4
	styleFantasyText(emblemLabel, 22, PALETTE.ruby)
	emblemLabel.Parent = crestBand

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(34, 4)
	title.Size = UDim2.fromOffset(120, 20)
	title.Text = "VITALITY"
	title.ZIndex = 4
	styleFantasyText(title, 18, PALETTE.goldBright)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = crestBand

	healthLabel = Instance.new("TextLabel")
	healthLabel.Name = "HealthLabel"
	healthLabel.BackgroundTransparency = 1
	healthLabel.Position = UDim2.new(1, -108, 0, 5)
	healthLabel.Size = UDim2.fromOffset(96, 20)
	healthLabel.Text = "0 / 0"
	healthLabel.ZIndex = 4
	styleFantasyText(healthLabel, 16, PALETTE.parchment)
	healthLabel.TextXAlignment = Enum.TextXAlignment.Right
	healthLabel.Parent = crestBand

	createDivider(container, UDim2.new(0.5, -70, 0, 38), UDim2.fromOffset(140, 2), 3)

	local barFrame = Instance.new("Frame")
	barFrame.Name = "BarFrame"
	barFrame.BackgroundColor3 = PALETTE.woodLight
	barFrame.BorderSizePixel = 0
	barFrame.Position = UDim2.fromOffset(14, 46)
	barFrame.Size = UDim2.new(1, -28, 0, 24)
	barFrame.ZIndex = 2
	barFrame.ClipsDescendants = true
	barFrame.Parent = container
	addCorner(barFrame, 5)
	addStroke(barFrame, PALETTE.goldDim, 1)

	local barInset = Instance.new("Frame")
	barInset.Name = "BarInset"
	barInset.BackgroundColor3 = PALETTE.shadow
	barInset.BorderSizePixel = 0
	barInset.Position = UDim2.fromOffset(3, 3)
	barInset.Size = UDim2.new(1, -6, 1, -6)
	barInset.ZIndex = 3
	barInset.ClipsDescendants = true
	barInset.Parent = barFrame
	addCorner(barInset, 4)

	fillBar = Instance.new("Frame")
	fillBar.Name = "Fill"
	fillBar.BackgroundColor3 = PALETTE.emerald
	fillBar.BorderSizePixel = 0
	fillBar.Size = UDim2.new(1, 0, 1, 0)
	fillBar.ZIndex = 4
	fillBar.Parent = barInset

	fillGlow = Instance.new("Frame")
	fillGlow.Name = "FillGlow"
	fillGlow.BackgroundColor3 = PALETTE.emerald
	fillGlow.BackgroundTransparency = 0.78
	fillGlow.BorderSizePixel = 0
	fillGlow.Size = UDim2.new(1, 0, 0.45, 0)
	fillGlow.ZIndex = 5
	fillGlow.Parent = fillBar

	for index = 1, segmentCount - 1 do
		local notch = Instance.new("Frame")
		notch.Name = `Notch_{index}`
		notch.BackgroundColor3 = PALETTE.shadow
		notch.BackgroundTransparency = 0.25
		notch.BorderSizePixel = 0
		notch.Size = UDim2.new(0, 1, 1, 0)
		notch.Position = UDim2.new(index / segmentCount, 0, 0, 0)
		notch.ZIndex = 6
		notch.Parent = barInset
	end

	local leftScroll = Instance.new("TextLabel")
	leftScroll.BackgroundTransparency = 1
	leftScroll.Font = Enum.Font.Antique
	leftScroll.Position = UDim2.fromOffset(2, 42)
	leftScroll.Size = UDim2.fromOffset(12, 30)
	leftScroll.Text = "✦"
	leftScroll.TextColor3 = PALETTE.gold
	leftScroll.TextSize = 14
	leftScroll.ZIndex = 5
	leftScroll.Parent = container

	local rightScroll = leftScroll:Clone()
	rightScroll.Position = UDim2.new(1, -14, 0, 42)
	rightScroll.Parent = container

	local bottomRunes = Instance.new("TextLabel")
	bottomRunes.BackgroundTransparency = 1
	bottomRunes.Font = Enum.Font.Antique
	bottomRunes.Position = UDim2.new(0.5, -48, 1, -14)
	bottomRunes.Size = UDim2.fromOffset(96, 12)
	bottomRunes.Text = "◆ ◇ ◆"
	bottomRunes.TextColor3 = PALETTE.goldDim
	bottomRunes.TextSize = 10
	bottomRunes.ZIndex = 5
	bottomRunes.Parent = container

	chestNotifyLabel = Instance.new("TextLabel")
	chestNotifyLabel.Name = "ChestNotify"
	chestNotifyLabel.AnchorPoint = Vector2.new(0, 1)
	chestNotifyLabel.BackgroundTransparency = 1
	chestNotifyLabel.Position = UDim2.new(0, 16, 1, -106)
	chestNotifyLabel.Size = UDim2.fromOffset(300, 24)
	chestNotifyLabel.Font = Enum.Font.Antique
	chestNotifyLabel.Text = ""
	chestNotifyLabel.TextColor3 = PALETTE.goldBright
	chestNotifyLabel.TextSize = 16
	chestNotifyLabel.TextStrokeColor3 = PALETTE.shadow
	chestNotifyLabel.TextStrokeTransparency = 0.1
	chestNotifyLabel.TextTransparency = 1
	chestNotifyLabel.TextXAlignment = Enum.TextXAlignment.Center
	chestNotifyLabel.ZIndex = 12
	chestNotifyLabel.Visible = false
	chestNotifyLabel.Parent = screenGui
end

local function showChestAwarded(payload: any)
	if typeof(payload) ~= "table" then
		return
	end

	local tierId = if typeof(payload.tierId) == "string" then payload.tierId else "Common"
	local tier = TreasureConfig.getTier(tierId)
	local tierName = if typeof(payload.tierName) == "string" then payload.tierName else tier.displayName

	chestNotifyLabel.Text = `{tierName} secured!`
	chestNotifyLabel.TextColor3 = tier.glowColor
	chestNotifyLabel.TextTransparency = 0
	chestNotifyLabel.Visible = true

	chestNotifyToken += 1
	local token = chestNotifyToken
	task.delay(3.2, function()
		if chestNotifyToken ~= token or not chestNotifyLabel.Parent then
			return
		end
		local fade = TweenService:Create(chestNotifyLabel, TweenInfo.new(0.35), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		fade:Play()
		fade.Completed:Connect(function()
			if chestNotifyToken == token then
				chestNotifyLabel.Visible = false
				chestNotifyLabel.TextStrokeTransparency = 0.1
			end
		end)
	end)
end

function HealthBarUI.init()
	createUI()

	local awardedEvent = ReplicatedStorage:WaitForChild("TreasureChestAwarded") :: RemoteEvent
	awardedEvent.OnClientEvent:Connect(showChestAwarded)

	if player.Character then
		bindCharacter(player.Character)
	end

	player.CharacterAdded:Connect(bindCharacter)
end

return HealthBarUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">InfuserMenuClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local InfuserConfig = require(ReplicatedStorage.Shared.InfuserConfig)
local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local SpellConfig = require(ReplicatedStorage.Shared.SpellConfig)
local SpellUpgradeConfig = require(ReplicatedStorage.Shared.SpellUpgradeConfig)
local WeaponConfig = require(ReplicatedStorage.Shared.WeaponConfig)
local UiCorner = require(script.Parent.UiCorner)

local InfuserMenuClient = {}

local GOLD = Color3.fromRGB(214, 176, 72)
local GOLD_DIM = Color3.fromRGB(140, 108, 42)
local PANEL = Color3.fromRGB(22, 16, 34)
local PANEL_LIGHT = Color3.fromRGB(42, 30, 58)
local TEXT = Color3.fromRGB(244, 228, 196)
local TEXT_DIM = Color3.fromRGB(170, 154, 128)
local LOCKED = Color3.fromRGB(110, 110, 110)
local ACCENT = Color3.fromRGB(120, 72, 180)
local WEAPON_ACCENT = Color3.fromRGB(58, 92, 148)
local SELECTED = Color3.fromRGB(88, 58, 128)

function InfuserMenuClient.init()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local infuseSpellEvent = ReplicatedStorage:WaitForChild("InfuseSpell") :: RemoteEvent
	local purgeWeaponInfusionEvent = ReplicatedStorage:WaitForChild("PurgeWeaponInfusion") :: RemoteEvent
	local spellLoadoutUpdatedEvent = ReplicatedStorage:WaitForChild("SpellLoadoutUpdated") :: RemoteEvent
	local profileStateEvent = ReplicatedStorage:WaitForChild("PlayerProfileState") :: RemoteEvent
	local phaseStateEvent = ReplicatedStorage:WaitForChild("PlayerPhaseState") :: RemoteEvent

	local selectedWeaponId = LobbyConfig.STARTER_WEAPON
	local selectedSpellId = ""
	local equippedWeapon = LobbyConfig.STARTER_WEAPON
	local walletGold = LobbyConfig.STARTER_GOLD
	local grimoireCount = 0
	local weaponInfusions: { [string]: string } = {}
	local unlockedWeapons: { [string]: boolean } = {
		[LobbyConfig.STARTER_WEAPON] = true,
	}
	local ownedSpells: { [string]: boolean } = {
		[LobbyConfig.STARTER_ACTIVE_SPELL] = true,
	}
	local spellLevels: { [string]: number } = {}
	local loadoutLocked = false
	local menuOpen = false
	local currentPhase = "Lobby"
	local pendingAction = false

	for _, spell in SpellConfig.getSpellList() do
		spellLevels[spell.id] = 1
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InfuserMenuUI"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.DisplayOrder = 12
	screenGui.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.Name = "InfuserPanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(560, 480)
	panel.BackgroundColor3 = PANEL
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = screenGui

	UiCorner.apply(panel, 12)

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = ACCENT
	panelStroke.Thickness = 2
	panelStroke.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 12)
	title.Size = UDim2.new(1, -64, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.Text = InfuserConfig.DISPLAY_NAME
	title.TextColor3 = GOLD
	title.TextSize = 22
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = panel

	local closeButton = Instance.new("TextButton")
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, -12, 0, 12)
	closeButton.Size = UDim2.fromOffset(36, 36)
	closeButton.BackgroundColor3 = PANEL_LIGHT
	closeButton.BorderSizePixel = 0
	closeButton.Font = Enum.Font.GothamBold
	closeButton.Text = "X"
	closeButton.TextColor3 = TEXT
	closeButton.TextSize = 18
	closeButton.Parent = panel

	UiCorner.apply(closeButton, 8)

	local statusLabel = Instance.new("TextLabel")
	statusLabel.BackgroundTransparency = 1
	statusLabel.Position = UDim2.fromOffset(16, 44)
	statusLabel.Size = UDim2.new(1, -32, 0, 48)
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.Text = "Pick a weapon and learned spell. Infusing costs 1 grimoire and is permanent until purged."
	statusLabel.TextColor3 = TEXT
	statusLabel.TextSize = 14
	statusLabel.TextWrapped = true
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.Parent = panel

	local columns = Instance.new("Frame")
	columns.BackgroundTransparency = 1
	columns.Position = UDim2.fromOffset(16, 100)
	columns.Size = UDim2.new(1, -32, 1, -188)
	columns.Parent = panel

	local weaponHeader = Instance.new("TextLabel")
	weaponHeader.BackgroundTransparency = 1
	weaponHeader.Size = UDim2.new(0.48, 0, 0, 22)
	weaponHeader.Font = Enum.Font.GothamBold
	weaponHeader.Text = "Weapon"
	weaponHeader.TextColor3 = WEAPON_ACCENT
	weaponHeader.TextSize = 16
	weaponHeader.TextXAlignment = Enum.TextXAlignment.Left
	weaponHeader.Parent = columns

	local spellHeader = Instance.new("TextLabel")
	spellHeader.BackgroundTransparency = 1
	spellHeader.Position = UDim2.new(0.52, 0, 0, 0)
	spellHeader.Size = UDim2.new(0.48, 0, 0, 22)
	spellHeader.Font = Enum.Font.GothamBold
	spellHeader.Text = "Spell"
	spellHeader.TextColor3 = ACCENT
	spellHeader.TextSize = 16
	spellHeader.TextXAlignment = Enum.TextXAlignment.Left
	spellHeader.Parent = columns

	local weaponList = Instance.new("ScrollingFrame")
	weaponList.BackgroundTransparency = 1
	weaponList.BorderSizePixel = 0
	weaponList.Position = UDim2.new(0, 0, 0, 28)
	weaponList.Size = UDim2.new(0.48, -6, 1, -28)
	weaponList.CanvasSize = UDim2.fromOffset(0, 0)
	weaponList.ScrollBarThickness = 6
	weaponList.Parent = columns

	local weaponLayout = Instance.new("UIListLayout")
	weaponLayout.Padding = UDim.new(0, 8)
	weaponLayout.SortOrder = Enum.SortOrder.LayoutOrder
	weaponLayout.Parent = weaponList

	local spellList = Instance.new("ScrollingFrame")
	spellList.BackgroundTransparency = 1
	spellList.BorderSizePixel = 0
	spellList.Position = UDim2.new(0.52, 0, 0, 28)
	spellList.Size = UDim2.new(0.48, -6, 1, -28)
	spellList.CanvasSize = UDim2.fromOffset(0, 0)
	spellList.ScrollBarThickness = 6
	spellList.Parent = columns

	local spellLayout = Instance.new("UIListLayout")
	spellLayout.Padding = UDim.new(0, 8)
	spellLayout.SortOrder = Enum.SortOrder.LayoutOrder
	spellLayout.Parent = spellList

	weaponLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		weaponList.CanvasSize = UDim2.fromOffset(0, weaponLayout.AbsoluteContentSize.Y + 8)
	end)
	spellLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		spellList.CanvasSize = UDim2.fromOffset(0, spellLayout.AbsoluteContentSize.Y + 8)
	end)

	local actionBar = Instance.new("Frame")
	actionBar.BackgroundTransparency = 1
	actionBar.AnchorPoint = Vector2.new(0, 1)
	actionBar.Position = UDim2.new(0, 16, 1, -16)
	actionBar.Size = UDim2.new(1, -32, 0, 72)
	actionBar.Parent = panel

	local previewLabel = Instance.new("TextLabel")
	previewLabel.BackgroundTransparency = 1
	previewLabel.Position = UDim2.fromOffset(0, 0)
	previewLabel.Size = UDim2.new(1, -280, 0, 72)
	previewLabel.Font = Enum.Font.Gotham
	previewLabel.Text = "Select a weapon and spell."
	previewLabel.TextColor3 = TEXT_DIM
	previewLabel.TextSize = 14
	previewLabel.TextWrapped = true
	previewLabel.TextXAlignment = Enum.TextXAlignment.Left
	previewLabel.TextYAlignment = Enum.TextYAlignment.Center
	previewLabel.Parent = actionBar

	local infuseButton = Instance.new("TextButton")
	infuseButton.AnchorPoint = Vector2.new(1, 0.5)
	infuseButton.Position = UDim2.new(1, -144, 0.5, 0)
	infuseButton.Size = UDim2.fromOffset(124, 48)
	infuseButton.BackgroundColor3 = ACCENT
	infuseButton.BorderSizePixel = 0
	infuseButton.Font = Enum.Font.GothamBold
	infuseButton.Text = "Infuse"
	infuseButton.TextColor3 = Color3.new(1, 1, 1)
	infuseButton.TextSize = 17
	infuseButton.AutoButtonColor = false
	infuseButton.Parent = actionBar

	UiCorner.apply(infuseButton, 10)

	local purgeButton = Instance.new("TextButton")
	purgeButton.AnchorPoint = Vector2.new(1, 0.5)
	purgeButton.Position = UDim2.new(1, 0, 0.5, 0)
	purgeButton.Size = UDim2.fromOffset(132, 48)
	purgeButton.BackgroundColor3 = PANEL_LIGHT
	purgeButton.BorderSizePixel = 0
	purgeButton.Font = Enum.Font.GothamBold
	purgeButton.Text = `Purge ({InfuserConfig.PURGE_COST}g)`
	purgeButton.TextColor3 = TEXT
	purgeButton.TextSize = 15
	purgeButton.AutoButtonColor = false
	purgeButton.Parent = actionBar

	UiCorner.apply(purgeButton, 10)

	type Row = {
		button: TextButton,
		stroke: UIStroke,
	}

	local weaponRows: { [string]: Row } = {}
	local spellRows: { [string]: Row } = {}

	local function getEffectiveDisplayStats(spellId: string)
		return SpellUpgradeConfig.getEffectiveStats(spellId, spellLevels[spellId] or 1)
	end

	local function getWeaponInfusion(weaponId: string): string
		return weaponInfusions[weaponId] or ""
	end

	local function weaponHasInfusion(weaponId: string): boolean
		local infusion = getWeaponInfusion(weaponId)
		return infusion ~= ""
	end

	local function getDefaultSpellSelection(): string
		for _, spell in SpellConfig.getSpellList() do
			if ownedSpells[spell.id] then
				return spell.id
			end
		end
		return ""
	end

	local function canInfuseSelection(): boolean
		return selectedWeaponId ~= ""
			and selectedSpellId ~= ""
			and unlockedWeapons[selectedWeaponId] == true
			and ownedSpells[selectedSpellId] == true
			and not weaponHasInfusion(selectedWeaponId)
			and grimoireCount >= InfuserConfig.INFUSION_GRIMOIRE_COST
			and not loadoutLocked
			and currentPhase == "Lobby"
			and not pendingAction
	end

	local function canPurgeSelection(): boolean
		return selectedWeaponId ~= ""
			and unlockedWeapons[selectedWeaponId] == true
			and weaponHasInfusion(selectedWeaponId)
			and walletGold >= InfuserConfig.PURGE_COST
			and not loadoutLocked
			and currentPhase == "Lobby"
			and not pendingAction
	end

	local function updateActionBar()
		local weapon = WeaponConfig.getWeapon(selectedWeaponId)
		local weaponName = if weapon then weapon.displayName else "Weapon"
		local infusionId = getWeaponInfusion(selectedWeaponId)

		if infusionId ~= "" then
			local stats = getEffectiveDisplayStats(infusionId)
			previewLabel.Text =
				`{weaponName} is bound to {stats.resolvedName}.\nPress E in dungeons while wielding it. Purge costs {InfuserConfig.PURGE_COST} gold.`
			previewLabel.TextColor3 = GOLD
			infuseButton.Text = "Infused"
			infuseButton.BackgroundColor3 = LOCKED
			infuseButton.AutoButtonColor = false
			purgeButton.Text = if pendingAction then "Purging..." else `Purge ({InfuserConfig.PURGE_COST}g)`
			purgeButton.BackgroundColor3 = if canPurgeSelection() then Color3.fromRGB(92, 58, 58) else LOCKED
			purgeButton.AutoButtonColor = canPurgeSelection()
			return
		end

		if selectedSpellId == "" or ownedSpells[selectedSpellId] ~= true then
			previewLabel.Text = `{weaponName} has no infusion yet.\nLearn spells with grimoires, then infuse (costs 1 grimoire).`
			previewLabel.TextColor3 = TEXT_DIM
		else
			local stats = getEffectiveDisplayStats(selectedSpellId)
			local grimoireReady = grimoireCount >= InfuserConfig.INFUSION_GRIMOIRE_COST
			previewLabel.Text = if grimoireReady
				then `Bind {stats.displayName} to {weaponName} for 1 grimoire.\nCast with E while wielding it ({stats.staminaCost} stamina).`
				else `Need 1 grimoire to infuse {stats.displayName} into {weaponName}.`
			previewLabel.TextColor3 = if grimoireReady then TEXT else TEXT_DIM
		end

		local ready = canInfuseSelection()
		infuseButton.Text = if pendingAction then "Infusing..." else "Infuse"
		infuseButton.BackgroundColor3 = if ready then ACCENT else LOCKED
		infuseButton.AutoButtonColor = ready
		purgeButton.Text = `Purge ({InfuserConfig.PURGE_COST}g)`
		purgeButton.BackgroundColor3 = LOCKED
		purgeButton.AutoButtonColor = false
	end

	local function updateMenuState()
		if not pendingAction then
			statusLabel.Text =
				`Grimoires: {grimoireCount}  |  Infuse cost: 1  |  Purge: {InfuserConfig.PURGE_COST} gold  |  Wallet: {walletGold}`
		end

		for index, weapon in WeaponConfig.getWeaponList() do
			local row = weaponRows[weapon.id]
			if not row then
				continue
			end

			local unlocked = unlockedWeapons[weapon.id] == true
			local selected = weapon.id == selectedWeaponId
			local infusionId = getWeaponInfusion(weapon.id)
			local equippedTag = if weapon.id == equippedWeapon then "  EQUIPPED" else ""

			if not unlocked then
				row.button.Text = `{weapon.displayName}  LOCKED`
				row.button.BackgroundColor3 = PANEL_LIGHT
				row.button.TextColor3 = LOCKED
				row.stroke.Color = PANEL_LIGHT
			elseif infusionId ~= "" then
				local spellName = getEffectiveDisplayStats(infusionId).resolvedName
				row.button.Text = `{weapon.displayName}{equippedTag}\n{spellName} infused`
				row.button.BackgroundColor3 = if selected then GOLD_DIM else PANEL_LIGHT
				row.button.TextColor3 = TEXT
				row.stroke.Color = if selected then GOLD else WEAPON_ACCENT
			else
				row.button.Text = `{weapon.displayName}{equippedTag}\nNo infusion`
				row.button.BackgroundColor3 = if selected then SELECTED else PANEL_LIGHT
				row.button.TextColor3 = TEXT
				row.stroke.Color = if selected then WEAPON_ACCENT else PANEL_LIGHT
			end
			row.stroke.Thickness = if selected then 2 else 1
			row.button.LayoutOrder = index
		end

		local weaponInfused = weaponHasInfusion(selectedWeaponId)
		local ownedSpellCount = 0
		for index, spell in SpellConfig.getSpellList() do
			local row = spellRows[spell.id]
			if not row then
				continue
			end

			local owned = ownedSpells[spell.id] == true
			row.button.Visible = owned
			if not owned then
				continue
			end

			ownedSpellCount += 1
			local selected = spell.id == selectedSpellId
			local stats = getEffectiveDisplayStats(spell.id)

			if weaponInfused then
				row.button.Text = `{stats.displayName}  Lv {spellLevels[spell.id] or 1}\nPurge the weapon to change spells.`
				row.button.BackgroundColor3 = PANEL_LIGHT
				row.button.TextColor3 = TEXT_DIM
				row.stroke.Color = PANEL_LIGHT
				row.button.AutoButtonColor = false
			else
				row.button.Text =
					`{stats.displayName}  Lv {spellLevels[spell.id] or 1}\n{stats.damageMin}-{stats.damageMax} dmg  |  {stats.staminaCost} ST`
				row.button.BackgroundColor3 = if selected then SELECTED else PANEL_LIGHT
				row.button.TextColor3 = TEXT
				row.stroke.Color = if selected then ACCENT else PANEL_LIGHT
				row.button.AutoButtonColor = false
			end
			row.stroke.Thickness = if selected and not weaponInfused then 2 else 1
			row.button.LayoutOrder = index
		end

		spellHeader.Text = if ownedSpellCount > 0 then "Spell" else "Spell (learn with grimoires)"

		updateActionBar()
	end

	for index, weapon in WeaponConfig.getWeaponList() do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -4, 0, 64)
		button.BackgroundColor3 = PANEL_LIGHT
		button.BorderSizePixel = 0
		button.Font = Enum.Font.GothamBold
		button.TextSize = 14
		button.TextWrapped = true
		button.LayoutOrder = index
		button.Parent = weaponList

		UiCorner.apply(button, 8)

		local stroke = Instance.new("UIStroke")
		stroke.Color = PANEL_LIGHT
		stroke.Thickness = 1
		stroke.Parent = button

		button.MouseButton1Click:Connect(function()
			if unlockedWeapons[weapon.id] ~= true then
				return
			end
			selectedWeaponId = weapon.id
			if weaponHasInfusion(weapon.id) then
				selectedSpellId = getWeaponInfusion(weapon.id)
			elseif selectedSpellId == "" or ownedSpells[selectedSpellId] ~= true then
				selectedSpellId = getDefaultSpellSelection()
			end
			updateMenuState()
		end)

		weaponRows[weapon.id] = { button = button, stroke = stroke }
	end

	for index, spell in SpellConfig.getSpellList() do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -4, 0, 64)
		button.BackgroundColor3 = PANEL_LIGHT
		button.BorderSizePixel = 0
		button.Font = Enum.Font.GothamBold
		button.TextSize = 14
		button.TextWrapped = true
		button.LayoutOrder = index
		button.Parent = spellList

		UiCorner.apply(button, 8)

		local stroke = Instance.new("UIStroke")
		stroke.Color = PANEL_LIGHT
		stroke.Thickness = 1
		stroke.Parent = button

		button.MouseButton1Click:Connect(function()
			if ownedSpells[spell.id] ~= true or weaponHasInfusion(selectedWeaponId) then
				return
			end
			selectedSpellId = spell.id
			updateMenuState()
		end)

		spellRows[spell.id] = { button = button, stroke = stroke }
	end

	local function setMenuOpen(open: boolean)
		menuOpen = open
		panel.Visible = open
		if open then
			selectedWeaponId = equippedWeapon
			selectedSpellId = getDefaultSpellSelection()
			pendingAction = false
			updateMenuState()
		end
	end

	local function tryInfuseSelected()
		if not canInfuseSelection() then
			return
		end

		pendingAction = true
		updateActionBar()
		infuseSpellEvent:FireServer(selectedWeaponId, selectedSpellId)
	end

	local function tryPurgeSelected()
		if not canPurgeSelection() then
			return
		end

		pendingAction = true
		updateActionBar()
		purgeWeaponInfusionEvent:FireServer(selectedWeaponId)
	end

	closeButton.MouseButton1Click:Connect(function()
		setMenuOpen(false)
	end)

	infuseButton.MouseButton1Click:Connect(tryInfuseSelected)
	purgeButton.MouseButton1Click:Connect(tryPurgeSelected)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not menuOpen then
			return
		end

		if input.KeyCode == Enum.KeyCode.Escape then
			setMenuOpen(false)
		end
	end)

	spellLoadoutUpdatedEvent.OnClientEvent:Connect(function(_activeInfusion: string, locked: boolean)
		loadoutLocked = locked == true
		if locked then
			pendingAction = false
			setMenuOpen(false)
		end
		updateMenuState()
	end)

	profileStateEvent.OnClientEvent:Connect(function(snapshot)
		if typeof(snapshot) ~= "table" then
			return
		end

		local previousInfusion = getWeaponInfusion(selectedWeaponId)

		if typeof(snapshot.gold) == "number" then
			walletGold = snapshot.gold
		end
		if typeof(snapshot.grimoireCount) == "number" then
			grimoireCount = snapshot.grimoireCount
		end
		if typeof(snapshot.equippedWeapon) == "string" then
			equippedWeapon = snapshot.equippedWeapon
		end
		if typeof(snapshot.weaponInfusions) == "table" then
			weaponInfusions = {}
			for weaponId, spellId in snapshot.weaponInfusions do
				if typeof(spellId) == "string" and spellId ~= "" then
					weaponInfusions[weaponId] = spellId
				end
			end
		elseif typeof(snapshot.infusedSpellId) == "string" and snapshot.infusedSpellId ~= "" then
			weaponInfusions[equippedWeapon] = snapshot.infusedSpellId
		end
		if typeof(snapshot.unlockedWeapons) == "table" then
			for weaponId, unlocked in snapshot.unlockedWeapons do
				if typeof(unlocked) == "boolean" then
					unlockedWeapons[weaponId] = unlocked
				end
			end
		end
		if typeof(snapshot.ownedSpells) == "table" then
			for spellId, owned in snapshot.ownedSpells do
				if typeof(owned) == "boolean" then
					ownedSpells[spellId] = owned
				end
			end
		end
		if typeof(snapshot.spellLevels) == "table" then
			for spellId, level in snapshot.spellLevels do
				if typeof(level) == "number" then
					spellLevels[spellId] = level
				end
			end
		end

		if menuOpen then
			local infusionId = getWeaponInfusion(selectedWeaponId)
			if infusionId ~= "" then
				selectedSpellId = infusionId
			elseif selectedSpellId == "" or ownedSpells[selectedSpellId] ~= true then
				selectedSpellId = getDefaultSpellSelection()
			end

			if pendingAction then
				pendingAction = false
				local weapon = WeaponConfig.getWeapon(selectedWeaponId)
				local weaponName = if weapon then weapon.displayName else "Weapon"
				local newInfusion = getWeaponInfusion(selectedWeaponId)
				if newInfusion ~= "" and newInfusion ~= previousInfusion then
					local stats = getEffectiveDisplayStats(newInfusion)
					statusLabel.Text = `{stats.resolvedName} infused into {weaponName}! Press E while wielding it.`
				elseif previousInfusion ~= "" and newInfusion == "" then
					statusLabel.Text = `Infusion removed from {weaponName} for {InfuserConfig.PURGE_COST} gold.`
				end
			end
		end

		updateMenuState()
	end)

	phaseStateEvent.OnClientEvent:Connect(function(phase: string)
		if phase == "Lobby" or phase == "Dungeon" then
			currentPhase = phase
			if phase == "Dungeon" then
				setMenuOpen(false)
			end
			updateMenuState()
		end
	end)

	InfuserMenuClient._open = function()
		if loadoutLocked or currentPhase ~= "Lobby" then
			return
		end
		setMenuOpen(true)
	end

	updateMenuState()
end

function InfuserMenuClient.open()
	if InfuserMenuClient._open then
		InfuserMenuClient._open()
	end
end

return InfuserMenuClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">LobbyHubClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local UiCorner = require(script.Parent.UiCorner)

local LobbyHubClient = {}

local GOLD = Color3.fromRGB(214, 176, 72)
local PANEL = Color3.fromRGB(24, 18, 16)
local TEXT = Color3.fromRGB(244, 228, 196)

function LobbyHubClient.init()
	if not LobbyConfig.USE_LOBBY then
		return
	end

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local phaseStateEvent = ReplicatedStorage:WaitForChild("PlayerPhaseState") :: RemoteEvent
	local profileStateEvent = ReplicatedStorage:WaitForChild("PlayerProfileState") :: RemoteEvent

	local currentPhase = "Lobby"
	local walletGold = LobbyConfig.STARTER_GOLD

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "LobbyHubUI"
	screenGui.ResetOnSpawn = false
	screenGui.Enabled = true
	screenGui.Parent = playerGui

	local walletFrame = Instance.new("Frame")
	walletFrame.Name = "Wallet"
	walletFrame.Size = UDim2.fromOffset(220, 54)
	walletFrame.Position = UDim2.new(1, -236, 0, 12)
	walletFrame.BackgroundColor3 = PANEL
	walletFrame.BorderSizePixel = 0
	walletFrame.Parent = screenGui

	UiCorner.apply(walletFrame, 10)

	local walletStroke = Instance.new("UIStroke")
	walletStroke.Color = GOLD
	walletStroke.Thickness = 2
	walletStroke.Parent = walletFrame

	local walletLabel = Instance.new("TextLabel")
	walletLabel.BackgroundTransparency = 1
	walletLabel.Size = UDim2.fromScale(1, 1)
	walletLabel.Font = Enum.Font.GothamBold
	walletLabel.Text = `Gold: {walletGold}`
	walletLabel.TextColor3 = GOLD
	walletLabel.TextSize = 22
	walletLabel.Parent = walletFrame

	local hintFrame = Instance.new("Frame")
	hintFrame.Name = "LobbyHint"
	hintFrame.Size = UDim2.fromOffset(460, 72)
	hintFrame.Position = UDim2.new(0.5, -230, 1, -150)
	hintFrame.BackgroundColor3 = PANEL
	hintFrame.BorderSizePixel = 0
	hintFrame.Parent = screenGui

	UiCorner.apply(hintFrame, 10)

	local hintStroke = Instance.new("UIStroke")
	hintStroke.Color = GOLD
	hintStroke.Thickness = 2
	hintStroke.Parent = hintFrame

	local hintLabel = Instance.new("TextLabel")
	hintLabel.BackgroundTransparency = 1
	hintLabel.Size = UDim2.fromScale(1, 1)
	hintLabel.Font = Enum.Font.Gotham
	hintLabel.Text =
		"Talk to Bob for dungeon tips. Mira infuses spells onto specific weapons for 300g purge.\nOpen chests for grimoires, then upgrade gear from the lobby menus."
	hintLabel.TextColor3 = TEXT
	hintLabel.TextSize = 16
	hintLabel.TextWrapped = true
	hintLabel.Parent = hintFrame

	local function renderPhase()
		local inLobby = currentPhase == "Lobby"
		walletFrame.Visible = inLobby
		hintFrame.Visible = inLobby
	end

	local function renderWallet()
		walletLabel.Text = `Gold: {walletGold}`
	end

	profileStateEvent.OnClientEvent:Connect(function(snapshot)
		if typeof(snapshot) == "table" and typeof(snapshot.gold) == "number" then
			walletGold = snapshot.gold
			renderWallet()
		end
	end)

	phaseStateEvent.OnClientEvent:Connect(function(phase: string)
		if phase == "Lobby" or phase == "Dungeon" then
			currentPhase = phase
			renderPhase()
		end
	end)

	renderPhase()
	renderWallet()
end

return LobbyHubClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">MovementClient</string>
            <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local MovementConfig = require(ReplicatedStorage.Shared.MovementConfig)
local StaminaConfig = require(ReplicatedStorage.Shared.StaminaConfig)
local UiCorner = require(script.Parent.UiCorner)

local MovementClient = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local dashEvent: RemoteEvent
local lastDash = 0
local dashing = false
local shiftLockEnabled = false
local shiftLockConnection: RBXScriptConnection? = nil
local shiftLockCursor: ScreenGui? = nil
local defaultFov = 70

local DASH_ACTION = "FlipSimDash"
local SHIFT_LOCK_ACTION = "FlipSimShiftLock"

local CURSOR_COLOR = Color3.fromRGB(228, 198, 98)
local CURSOR_SHADOW = Color3.fromRGB(40, 28, 16)

local function createShiftLockCursor(): ScreenGui
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ShiftLockCursor"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 100
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	local center = Instance.new("Frame")
	center.Name = "Center"
	center.AnchorPoint = Vector2.new(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	center.Size = UDim2.fromOffset(26, 26)
	center.BackgroundTransparency = 1
	center.Parent = screenGui

	local function createLine(name: string, size: UDim2, position: UDim2)
		local shadow = Instance.new("Frame")
		shadow.Name = `{name}Shadow`
		shadow.Size = size
		shadow.Position = position + UDim2.fromOffset(1, 1)
		shadow.BackgroundColor3 = CURSOR_SHADOW
		shadow.BorderSizePixel = 0
		shadow.Parent = center

		local line = Instance.new("Frame")
		line.Name = name
		line.Size = size
		line.Position = position
		line.BackgroundColor3 = CURSOR_COLOR
		line.BorderSizePixel = 0
		line.Parent = center

		UiCorner.apply(line, UDim.new(1, 0))
	end

	createLine("Horizontal", UDim2.fromOffset(18, 2), UDim2.new(0.5, -9, 0.5, -1))
	createLine("Vertical", UDim2.fromOffset(2, 18), UDim2.new(0.5, -1, 0.5, -9))

	local dotShadow = Instance.new("Frame")
	dotShadow.Name = "DotShadow"
	dotShadow.AnchorPoint = Vector2.new(0.5, 0.5)
	dotShadow.Position = UDim2.new(0.5, 1, 0.5, 1)
	dotShadow.Size = UDim2.fromOffset(4, 4)
	dotShadow.BackgroundColor3 = CURSOR_SHADOW
	dotShadow.BorderSizePixel = 0
	dotShadow.Parent = center

	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(4, 4)
	dot.BackgroundColor3 = CURSOR_COLOR
	dot.BorderSizePixel = 0
	dot.Parent = center

	UiCorner.apply(dot, UDim.new(1, 0))

	return screenGui
end

local function setCursorVisible(visible: boolean)
	if not shiftLockCursor then
		shiftLockCursor = createShiftLockCursor()
	end

	shiftLockCursor.Enabled = visible
	UserInputService.MouseIconEnabled = not visible
end

local function playDashEffects(character: Model, direction: Vector3)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local camera = workspace.CurrentCamera
	if camera then
		defaultFov = camera.FieldOfView
		TweenService:Create(camera, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			FieldOfView = defaultFov + 8,
		}):Play()
		task.delay(MovementConfig.DASH_DURATION + 0.05, function()
			if camera.Parent then
				TweenService:Create(camera, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					FieldOfView = defaultFov,
				}):Play()
			end
		end)
	end

	local effects = Instance.new("Attachment")
	effects.Name = "DashEffects"
	effects.CFrame = CFrame.lookAt(Vector3.zero, direction)
	effects.Parent = root

	local burst = Instance.new("ParticleEmitter")
	burst.Name = "DashBurst"
	burst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	burst.Lifetime = NumberRange.new(0.15, 0.35)
	burst.Speed = NumberRange.new(14, 24)
	burst.SpreadAngle = Vector2.new(18, 18)
	burst.Rate = 0
	burst.LightEmission = 0.8
	burst.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 220, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 170, 255)),
	})
	burst.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	burst.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	burst.Parent = effects
	burst:Emit(28)

	local trail = Instance.new("ParticleEmitter")
	trail.Name = "DashTrail"
	trail.Texture = "rbxasset://textures/particles/smoke_main.dds"
	trail.Lifetime = NumberRange.new(0.2, 0.45)
	trail.Speed = NumberRange.new(6, 12)
	trail.SpreadAngle = Vector2.new(12, 12)
	trail.Rate = 80
	trail.LightEmission = 0.35
	trail.Color = ColorSequence.new(Color3.fromRGB(150, 190, 255))
	trail.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.4),
		NumberSequenceKeypoint.new(1, 0),
	})
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = effects

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(150, 200, 255)
	light.Brightness = 2
	light.Range = 10
	light.Parent = root

	TweenService:Create(light, TweenInfo.new(MovementConfig.DASH_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Brightness = 0,
	}):Play()

	task.delay(MovementConfig.DASH_DURATION, function()
		trail.Enabled = false
	end)

	Debris:AddItem(effects, 0.6)
	Debris:AddItem(light, 0.6)
end

local function getDashDirection(humanoid: Humanoid, root: BasePart): Vector3
	local moveDirection = humanoid.MoveDirection
	if moveDirection.Magnitude > 0.05 then
		return Vector3.new(moveDirection.X, 0, moveDirection.Z).Unit
	end

	local lookDirection = root.CFrame.LookVector
	local flatLook = Vector3.new(lookDirection.X, 0, lookDirection.Z)
	if flatLook.Magnitude > 0.05 then
		return flatLook.Unit
	end

	return Vector3.new(0, 0, -1)
end

local function getCurrentStamina(): number
	return player:GetAttribute("Stamina") or StaminaConfig.MAX
end

local function requestDash()
	if dashing then
		return
	end

	if getCurrentStamina() < StaminaConfig.DASH_COST then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end

	local now = os.clock()
	if now - lastDash < MovementConfig.DASH_COOLDOWN then
		return
	end

	local direction = getDashDirection(humanoid, root)
	lastDash = now
	dashing = true
	playDashEffects(character, direction)
	dashEvent:FireServer(direction)

	task.delay(MovementConfig.DASH_DURATION + 0.05, function()
		dashing = false
	end)
end

local function disableDefaultShiftLock()
	local playerScripts = player:FindFirstChild("PlayerScripts")
	if not playerScripts then
		return
	end

	local ok, playerModule = pcall(function()
		return require(playerScripts:WaitForChild("PlayerModule"))
	end)

	if ok and playerModule then
		local getMouseLockController = (playerModule :: any).GetMouseLockController
		if typeof(getMouseLockController) == "function" then
			local controllerOk, mouseLockController = pcall(function()
				return getMouseLockController(playerModule)
			end)
			if controllerOk and mouseLockController then
				mouseLockController.BoundKeys = {}
			end
		end
	end
end

local function setShiftLockEnabled(enabled: boolean)
	shiftLockEnabled = enabled
	setCursorVisible(enabled)

	if shiftLockConnection then
		shiftLockConnection:Disconnect()
		shiftLockConnection = nil
	end

	if enabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		shiftLockConnection = RunService.RenderStepped:Connect(function()
			local character = player.Character
			if not character then
				return
			end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not humanoid or not root or humanoid.Health <= 0 then
				return
			end

			local camera = workspace.CurrentCamera
			if not camera then
				return
			end

			local lookVector = camera.CFrame.LookVector
			local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
			if flatLook.Magnitude > 0.001 then
				root.CFrame = CFrame.new(root.Position, root.Position + flatLook.Unit)
			end
		end)
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end

local function toggleShiftLock()
	setShiftLockEnabled(not shiftLockEnabled)
end

local function onDashAction(_actionName: string, inputState: Enum.UserInputState, _inputObject: InputObject)
	if inputState == Enum.UserInputState.Begin then
		requestDash()
	end
	return Enum.ContextActionResult.Sink
end

local function onShiftLockAction(_actionName: string, inputState: Enum.UserInputState, _inputObject: InputObject)
	if inputState == Enum.UserInputState.Begin then
		toggleShiftLock()
	end
	return Enum.ContextActionResult.Sink
end

local function bindInputActions()
	ContextActionService:UnbindAction(DASH_ACTION)
	ContextActionService:UnbindAction(SHIFT_LOCK_ACTION)

	ContextActionService:BindActionAtPriority(
		DASH_ACTION,
		onDashAction,
		false,
		Enum.ContextActionPriority.High.Value,
		Enum.KeyCode.LeftShift,
		Enum.KeyCode.RightShift
	)

	ContextActionService:BindActionAtPriority(
		SHIFT_LOCK_ACTION,
		onShiftLockAction,
		false,
		Enum.ContextActionPriority.High.Value,
		Enum.KeyCode.LeftControl,
		Enum.KeyCode.RightControl
	)
end

function MovementClient.init()
	dashEvent = ReplicatedStorage:WaitForChild("Dash") :: RemoteEvent
	shiftLockCursor = createShiftLockCursor()

	local camera = workspace.CurrentCamera
	if camera then
		defaultFov = camera.FieldOfView
	end

	bindInputActions()

	task.spawn(function()
		player:WaitForChild("PlayerScripts")
		for _ = 1, 15 do
			disableDefaultShiftLock()
			task.wait(0.2)
		end
	end)

	player.CharacterAdded:Connect(function()
		setShiftLockEnabled(false)
		task.defer(disableDefaultShiftLock)
	end)
end

return MovementClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">SpellClient</string>
            <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local SpellConfig = require(ReplicatedStorage.Shared.SpellConfig)
local SpellUpgradeConfig = require(ReplicatedStorage.Shared.SpellUpgradeConfig)
local StaminaConfig = require(ReplicatedStorage.Shared.StaminaConfig)
local UiCorner = require(script.Parent.UiCorner)

local SpellClient = {}

local CAST_ACTION = "CastEquippedSpell"

function SpellClient.init()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local castSpellEvent = ReplicatedStorage:WaitForChild("CastSpell") :: RemoteEvent
	local spellCastEffectEvent = ReplicatedStorage:WaitForChild("SpellCastEffect") :: RemoteEvent
	local spellLoadoutUpdatedEvent = ReplicatedStorage:WaitForChild("SpellLoadoutUpdated") :: RemoteEvent
	local profileStateEvent = ReplicatedStorage:WaitForChild("PlayerProfileState") :: RemoteEvent
	local phaseStateEvent = ReplicatedStorage:WaitForChild("PlayerPhaseState") :: RemoteEvent

	local inDungeon = false
	local castBound = false
	local infusedSpellId = ""
	local spellLevels: { [string]: number } = {}

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SpellCombatUI"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local castHud = Instance.new("Frame")
	castHud.Name = "CastHud"
	castHud.AnchorPoint = Vector2.new(1, 1)
	castHud.Position = UDim2.new(1, -16, 1, -78)
	castHud.Size = UDim2.fromOffset(250, 58)
	castHud.BackgroundColor3 = Color3.fromRGB(24, 18, 34)
	castHud.BackgroundTransparency = 0.12
	castHud.BorderSizePixel = 0
	castHud.Visible = false
	castHud.Parent = screenGui

	UiCorner.apply(castHud, 10)

	local castHudStroke = Instance.new("UIStroke")
	castHudStroke.Color = Color3.fromRGB(160, 96, 255)
	castHudStroke.Thickness = 2
	castHudStroke.Parent = castHud

	local castNameLabel = Instance.new("TextLabel")
	castNameLabel.BackgroundTransparency = 1
	castNameLabel.Position = UDim2.fromOffset(12, 8)
	castNameLabel.Size = UDim2.new(1, -24, 0, 22)
	castNameLabel.Font = Enum.Font.GothamBold
	castNameLabel.Text = "Firebolt"
	castNameLabel.TextColor3 = Color3.fromRGB(255, 220, 160)
	castNameLabel.TextSize = 18
	castNameLabel.TextXAlignment = Enum.TextXAlignment.Left
	castNameLabel.Parent = castHud

	local castHintLabel = Instance.new("TextLabel")
	castHintLabel.BackgroundTransparency = 1
	castHintLabel.Position = UDim2.fromOffset(12, 30)
	castHintLabel.Size = UDim2.new(1, -24, 0, 18)
	castHintLabel.Font = Enum.Font.Gotham
	castHintLabel.Text = "Press E to cast"
	castHintLabel.TextColor3 = Color3.fromRGB(196, 180, 220)
	castHintLabel.TextSize = 14
	castHintLabel.TextXAlignment = Enum.TextXAlignment.Left
	castHintLabel.Parent = castHud

	local function getCurrentStamina(): number
		return player:GetAttribute("Stamina") or StaminaConfig.MAX
	end

	local function getInfusedStats()
		if infusedSpellId == "" then
			return nil
		end
		local level = spellLevels[infusedSpellId] or 1
		return SpellUpgradeConfig.getEffectiveStats(infusedSpellId, level)
	end

	local function canCastInfusedSpell(): boolean
		local stats = getInfusedStats()
		if not stats then
			return false
		end
		return getCurrentStamina() >= stats.staminaCost
	end

	local function updateCastHud()
		local stats = getInfusedStats()
		if not stats or not inDungeon then
			castHud.Visible = false
			return
		end

		local stamina = getCurrentStamina()
		local canCast = stamina >= stats.staminaCost

		castNameLabel.Text = stats.resolvedName
		castHudStroke.Color = stats.projectileColor
		castHintLabel.Text = if canCast
			then `Press E  |  {stats.staminaCost} stamina`
			else `Need {stats.staminaCost} stamina ({math.floor(stamina)} left)`
		castHintLabel.TextColor3 = if canCast
			then Color3.fromRGB(196, 180, 220)
			else Color3.fromRGB(255, 140, 120)
		castHud.Visible = true
	end

	local function showCastFlash(color: Color3)
		local flash = Instance.new("Frame")
		flash.Name = "SpellCastFlash"
		flash.BackgroundColor3 = color
		flash.BackgroundTransparency = 0.78
		flash.BorderSizePixel = 0
		flash.Size = UDim2.fromScale(1, 1)
		flash.ZIndex = 20
		flash.Parent = screenGui

		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.55)
		ring.Size = UDim2.fromOffset(220, 220)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 21
		ring.Parent = flash

		local ringStroke = Instance.new("UIStroke")
		ringStroke.Color = color
		ringStroke.Thickness = 8
		ringStroke.Transparency = 0.15
		ringStroke.Parent = ring

		UiCorner.apply(ring, UDim.new(1, 0))

		TweenService:Create(ring, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(420, 420),
		}):Play()
		TweenService:Create(ringStroke, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1,
		}):Play()
		TweenService:Create(flash, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 1,
		}):Play()

		task.delay(0.3, function()
			flash:Destroy()
		end)
	end

	local function showCharacterCastBurst(color: Color3)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end

		local anchor = Instance.new("Part")
		anchor.Name = "SpellCastAnchor"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(1, 1, 1)
		anchor.CFrame = root.CFrame * CFrame.new(0, 1.2, -1.5)
		anchor.Parent = workspace

		local core = Instance.new("Part")
		core.Name = "SpellCastCore"
		core.Anchored = true
		core.CanCollide = false
		core.CanQuery = false
		core.CanTouch = false
		core.Material = Enum.Material.Neon
		core.Color = color
		core.Size = Vector3.new(3.6, 3.6, 3.6)
		core.Transparency = 0.2
		core.CFrame = anchor.CFrame
		core.Parent = anchor

		local light = Instance.new("PointLight")
		light.Color = color
		light.Brightness = 7
		light.Range = 22
		light.Parent = core

		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
		emitter.LightEmission = 1
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Lifetime = NumberRange.new(0.25, 0.55)
		emitter.Speed = NumberRange.new(8, 18)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Parent = core
		emitter:Emit(48)

		task.delay(0.45, function()
			anchor:Destroy()
		end)
	end

	local function onCastAction(_actionName: string, inputState: Enum.UserInputState)
		if inputState ~= Enum.UserInputState.Begin or not inDungeon then
			return Enum.ContextActionResult.Pass
		end

		if not canCastInfusedSpell() then
			updateCastHud()
			return Enum.ContextActionResult.Sink
		end

		castSpellEvent:FireServer()
		return Enum.ContextActionResult.Sink
	end

	local function setCastBinding(enabled: boolean)
		if enabled and not castBound then
			ContextActionService:BindAction(CAST_ACTION, onCastAction, false, Enum.KeyCode.E)
			castBound = true
		elseif not enabled and castBound then
			ContextActionService:UnbindAction(CAST_ACTION)
			castBound = false
		end
	end

	spellLoadoutUpdatedEvent.OnClientEvent:Connect(function(activeInfusion: string, _locked: boolean)
		if typeof(activeInfusion) == "string" then
			infusedSpellId = activeInfusion
		end
		updateCastHud()
	end)

	profileStateEvent.OnClientEvent:Connect(function(snapshot)
		if typeof(snapshot) ~= "table" then
			return
		end

		if typeof(snapshot.infusedSpellId) == "string" then
			infusedSpellId = snapshot.infusedSpellId
		end
		if typeof(snapshot.spellLevels) == "table" then
			for spellId, level in snapshot.spellLevels do
				if typeof(level) == "number" then
					spellLevels[spellId] = level
				end
			end
		end
		updateCastHud()
	end)

	player:GetAttributeChangedSignal("Stamina"):Connect(updateCastHud)

	phaseStateEvent.OnClientEvent:Connect(function(phase: string)
		inDungeon = phase == "Dungeon"
		setCastBinding(inDungeon)
		updateCastHud()
	end)

	spellCastEffectEvent.OnClientEvent:Connect(function(_spellId: string, _spellName: string, color: Color3)
		if typeof(color) ~= "Color3" then
			return
		end

		showCastFlash(color)
		showCharacterCastBurst(color)
	end)

	player:GetAttributeChangedSignal("GamePhase"):Connect(function()
		local phase = player:GetAttribute("GamePhase")
		inDungeon = phase == "Dungeon"
		setCastBinding(inDungeon)
		updateCastHud()
	end)

	local initialPhase = player:GetAttribute("GamePhase")
	if initialPhase == "Dungeon" then
		inDungeon = true
		setCastBinding(true)
	end

	updateCastHud()
end

return SpellClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">SpellMenuClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local SpellConfig = require(ReplicatedStorage.Shared.SpellConfig)
local SpellUpgradeConfig = require(ReplicatedStorage.Shared.SpellUpgradeConfig)
local WeaponConfig = require(ReplicatedStorage.Shared.WeaponConfig)
local UiCorner = require(script.Parent.UiCorner)

local SpellMenuClient = {}

local GOLD = Color3.fromRGB(214, 176, 72)
local GOLD_DIM = Color3.fromRGB(140, 108, 42)
local PANEL = Color3.fromRGB(24, 20, 34)
local PANEL_LIGHT = Color3.fromRGB(42, 34, 52)
local TEXT = Color3.fromRGB(244, 228, 196)
local TEXT_DIM = Color3.fromRGB(170, 154, 128)
local LOCKED = Color3.fromRGB(110, 110, 110)
local ACCENT = Color3.fromRGB(96, 58, 148)
local ACTIVE_BADGE = Color3.fromRGB(255, 120, 48)

function SpellMenuClient.init()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local upgradeSpellEvent = ReplicatedStorage:WaitForChild("UpgradeSpell") :: RemoteEvent
	local spellLoadoutUpdatedEvent = ReplicatedStorage:WaitForChild("SpellLoadoutUpdated") :: RemoteEvent
	local profileStateEvent = ReplicatedStorage:WaitForChild("PlayerProfileState") :: RemoteEvent
	local phaseStateEvent = ReplicatedStorage:WaitForChild("PlayerPhaseState") :: RemoteEvent

	local infusedSpellId = ""
	local equippedWeapon = LobbyConfig.STARTER_WEAPON
	local weaponInfusions: { [string]: string } = {}
	local loadoutLocked = false
	local menuOpen = false
	local activeTab = "Collection"
	local walletGold = LobbyConfig.STARTER_GOLD
	local spellLevels: { [string]: number } = {}
	local ownedSpells: { [string]: boolean } = {
		[LobbyConfig.STARTER_ACTIVE_SPELL] = true,
	}
	local currentPhase = "Lobby"

	for _, spell in SpellConfig.getSpellList() do
		spellLevels[spell.id] = 1
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SpellMenuUI"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local menuButton = Instance.new("TextButton")
	menuButton.Name = "SpellsButton"
	menuButton.AnchorPoint = Vector2.new(0, 1)
	menuButton.Size = UDim2.fromOffset(220, 52)
	menuButton.Position = UDim2.new(0.5, 6, 1, -12)
	menuButton.BackgroundColor3 = ACCENT
	menuButton.BorderSizePixel = 0
	menuButton.Font = Enum.Font.GothamBold
	menuButton.Text = "Spells"
	menuButton.TextColor3 = Color3.new(1, 1, 1)
	menuButton.TextSize = 22
	menuButton.Parent = screenGui

	UiCorner.apply(menuButton, 10)

	local panel = Instance.new("Frame")
	panel.Name = "SpellPanel"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -70)
	panel.Size = UDim2.fromOffset(360, 360)
	panel.BackgroundColor3 = PANEL
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = screenGui

	UiCorner.apply(panel, 12)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 12)
	title.Size = UDim2.new(1, -32, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.Text = "Spellbook"
	title.TextColor3 = GOLD
	title.TextSize = 22
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = panel

	local statusLabel = Instance.new("TextLabel")
	statusLabel.BackgroundTransparency = 1
	statusLabel.Position = UDim2.fromOffset(16, 40)
	statusLabel.Size = UDim2.new(1, -32, 0, 48)
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.Text = "Learn spells from grimoires, then upgrade them here."
	statusLabel.TextColor3 = TEXT
	statusLabel.TextSize = 14
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.TextWrapped = true
	statusLabel.Parent = panel

	local tabBar = Instance.new("Frame")
	tabBar.BackgroundTransparency = 1
	tabBar.Position = UDim2.fromOffset(16, 90)
	tabBar.Size = UDim2.new(1, -32, 0, 34)
	tabBar.Parent = panel

	local tabLayout = Instance.new("UIListLayout")
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.Padding = UDim.new(0, 8)
	tabLayout.Parent = tabBar

	local equipTab = Instance.new("TextButton")
	equipTab.Size = UDim2.fromOffset(120, 32)
	equipTab.BackgroundColor3 = GOLD_DIM
	equipTab.BorderSizePixel = 0
	equipTab.Font = Enum.Font.GothamBold
	equipTab.Text = "Collection"
	equipTab.TextColor3 = TEXT
	equipTab.TextSize = 15
	equipTab.Parent = tabBar

	local upgradeTab = Instance.new("TextButton")
	upgradeTab.Size = UDim2.fromOffset(120, 32)
	upgradeTab.BackgroundColor3 = PANEL_LIGHT
	upgradeTab.BorderSizePixel = 0
	upgradeTab.Font = Enum.Font.GothamBold
	upgradeTab.Text = "Upgrade"
	upgradeTab.TextColor3 = TEXT
	upgradeTab.TextSize = 15
	upgradeTab.Parent = tabBar

	for _, tab in { equipTab, upgradeTab } do
		UiCorner.apply(tab, 8)
	end

	local list = Instance.new("ScrollingFrame")
	list.Name = "SpellList"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(16, 132)
	list.Size = UDim2.new(1, -32, 1, -148)
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.ScrollBarThickness = 6
	list.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		list.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 8)
	end)

	local emptyLabel = Instance.new("TextLabel")
	emptyLabel.Name = "EmptySpells"
	emptyLabel.BackgroundTransparency = 1
	emptyLabel.Size = UDim2.new(1, -32, 0, 96)
	emptyLabel.Position = UDim2.fromOffset(16, 148)
	emptyLabel.Font = Enum.Font.Gotham
	emptyLabel.Text = "No spells discovered yet.\nUse grimoires from the chest menu to learn new spells."
	emptyLabel.TextColor3 = TEXT_DIM
	emptyLabel.TextSize = 15
	emptyLabel.TextWrapped = true
	emptyLabel.Visible = false
	emptyLabel.Parent = panel

	local spellButtons: { [string]: TextButton } = {}

	local function getEffectiveDisplayStats(spellId: string)
		local level = spellLevels[spellId] or 1
		return SpellUpgradeConfig.getEffectiveStats(spellId, level)
	end

	local function updateSpellButtons()
		local ownedCount = 0

		for spellId, button in spellButtons do
			local stats = getEffectiveDisplayStats(spellId)
			local level = spellLevels[spellId] or 1
			local owned = ownedSpells[spellId] == true
			button.Visible = owned
			if not owned then
				continue
			end

			ownedCount += 1
			local infused = spellId == (weaponInfusions[equippedWeapon] or infusedSpellId)
			local ultimateTag = if stats.isUltimate then "  ULT" else ""

			if activeTab == "Collection" then
				if infused then
					button.Text =
						`{stats.resolvedName}{ultimateTag}  INFUSED  Lv {level}\n[Press E]  {stats.damageMin}-{stats.damageMax} dmg  |  {stats.staminaCost} ST`
					button.BackgroundColor3 = GOLD_DIM
				else
					button.Text =
						`{stats.resolvedName}{ultimateTag}  Lv {level}\nInfuse at Mira onto a weapon, then press E`
					button.BackgroundColor3 = PANEL_LIGHT
				end
				button.TextColor3 = TEXT
				button.AutoButtonColor = false
			else
				local cost = SpellUpgradeConfig.getUpgradeCost(spellId, level)
				if level >= SpellUpgradeConfig.MAX_LEVEL then
					button.Text =
						`{stats.resolvedName}{ultimateTag}  Lv {level} MAX\n{stats.damageMin}-{stats.damageMax} dmg  |  {stats.staminaCost} ST`
					button.BackgroundColor3 = GOLD_DIM
					button.TextColor3 = TEXT
					button.AutoButtonColor = false
				elseif level >= SpellUpgradeConfig.ULTIMATE_LEVEL - 1 and level < SpellUpgradeConfig.ULTIMATE_LEVEL then
					button.Text =
						`{stats.displayName}  Lv {level} -> ULTIMATE\nUpgrade for {cost} gold`
					button.BackgroundColor3 = PANEL_LIGHT
					button.TextColor3 = if walletGold >= cost and not loadoutLocked then GOLD else LOCKED
					button.AutoButtonColor = walletGold >= cost and not loadoutLocked
				else
					button.Text = `{stats.displayName}  Lv {level} -> {level + 1}\nUpgrade for {cost} gold`
					button.BackgroundColor3 = PANEL_LIGHT
					button.TextColor3 = if walletGold >= cost and not loadoutLocked then TEXT else LOCKED
					button.AutoButtonColor = walletGold >= cost and not loadoutLocked
				end
			end
		end

		emptyLabel.Visible = ownedCount == 0
		list.Visible = ownedCount > 0
	end

	local function updateMenuState()
		local inLobby = currentPhase == "Lobby"
		menuButton.Visible = inLobby or not LobbyConfig.USE_LOBBY
		menuButton.BackgroundColor3 = if loadoutLocked or not inLobby then LOCKED else ACCENT
		menuButton.AutoButtonColor = not loadoutLocked and inLobby

		equipTab.BackgroundColor3 = if activeTab == "Collection" then GOLD_DIM else PANEL_LIGHT
		upgradeTab.BackgroundColor3 = if activeTab == "Upgrade" then GOLD_DIM else PANEL_LIGHT

		local equippedInfusion = weaponInfusions[equippedWeapon] or infusedSpellId
		local weaponName = WeaponConfig.getWeapon(equippedWeapon).displayName
		local infusedName = if equippedInfusion ~= ""
			then getEffectiveDisplayStats(equippedInfusion).resolvedName
			else "None"

		if loadoutLocked or not inLobby then
			statusLabel.Text = "Spell loadout locked during a dungeon run."
		elseif activeTab == "Collection" then
			statusLabel.Text =
				`{weaponName} infusion: {infusedName}  |  Press E while wielding it.\nGold: {walletGold}`
		else
			statusLabel.Text =
				`Upgrade discovered spells. Ultimates unlock at level {SpellUpgradeConfig.ULTIMATE_LEVEL}. Wallet: {walletGold}`
		end

		updateSpellButtons()
	end

	for index, stats in SpellConfig.getSpellList() do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -4, 0, 78)
		button.BackgroundColor3 = PANEL_LIGHT
		button.BorderSizePixel = 0
		button.Font = Enum.Font.GothamBold
		button.TextSize = 15
		button.TextWrapped = true
		button.LayoutOrder = index
		button.Parent = list

		UiCorner.apply(button, 8)

		local badge = Instance.new("Frame")
		badge.Size = UDim2.fromOffset(6, 78)
		badge.BorderSizePixel = 0
		badge.BackgroundColor3 = ACTIVE_BADGE
		badge.Parent = button

		UiCorner.apply(badge, 8)

		button.MouseButton1Click:Connect(function()
			if loadoutLocked or currentPhase ~= "Lobby" or ownedSpells[stats.id] ~= true then
				return
			end

			if activeTab == "Upgrade" then
				upgradeSpellEvent:FireServer(stats.id)
			end
		end)

		spellButtons[stats.id] = button
	end

	equipTab.MouseButton1Click:Connect(function()
		activeTab = "Collection"
		updateMenuState()
	end)

	upgradeTab.MouseButton1Click:Connect(function()
		activeTab = "Upgrade"
		updateMenuState()
	end)

	menuButton.MouseButton1Click:Connect(function()
		if loadoutLocked or currentPhase ~= "Lobby" then
			menuOpen = false
			panel.Visible = false
			return
		end

		menuOpen = not menuOpen
		panel.Visible = menuOpen
	end)

	spellLoadoutUpdatedEvent.OnClientEvent:Connect(function(activeInfusion: string, locked: boolean)
		if typeof(activeInfusion) == "string" then
			infusedSpellId = activeInfusion
		end
		loadoutLocked = locked == true
		if locked then
			menuOpen = false
			panel.Visible = false
		end
		updateMenuState()
	end)

	profileStateEvent.OnClientEvent:Connect(function(snapshot)
		if typeof(snapshot) ~= "table" then
			return
		end

		if typeof(snapshot.gold) == "number" then
			walletGold = snapshot.gold
		end
		if typeof(snapshot.equippedWeapon) == "string" then
			equippedWeapon = snapshot.equippedWeapon
		end
		if typeof(snapshot.weaponInfusions) == "table" then
			weaponInfusions = {}
			for weaponId, spellId in snapshot.weaponInfusions do
				if typeof(spellId) == "string" and spellId ~= "" then
					weaponInfusions[weaponId] = spellId
				end
			end
		end
		if typeof(snapshot.infusedSpellId) == "string" then
			infusedSpellId = snapshot.infusedSpellId
		end
		if typeof(snapshot.spellLevels) == "table" then
			for spellId, level in snapshot.spellLevels do
				if typeof(level) == "number" then
					spellLevels[spellId] = level
				end
			end
		end
		if typeof(snapshot.ownedSpells) == "table" then
			for spellId, owned in snapshot.ownedSpells do
				if typeof(owned) == "boolean" then
					ownedSpells[spellId] = owned
				end
			end
		elseif typeof(snapshot.unlockedSpells) == "table" then
			for spellId, unlocked in snapshot.unlockedSpells do
				if typeof(unlocked) == "boolean" then
					ownedSpells[spellId] = unlocked
				end
			end
		end

		updateMenuState()
	end)

	phaseStateEvent.OnClientEvent:Connect(function(phase: string)
		if phase == "Lobby" or phase == "Dungeon" then
			currentPhase = phase
			if phase == "Dungeon" then
				menuOpen = false
				panel.Visible = false
			end
			updateMenuState()
		end
	end)

	SpellMenuClient._openToTab = function(tab: string)
		if loadoutLocked or currentPhase ~= "Lobby" then
			return
		end

		if tab == "Collection" or tab == "Upgrade" or tab == "Equip" then
			activeTab = if tab == "Equip" then "Collection" else tab
		end

		menuOpen = true
		panel.Visible = true
		updateMenuState()
	end

	updateMenuState()
end

function SpellMenuClient.openToTab(tab: string)
	if SpellMenuClient._openToTab then
		SpellMenuClient._openToTab(tab)
	end
end

return SpellMenuClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">StaminaBarUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local StaminaConfig = require(ReplicatedStorage.Shared.StaminaConfig)
local UiCorner = require(script.Parent.UiCorner)

local StaminaBarUI = {}

local PALETTE = {
	shadow = Color3.fromRGB(8, 4, 10),
	frame = Color3.fromRGB(36, 18, 14),
	inset = Color3.fromRGB(18, 10, 8),
	fill = Color3.fromRGB(72, 168, 255),
	fillLow = Color3.fromRGB(255, 170, 72),
	fillEmpty = Color3.fromRGB(120, 60, 60),
	gold = Color3.fromRGB(228, 188, 84),
}

local player = Players.LocalPlayer
local billboard: BillboardGui?
local fillBar: Frame?
local valueLabel: TextLabel?
local characterConnections: { RBXScriptConnection } = {}

local function disconnectCharacterConnections()
	for _, connection in characterConnections do
		connection:Disconnect()
	end
	table.clear(characterConnections)
end

local function getStaminaRatio(): number
	local maxStamina = player:GetAttribute("MaxStamina") or StaminaConfig.MAX
	local stamina = player:GetAttribute("Stamina") or maxStamina
	if maxStamina <= 0 then
		return 0
	end
	return math.clamp(stamina / maxStamina, 0, 1)
end

local function getFillColor(ratio: number): Color3
	if ratio <= 0.01 then
		return PALETTE.fillEmpty
	end
	if ratio <= 0.25 then
		return PALETTE.fillLow
	end
	return PALETTE.fill
end

local function updateBar()
	if not fillBar or not valueLabel then
		return
	end

	local maxStamina = player:GetAttribute("MaxStamina") or StaminaConfig.MAX
	local stamina = player:GetAttribute("Stamina") or maxStamina
	local ratio = getStaminaRatio()
	local color = getFillColor(ratio)

	fillBar.BackgroundColor3 = color
	valueLabel.Text = `{math.floor(stamina)}`
	TweenService:Create(fillBar, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(1, 0, ratio, 0),
	}):Play()
end

local function mountBar(character: Model)
	disconnectCharacterConnections()

	if billboard then
		billboard:Destroy()
		billboard = nil
		fillBar = nil
		valueLabel = nil
	end

	local root = character:WaitForChild("HumanoidRootPart") :: BasePart
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid

	local gui = Instance.new("BillboardGui")
	gui.Name = "StaminaBar"
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromOffset(18, 88)
	gui.StudsOffset = Vector3.new(-3.4, 0.75, 0)
	gui.Adornee = root
	gui.Parent = root
	billboard = gui

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.BackgroundColor3 = PALETTE.frame
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = gui

	UiCorner.apply(frame, 6)

	local stroke = Instance.new("UIStroke")
	stroke.Color = PALETTE.gold
	stroke.Thickness = 1.5
	stroke.Parent = frame

	local inset = Instance.new("Frame")
	inset.Name = "Inset"
	inset.AnchorPoint = Vector2.new(0.5, 1)
	inset.Position = UDim2.new(0.5, 0, 1, -4)
	inset.Size = UDim2.new(1, -8, 1, -22)
	inset.BackgroundColor3 = PALETTE.inset
	inset.BorderSizePixel = 0
	inset.ClipsDescendants = true
	inset.Parent = frame

	UiCorner.apply(inset, 4)

	fillBar = Instance.new("Frame")
	fillBar.Name = "Fill"
	fillBar.AnchorPoint = Vector2.new(0.5, 1)
	fillBar.Position = UDim2.fromScale(0.5, 1)
	fillBar.Size = UDim2.new(1, 0, 1, 0)
	fillBar.BackgroundColor3 = PALETTE.fill
	fillBar.BorderSizePixel = 0
	fillBar.Parent = inset

	UiCorner.apply(fillBar, 4)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 16)
	title.Position = UDim2.fromOffset(0, 2)
	title.Font = Enum.Font.GothamBold
	title.Text = "ST"
	title.TextColor3 = PALETTE.gold
	title.TextSize = 10
	title.Parent = frame

	valueLabel = Instance.new("TextLabel")
	valueLabel.BackgroundTransparency = 1
	valueLabel.AnchorPoint = Vector2.new(0.5, 0)
	valueLabel.Position = UDim2.new(0.5, 0, 0, 18)
	valueLabel.Size = UDim2.new(1, 0, 0, 12)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.Text = "0"
	valueLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
	valueLabel.TextSize = 9
	valueLabel.Parent = frame

	table.insert(characterConnections, player:GetAttributeChangedSignal("Stamina"):Connect(updateBar))
	table.insert(characterConnections, player:GetAttributeChangedSignal("MaxStamina"):Connect(updateBar))
	table.insert(characterConnections, humanoid.HealthChanged:Connect(function(health)
		if health <= 0 and billboard then
			billboard.Enabled = false
		elseif billboard then
			billboard.Enabled = true
		end
	end))

	updateBar()
end

function StaminaBarUI.init()
	if player.Character then
		mountBar(player.Character)
	end

	player.CharacterAdded:Connect(mountBar)
end

return StaminaBarUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">TreasureChestClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local TreasureChestPreview = require(script.Parent.TreasureChestPreview)

local TreasureChestClient = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local GOLD = Color3.fromRGB(228, 188, 84)
local GOLD_BRIGHT = Color3.fromRGB(255, 228, 140)
local GRIMOIRE = Color3.fromRGB(180, 120, 255)
local GRIMOIRE_BRIGHT = Color3.fromRGB(220, 180, 255)
local SHADOW = Color3.fromRGB(8, 4, 10)
local REQUIRED_TAPS = 3

local screenGui: ScreenGui
local backdrop: Frame
local container: Frame
local goldLabel: TextLabel
local grimoireLabel: TextLabel
local tapHintLabel: TextLabel
local viewportHost: Frame
local activeToken = 0

local function smoothstep(alpha: number): number
	alpha = math.clamp(alpha, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

local function ensureUI()
	if screenGui then
		return
	end

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "TreasureChestOpenUI"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 20
	screenGui.Enabled = true
	screenGui.Parent = playerGui

	backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.BackgroundColor3 = Color3.new(0, 0, 0)
	backdrop.BackgroundTransparency = 0.42
	backdrop.BorderSizePixel = 0
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.Visible = false
	backdrop.ZIndex = 1
	backdrop.Parent = screenGui

	container = Instance.new("Frame")
	container.Name = "ChestOpenContainer"
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.BackgroundTransparency = 1
	container.Position = UDim2.fromScale(0.5, 0.5)
	container.Size = UDim2.fromOffset(620, 540)
	container.Visible = false
	container.ZIndex = 2
	container.Parent = screenGui

	goldLabel = Instance.new("TextLabel")
	goldLabel.Name = "GoldReward"
	goldLabel.AnchorPoint = Vector2.new(0.5, 0)
	goldLabel.BackgroundTransparency = 1
	goldLabel.Position = UDim2.new(0.5, 0, 0, 0)
	goldLabel.Size = UDim2.fromOffset(360, 52)
	goldLabel.Font = Enum.Font.Antique
	goldLabel.Text = ""
	goldLabel.TextColor3 = GOLD_BRIGHT
	goldLabel.TextSize = 38
	goldLabel.TextStrokeColor3 = SHADOW
	goldLabel.TextStrokeTransparency = 0.1
	goldLabel.TextTransparency = 1
	goldLabel.ZIndex = 4
	goldLabel.Parent = container

	grimoireLabel = Instance.new("TextLabel")
	grimoireLabel.Name = "GrimoireReward"
	grimoireLabel.AnchorPoint = Vector2.new(0.5, 0)
	grimoireLabel.BackgroundTransparency = 1
	grimoireLabel.Position = UDim2.new(0.5, 0, 0, 52)
	grimoireLabel.Size = UDim2.fromOffset(360, 44)
	grimoireLabel.Font = Enum.Font.Antique
	grimoireLabel.Text = ""
	grimoireLabel.TextColor3 = GRIMOIRE_BRIGHT
	grimoireLabel.TextSize = 30
	grimoireLabel.TextStrokeColor3 = SHADOW
	grimoireLabel.TextStrokeTransparency = 0.1
	grimoireLabel.TextTransparency = 1
	grimoireLabel.Visible = false
	grimoireLabel.ZIndex = 4
	grimoireLabel.Parent = container

	tapHintLabel = Instance.new("TextLabel")
	tapHintLabel.Name = "TapHint"
	tapHintLabel.AnchorPoint = Vector2.new(0.5, 1)
	tapHintLabel.BackgroundTransparency = 1
	tapHintLabel.Position = UDim2.new(0.5, 0, 1, -4)
	tapHintLabel.Size = UDim2.fromOffset(420, 36)
	tapHintLabel.Font = Enum.Font.Antique
	tapHintLabel.Text = "Tap the chest to open!"
	tapHintLabel.TextColor3 = GOLD
	tapHintLabel.TextSize = 24
	tapHintLabel.TextStrokeColor3 = SHADOW
	tapHintLabel.TextStrokeTransparency = 0.15
	tapHintLabel.ZIndex = 4
	tapHintLabel.Parent = container

	viewportHost = Instance.new("Frame")
	viewportHost.Name = "ViewportHost"
	viewportHost.BackgroundTransparency = 1
	viewportHost.Position = UDim2.fromOffset(0, 58)
	viewportHost.Size = UDim2.new(1, 0, 1, -108)
	viewportHost.ClipsDescendants = false
	viewportHost.Parent = container
end

local function weld(part0: BasePart, part1: BasePart)
	local weldConstraint = Instance.new("WeldConstraint")
	weldConstraint.Part0 = part0
	weldConstraint.Part1 = part1
	weldConstraint.Parent = part0
end

local function createViewportCoin(color: Color3, accent: Color3): Model
	local coinModel = Instance.new("Model")
	coinModel.Name = "GoldCoin"

	local disc = Instance.new("Part")
	disc.Name = "Disc"
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.07, 0.34, 0.34)
	disc.Color = color
	disc.Material = Enum.Material.Metal
	disc.Anchored = true
	disc.CanCollide = false
	disc.Parent = coinModel

	local rim = Instance.new("Part")
	rim.Name = "Rim"
	rim.Shape = Enum.PartType.Cylinder
	rim.Size = Vector3.new(0.045, 0.36, 0.36)
	rim.Color = accent
	rim.Material = Enum.Material.Neon
	rim.Anchored = true
	rim.CanCollide = false
	rim.Transparency = 0.12
	rim.Parent = coinModel

	local face = Instance.new("Part")
	face.Name = "Face"
	face.Shape = Enum.PartType.Cylinder
	face.Size = Vector3.new(0.02, 0.22, 0.22)
	face.Color = GOLD_BRIGHT
	face.Material = Enum.Material.Neon
	face.Anchored = true
	face.CanCollide = false
	face.Transparency = 0.25
	face.Parent = coinModel

	disc.CFrame = CFrame.new()
	rim.CFrame = disc.CFrame
	face.CFrame = disc.CFrame * CFrame.new(0.028, 0, 0)

	weld(disc, rim)
	weld(disc, face)

	coinModel.PrimaryPart = disc
	return coinModel
end

local function animateViewportPart(
	model: Model,
	mid: Vector3,
	endPos: Vector3,
	duration: number,
	spin: Vector3
)
	local root = model.PrimaryPart
	if not root then
		model:Destroy()
		return
	end

	local startCFrame = model:GetPivot()
	local startTime = os.clock()
	local connection: RBXScriptConnection

	connection = RunService.RenderStepped:Connect(function()
		if not model.Parent then
			connection:Disconnect()
			return
		end

		local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
		local eased = smoothstep(alpha)
		local arcAlpha = math.sin(eased * math.pi)
		local position = startCFrame.Position:Lerp(mid, arcAlpha):Lerp(endPos, eased)
		local spinOffset = CFrame.Angles(spin.X * eased, spin.Y * eased, spin.Z * eased)
		model:PivotTo(CFrame.new(position) * (startCFrame - startCFrame.Position) * spinOffset)

		if alpha >= 1 then
			connection:Disconnect()
			model:Destroy()
		end
	end)
end

local function spawnViewportGoldStream(
	model: Model,
	parts: TreasureChestPreview.ChestModelParts,
	gold: number,
	tierGlow: Color3
)
	local origin = parts.lidOpenCFrame.Position + Vector3.new(0, 0.12, 0.42)
	local coinCount = math.clamp(math.floor(gold / 5), 20, 48)

	for index = 1, coinCount do
		task.delay((index - 1) * 0.03, function()
			if not model.Parent then
				return
			end

			local coinModel = createViewportCoin(
				if index % 5 == 0 then tierGlow else GOLD,
				if index % 3 == 0 then GOLD_BRIGHT else tierGlow
			)
			coinModel:PivotTo(
				CFrame.new(origin)
					* CFrame.new(math.random(-18, 18) / 100, math.random(-4, 8) / 100, math.random(-12, 12) / 100)
					* CFrame.Angles(math.random() * math.pi, math.random() * math.pi, math.random() * math.pi)
			)
			coinModel.Parent = model

			local horizontal = Vector3.new(math.random(-22, 22) / 10, 0, math.random(-22, 22) / 10)
			local rise = Vector3.new(0, math.random(14, 32) / 10, 0)
			local fall = Vector3.new(horizontal.X, -math.random(32, 58) / 10, horizontal.Z)
			local mid = origin + rise + horizontal * 0.5
			local endPos = origin + fall
			local duration = 0.65 + math.random() * 0.4
			local spin = Vector3.new(math.random(4, 9), math.random(5, 11), math.random(3, 8))

			animateViewportPart(coinModel, mid, endPos, duration, spin)
		end)
	end
end

local function createViewportGrimoireModel(): Model
	local grimoireModel = Instance.new("Model")
	grimoireModel.Name = "GrimoireDrop"

	local cover = Instance.new("Part")
	cover.Name = "Cover"
	cover.Size = Vector3.new(0.62, 0.82, 0.1)
	cover.Color = GRIMOIRE
	cover.Material = Enum.Material.SmoothPlastic
	cover.Anchored = true
	cover.CanCollide = false
	cover.Parent = grimoireModel

	local spine = Instance.new("Part")
	spine.Name = "Spine"
	spine.Size = Vector3.new(0.12, 0.82, 0.14)
	spine.Color = Color3.fromRGB(92, 58, 128)
	spine.Material = Enum.Material.SmoothPlastic
	spine.Anchored = true
	spine.CanCollide = false
	spine.Parent = grimoireModel

	local pages = Instance.new("Part")
	pages.Name = "Pages"
	pages.Size = Vector3.new(0.56, 0.76, 0.08)
	pages.Color = Color3.fromRGB(236, 224, 196)
	pages.Material = Enum.Material.SmoothPlastic
	pages.Anchored = true
	pages.CanCollide = false
	pages.Parent = grimoireModel

	local clasp = Instance.new("Part")
	clasp.Name = "Clasp"
	clasp.Size = Vector3.new(0.14, 0.14, 0.14)
	clasp.Shape = Enum.PartType.Ball
	clasp.Color = GRIMOIRE_BRIGHT
	clasp.Material = Enum.Material.Neon
	clasp.Anchored = true
	clasp.CanCollide = false
	clasp.Parent = grimoireModel

	local rune = Instance.new("Part")
	rune.Name = "Rune"
	rune.Size = Vector3.new(0.24, 0.24, 0.04)
	rune.Color = GRIMOIRE_BRIGHT
	rune.Material = Enum.Material.Neon
	rune.Anchored = true
	rune.CanCollide = false
	rune.Parent = grimoireModel

	cover.CFrame = CFrame.new()
	spine.CFrame = cover.CFrame * CFrame.new(-0.33, 0, 0)
	pages.CFrame = cover.CFrame * CFrame.new(0.02, 0, -0.04)
	clasp.CFrame = cover.CFrame * CFrame.new(0.18, -0.24, 0.08)
	rune.CFrame = cover.CFrame * CFrame.new(0.08, 0.12, 0.06)

	weld(cover, spine)
	weld(cover, pages)
	weld(cover, clasp)
	weld(cover, rune)

	local light = Instance.new("PointLight")
	light.Color = GRIMOIRE_BRIGHT
	light.Brightness = 2.2
	light.Range = 6
	light.Parent = cover

	grimoireModel.PrimaryPart = cover
	return grimoireModel
end

local function spawnViewportGrimoire(model: Model, parts: TreasureChestPreview.ChestModelParts)
	local origin = parts.lidOpenCFrame.Position + Vector3.new(0, 0.28, 0.28)
	local grimoireModel = createViewportGrimoireModel()
	grimoireModel:PivotTo(CFrame.new(origin) * CFrame.Angles(math.rad(-24), math.rad(18), math.rad(10)))
	grimoireModel.Parent = model

	local horizontal = Vector3.new(0.55, 0, -0.35)
	local mid = origin + Vector3.new(0.25, 1.35, -0.15)
	local endPos = origin + horizontal + Vector3.new(0.9, 1.85, -0.55)
	local duration = 1.15
	local startPivot = grimoireModel:GetPivot()
	local startTime = os.clock()

	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		if not grimoireModel.Parent then
			connection:Disconnect()
			return
		end

		local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
		local eased = smoothstep(alpha)
		local arcAlpha = math.sin(eased * math.pi)
		local position = startPivot.Position:Lerp(mid, arcAlpha):Lerp(endPos, eased)
		grimoireModel:PivotTo(
			CFrame.new(position)
				* CFrame.Angles(
					math.rad(-24 + eased * 18),
					math.rad(18 + eased * 50),
					math.rad(10 - eased * 22)
				)
		)

		for _, descendant in grimoireModel:GetDescendants() do
			if descendant:IsA("BasePart") and (descendant.Name == "Rune" or descendant.Name == "Clasp") then
				descendant.Transparency = 0.1 + math.sin(os.clock() * 8) * 0.08
			end
		end

		if alpha >= 1 then
			connection:Disconnect()
			for _, descendant in grimoireModel:GetDescendants() do
				if descendant:IsA("BasePart") then
					TweenService:Create(descendant, TweenInfo.new(0.4), { Transparency = 1 }):Play()
				elseif descendant:IsA("PointLight") then
					TweenService:Create(descendant, TweenInfo.new(0.4), { Brightness = 0 }):Play()
				end
			end
			task.delay(0.45, function()
				if grimoireModel.Parent then
					grimoireModel:Destroy()
				end
			end)
		end
	end)
end

local function playTapWobble(model: Model, basePivot: CFrame, intensity: number)
	for step = 1, 10 do
		local progress = step / 10
		local roll = math.sin(progress * math.pi * 5) * math.rad(intensity)
		local pitch = math.sin(progress * math.pi * 4) * math.rad(intensity * 0.45)
		model:PivotTo(basePivot * CFrame.Angles(pitch, 0, roll))
		RunService.RenderStepped:Wait()
	end
	model:PivotTo(basePivot)
end

local function runOpenSequence(
	token: number,
	model: Model,
	basePivot: CFrame,
	parts: TreasureChestPreview.ChestModelParts,
	gold: number,
	grimoireDropped: boolean
)
	local openDuration = 0.38
	local openStart = os.clock()
	while os.clock() - openStart < openDuration do
		if token ~= activeToken then
			return
		end

		local alpha = smoothstep((os.clock() - openStart) / openDuration)
		parts.lid.CFrame = parts.lidClosedCFrame:Lerp(parts.lidOpenCFrame, alpha)
		parts.glow.Transparency = 0.35 + alpha * 0.25
		model:PivotTo(basePivot)
		RunService.RenderStepped:Wait()
	end

	if token ~= activeToken then
		return
	end

	parts.lid.CFrame = parts.lidOpenCFrame
	spawnViewportGoldStream(model, parts, gold, parts.glow.Color)
	if grimoireDropped then
		spawnViewportGrimoire(model, parts)
	end

	TweenService:Create(goldLabel, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		TextTransparency = 0,
		TextStrokeTransparency = 0.1,
	}):Play()

	if grimoireDropped then
		grimoireLabel.Visible = true
		TweenService:Create(grimoireLabel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			TextTransparency = 0,
			TextStrokeTransparency = 0.1,
		}):Play()
	end

	task.wait(if grimoireDropped then 3.1 else 2.6)
	if token ~= activeToken then
		return
	end

	local fadeGold = TweenService:Create(goldLabel, TweenInfo.new(0.35), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	fadeGold:Play()

	if grimoireDropped then
		local fadeGrimoire = TweenService:Create(grimoireLabel, TweenInfo.new(0.35), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		fadeGrimoire:Play()
		fadeGrimoire.Completed:Wait()
	else
		fadeGold.Completed:Wait()
	end

	if token == activeToken then
		backdrop.Visible = false
		container.Visible = false
		for _, child in viewportHost:GetChildren() do
			child:Destroy()
		end
	end
end

local function playOpeningAnimation(loot: any)
	if typeof(loot) ~= "table" or typeof(loot.gold) ~= "number" then
		return
	end

	local tierId = if typeof(loot.tierId) == "string" then loot.tierId else "Common"
	local gold = math.floor(loot.gold)
	local grimoireDropped = loot.grimoireDropped == true

	ensureUI()
	activeToken += 1
	local token = activeToken

	for _, child in viewportHost:GetChildren() do
		child:Destroy()
	end

	backdrop.Visible = true
	container.Visible = true
	goldLabel.Text = `+{gold} Gold`
	goldLabel.TextTransparency = 1
	goldLabel.TextStrokeTransparency = 1
	grimoireLabel.Text = "+1 Grimoire"
	grimoireLabel.TextTransparency = 1
	grimoireLabel.TextStrokeTransparency = 1
	grimoireLabel.Visible = grimoireDropped
	tapHintLabel.Visible = true
	tapHintLabel.Text = `Tap the chest to open! (0/{REQUIRED_TAPS})`

	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "ChestViewport"
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.BackgroundTransparency = 1
	viewport.ZIndex = 2
	viewport.Parent = viewportHost

	local parts = TreasureChestPreview.buildChestModel(tierId)
	local model = parts.model
	local basePivot = CFrame.Angles(0, math.rad(24), math.rad(-10))
	model:PivotTo(basePivot)
	model.Parent = viewport

	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.new(Vector3.new(4.4, 3.1, 4.6), Vector3.new(0, 0.8, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	parts.lid.CFrame = parts.lidClosedCFrame
	parts.glow.Transparency = 0.35

	local tapButton = Instance.new("TextButton")
	tapButton.Name = "TapTarget"
	tapButton.Size = UDim2.fromScale(1, 1)
	tapButton.BackgroundTransparency = 1
	tapButton.Text = ""
	tapButton.AutoButtonColor = false
	tapButton.ZIndex = 10
	tapButton.Parent = viewportHost

	local tapCount = 0
	local finished = false

	local tapConnection: RBXScriptConnection
	tapConnection = tapButton.MouseButton1Click:Connect(function()
		if finished or token ~= activeToken then
			return
		end

		tapCount += 1
		tapHintLabel.Text = if tapCount < REQUIRED_TAPS
			then `Tap the chest to open! ({tapCount}/{REQUIRED_TAPS})`
			else "Opening..."

		task.spawn(function()
			playTapWobble(model, basePivot, 6 + tapCount)
		end)

		if tapCount < REQUIRED_TAPS then
			return
		end

		finished = true
		tapConnection:Disconnect()
		tapButton:Destroy()
		tapHintLabel.Visible = false

		task.spawn(function()
			runOpenSequence(token, model, basePivot, parts, gold, grimoireDropped)
		end)
	end)
end

function TreasureChestClient.init()
	local chestOpenedEvent = ReplicatedStorage:WaitForChild("TreasureChestOpened") :: RemoteEvent
	chestOpenedEvent.OnClientEvent:Connect(playOpeningAnimation)
end

return TreasureChestClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">TreasureChestPreview</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TreasureConfig = require(ReplicatedStorage.Shared.TreasureConfig)

local TreasureChestPreview = {}

export type ChestModelParts = {
	model: Model,
	base: BasePart,
	lid: BasePart,
	trim: BasePart,
	glow: BasePart,
	lidClosedCFrame: CFrame,
	lidOpenCFrame: CFrame,
}

function TreasureChestPreview.buildChestModel(tierId: string): ChestModelParts
	local tier = TreasureConfig.getTier(tierId)
	local model = Instance.new("Model")
	model.Name = "PreviewChest"

	local base = Instance.new("Part")
	base.Name = "ChestBase"
	base.Size = Vector3.new(3.2, 1.6, 2.4)
	base.Color = tier.bodyColor
	base.Material = Enum.Material.Wood
	base.Anchored = true
	base.CanCollide = false
	base.CFrame = CFrame.new(0, 0, 0)
	base.Parent = model

	local trim = Instance.new("Part")
	trim.Name = "ChestTrim"
	trim.Size = Vector3.new(3.35, 0.28, 2.55)
	trim.Color = tier.trimColor
	trim.Material = Enum.Material.Metal
	trim.Anchored = true
	trim.CanCollide = false
	trim.CFrame = base.CFrame * CFrame.new(0, 0.72, 0)
	trim.Parent = model

	local lid = Instance.new("Part")
	lid.Name = "ChestLid"
	lid.Size = Vector3.new(3.2, 0.85, 2.4)
	lid.Color = tier.bodyColor
	lid.Material = Enum.Material.Wood
	lid.Anchored = true
	lid.CanCollide = false
	local lidClosedCFrame = base.CFrame * CFrame.new(0, 1.05, -0.35)
	lid.CFrame = lidClosedCFrame
	lid.Parent = model

	local glow = Instance.new("Part")
	glow.Name = "ChestGlow"
	glow.Size = Vector3.new(2.4, 0.12, 1.8)
	glow.Color = tier.glowColor
	glow.Material = Enum.Material.Neon
	glow.Anchored = true
	glow.CanCollide = false
	glow.Transparency = 0.35
	glow.CFrame = base.CFrame * CFrame.new(0, 1.55, 0)
	glow.Parent = model

	local lidOpenCFrame = lidClosedCFrame * CFrame.new(0, 0.18, -0.62) * CFrame.Angles(math.rad(-118), 0, 0)

	model.PrimaryPart = base
	return {
		model = model,
		base = base,
		lid = lid,
		trim = trim,
		glow = glow,
		lidClosedCFrame = lidClosedCFrame,
		lidOpenCFrame = lidOpenCFrame,
	}
end

function TreasureChestPreview.mount(parent: Instance, tierId: string, size: number): ViewportFrame
	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.fromOffset(size, size)
	viewport.BackgroundTransparency = 1
	viewport.Parent = parent

	local parts = TreasureChestPreview.buildChestModel(tierId)
	local model = parts.model
	model:PivotTo(CFrame.Angles(0, math.rad(28), math.rad(-12)))
	model.Parent = viewport

	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.new(Vector3.new(5, 3.5, 5), model:GetPivot().Position)
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	return viewport
end

return TreasureChestPreview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">UiCorner</string>
            <string name="Source"><![CDATA[local UiCorner = {}

function UiCorner.apply(parent: Instance, radius: number | UDim): UICorner
	local udim: UDim = if typeof(radius) == "number" then UDim.new(0, radius) else radius

	local corner = Instance.new("UICorner")
	corner.TopLeftRadius = udim
	corner.TopRightRadius = udim
	corner.BottomRightRadius = udim
	corner.BottomLeftRadius = udim
	corner.Parent = parent
	return corner
end

return UiCorner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">UiStyleFix</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UiStyleFix = {}

local function radiusFromSelector(selector: string): number?
	local fromClass = string.match(selector, "RoundedCorner(%d+)")
	if fromClass then
		return tonumber(fromClass)
	end
	return nil
end

local function fixTokenAttributes(instance: Instance)
	for attributeName, attributeValue in instance:GetAttributes() do
		if typeof(attributeValue) ~= "string" then
			continue
		end

		local numeric = string.match(attributeValue, "^%$?(%d+)$")
			or string.match(attributeName, "(%d+)")
		if not numeric then
			continue
		end

		if string.find(attributeName, "Rad", 1, true)
			or string.find(attributeName, "Corner", 1, true)
			or string.find(attributeName, "Radius", 1, true)
		then
			instance:SetAttribute(attributeName, UDim.new(0, tonumber(numeric)))
		end
	end
end

local function fixStyleRule(rule: StyleRule)
	local selector = rule.Selector
	if typeof(selector) ~= "string" or not string.find(selector, "UICorner", 1, true) then
		return
	end

	local radius = radiusFromSelector(selector)
	if radius then
		rule:SetProperty("CornerRadius", UDim.new(0, radius))
	end
end

local function fixStyleSheet(sheet: StyleSheet)
	fixTokenAttributes(sheet)

	for _, descendant in sheet:GetDescendants() do
		if descendant:IsA("StyleRule") then
			fixStyleRule(descendant)
		elseif descendant:IsA("StyleSheet") then
			fixTokenAttributes(descendant)
		end
	end
end

local function scanFolder(folder: Instance)
	for _, child in folder:GetChildren() do
		if child:IsA("StyleSheet") then
			fixStyleSheet(child)
		elseif child:IsA("Folder") then
			scanFolder(child)
		end
	end
end

function UiStyleFix.init()
	scanFolder(ReplicatedStorage)

	ReplicatedStorage.ChildAdded:Connect(function(child)
		if child:IsA("StyleSheet") then
			task.defer(fixStyleSheet, child)
		elseif child:IsA("Folder") and (child.Name == "Design" or child.Name == "Designs") then
			task.defer(function()
				scanFolder(child)
			end)
		end
	end)
end

return UiStyleFix
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">WeaponClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local BroadswordConfig = require(ReplicatedStorage.Shared.BroadswordConfig)
local BroadswordPose = require(ReplicatedStorage.Shared.BroadswordPose)
local WeaponCombatConfig = require(ReplicatedStorage.Shared.WeaponCombatConfig)
local WeaponConfig = require(ReplicatedStorage.Shared.WeaponConfig)
local WaveConfig = require(ReplicatedStorage.Shared.WaveConfig)

local WeaponClient = {}

local player = Players.LocalPlayer
local swinging = false
local lastSwing = 0
local swingConnection: RBXScriptConnection? = nil
local activeTrack: AnimationTrack? = nil
local activeCharacter: Model? = nil
local activeTool: Tool? = nil
local activeMotors: BroadswordPose.ArmMotors = {}
local activeCombatConfig = WeaponCombatConfig.getConfig(WeaponConfig.DEFAULT_WEAPON)

local POSE_BIND = "FlipSimWeaponPose"
local SWING_BIND = "FlipSimWeaponSwingGrip"

local function applyShoulderIdle(character: Model, tool: Tool, combatConfig)
	local motors = BroadswordPose.getMotors(character)
	BroadswordPose.apply(motors, combatConfig.SHOULDER_POSE, tool)
end

local function isWaveWeapon(tool: Tool): boolean
	return WeaponConfig.getWeapon(tool:GetAttribute(WeaponConfig.WEAPON_ATTRIBUTE) :: string) ~= nil
end

local function getAnimator(humanoid: Humanoid): Animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	return animator
end

local function stopActiveTrack()
	if activeTrack then
		activeTrack:Stop(0.1)
		activeTrack = nil
	end
end

local function stopIdlePose()
	RunService:UnbindFromRenderStep(POSE_BIND)

	if activeCharacter and activeTool and activeMotors.rightShoulder then
		BroadswordPose.reset(activeMotors, activeTool, activeCombatConfig.SHOULDER_GRIP)
	end
end

local function startIdlePose(character: Model, tool: Tool)
	stopIdlePose()

	activeCharacter = character
	activeTool = tool
	activeMotors = BroadswordPose.getMotors(character)
	activeCombatConfig = WeaponCombatConfig.getConfigForTool(tool)
	applyShoulderIdle(character, tool, activeCombatConfig)

	RunService:BindToRenderStep(POSE_BIND, Enum.RenderPriority.Last.Value, function()
		if not character.Parent or tool.Parent ~= character then
			stopIdlePose()
			return
		end

		if swinging then
			return
		end

		BroadswordPose.apply(activeMotors, activeCombatConfig.SHOULDER_POSE, tool)
	end)
end

local function stopSwing(tool: Tool?, character: Model?)
	if swingConnection then
		swingConnection:Disconnect()
		swingConnection = nil
	end

	RunService:UnbindFromRenderStep(SWING_BIND)
	stopActiveTrack()
	swinging = false

	if character and tool and tool.Parent == character then
		local combatConfig = WeaponCombatConfig.getConfigForTool(tool)
		local motors = BroadswordPose.getMotors(character)
		BroadswordPose.reset(motors, tool, combatConfig.SHOULDER_GRIP)
		startIdlePose(character, tool)
	end
end

local function holdAnimationSwingGrip(tool: Tool, character: Model, progress: number)
	local motors = BroadswordPose.getMotors(character)
	BroadswordPose.reset(motors, tool, BroadswordConfig.getGripForAnimationSwing(progress))
end

local function playAnimationSwing(character: Model, tool: Tool)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		swinging = false
		return
	end

	stopIdlePose()
	holdAnimationSwingGrip(tool, character, 0)

	local animator = getAnimator(humanoid)
	local animation = Instance.new("Animation")
	animation.AnimationId = BroadswordConfig.SWING_ANIMATION_ID

	local track = animator:LoadAnimation(animation)
	track.Priority = Enum.AnimationPriority.Action
	activeTrack = track
	track:Play(0.08)

	local swingDuration = if track.Length > 0.05
		then track.Length * BroadswordConfig.ANIMATION_END_RATIO
		else BroadswordConfig.getSwingDuration()

	if swingConnection then
		swingConnection:Disconnect()
		swingConnection = nil
	end

	RunService:UnbindFromRenderStep(SWING_BIND)

	RunService:BindToRenderStep(SWING_BIND, Enum.RenderPriority.Last.Value, function()
		if not character.Parent or tool.Parent ~= character then
			stopSwing(tool, character)
			return
		end

		if not track.IsPlaying and track.TimePosition <= 0.01 then
			return
		end

		local progress = if track.Length > 0.05 then track.TimePosition / track.Length else 0
		tool.Grip = BroadswordConfig.getGripForAnimationSwing(progress)
	end)

	task.delay(swingDuration, function()
		if swinging and activeTrack == track then
			stopSwing(tool, character)
		end
	end)
end

local function playProceduralSwing(character: Model, tool: Tool)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		swinging = false
		return
	end

	local combatConfig = WeaponCombatConfig.getConfigForTool(tool)
	stopIdlePose()

	local motors = BroadswordPose.getMotors(character)
	local swingDuration = combatConfig.getSwingDuration()
	local startTime = os.clock()

	BroadswordPose.apply(motors, combatConfig.SHOULDER_POSE, tool)

	if swingConnection then
		swingConnection:Disconnect()
	end

	swingConnection = RunService.RenderStepped:Connect(function()
		if not character.Parent or tool.Parent ~= character then
			stopSwing(tool, character)
			return
		end

		local elapsed = os.clock() - startTime
		local pose = combatConfig.getPoseForSwing(elapsed)
		BroadswordPose.apply(motors, pose, tool)

		if elapsed >= swingDuration then
			stopSwing(tool, character)
		end
	end)
end

local function playSwing(character: Model, tool: Tool)
	if WeaponCombatConfig.usesAnimationSwingForTool(tool) then
		playAnimationSwing(character, tool)
	else
		playProceduralSwing(character, tool)
	end
end

local function onToolActivated(tool: Tool)
	if swinging then
		return
	end

	local character = tool.Parent
	if not character or not character:IsA("Model") or character ~= player.Character then
		return
	end

	local stats = WeaponConfig.getStatsForTool(tool)
	local now = os.clock()
	if now - lastSwing < stats.cooldown then
		return
	end

	swinging = true
	lastSwing = now
	playSwing(character, tool)
end

local function bindTool(tool: Tool)
	if tool:GetAttribute("ClientBound") then
		return
	end

	if not isWaveWeapon(tool) then
		return
	end

	tool:SetAttribute("ClientBound", true)

	tool.Equipped:Connect(function()
		local character = tool.Parent
		if character and character:IsA("Model") then
			startIdlePose(character, tool)
		end
	end)

	tool.Unequipped:Connect(function()
		if activeTool == tool then
			stopSwing(tool, activeCharacter)
			stopIdlePose()
			activeCharacter = nil
			activeTool = nil
			activeMotors = {}
		end
	end)

	tool.Activated:Connect(function()
		onToolActivated(tool)
	end)

	if tool.Parent and tool.Parent == player.Character then
		startIdlePose(tool.Parent, tool)
	end
end

local function bindCharacter(character: Model)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and isWaveWeapon(child) then
			bindTool(child)
		end
	end

	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and isWaveWeapon(child) then
			bindTool(child)
		end
	end)

	character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			stopSwing(activeTool, character)
			stopIdlePose()
		end
	end)
end

function WeaponClient.init()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, false)

	local swordHitEvent = ReplicatedStorage:WaitForChild("SwordHitMonster") :: RemoteEvent
	local hitSound = Instance.new("Sound")
	hitSound.Name = "SwordHitSound"
	hitSound.SoundId = WaveConfig.SWORD_HIT_SOUND_ID
	hitSound.Volume = 0.65
	hitSound.Parent = player:WaitForChild("PlayerGui")

	swordHitEvent.OnClientEvent:Connect(function()
		hitSound.PlaybackSpeed = 0.92 + math.random() * 0.16
		hitSound:Play()
	end)

	if player.Character then
		bindCharacter(player.Character)
	end

	player.CharacterAdded:Connect(function(character)
		bindCharacter(character)
	end)
end

return WeaponClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">WeaponMenuClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local TreasureConfig = require(ReplicatedStorage.Shared.TreasureConfig)
local WeaponConfig = require(ReplicatedStorage.Shared.WeaponConfig)
local WeaponUpgradeConfig = require(ReplicatedStorage.Shared.WeaponUpgradeConfig)
local TreasureChestPreview = require(script.Parent.TreasureChestPreview)
local GrimoireOpenClient = require(script.Parent.GrimoireOpenClient)
local UiCorner = require(script.Parent.UiCorner)

local WeaponMenuClient = {}

local GOLD = Color3.fromRGB(214, 176, 72)
local GOLD_DIM = Color3.fromRGB(140, 108, 42)
local PANEL = Color3.fromRGB(28, 22, 18)
local PANEL_LIGHT = Color3.fromRGB(48, 38, 32)
local TEXT = Color3.fromRGB(244, 228, 196)
local TEXT_DIM = Color3.fromRGB(170, 154, 128)
local LOCKED = Color3.fromRGB(110, 110, 110)
local ACCENT = Color3.fromRGB(58, 92, 148)
local GRIMOIRE_ACCENT = Color3.fromRGB(120, 72, 180)

type ChestEntry = {
	tierId: string,
	roomDepth: number,
	tierName: string,
}

function WeaponMenuClient.init()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local equipWeaponEvent = ReplicatedStorage:WaitForChild("EquipWeapon") :: RemoteEvent
	local upgradeWeaponEvent = ReplicatedStorage:WaitForChild("UpgradeWeapon") :: RemoteEvent
	local unlockWeaponEvent = ReplicatedStorage:WaitForChild("UnlockWeapon") :: RemoteEvent
	local loadoutUpdatedEvent = ReplicatedStorage:WaitForChild("LoadoutUpdated") :: RemoteEvent
	local profileStateEvent = ReplicatedStorage:WaitForChild("PlayerProfileState") :: RemoteEvent
	local phaseStateEvent = ReplicatedStorage:WaitForChild("PlayerPhaseState") :: RemoteEvent
	local chestStateEvent = ReplicatedStorage:WaitForChild("TreasureChestState") :: RemoteEvent
	local openChestEvent = ReplicatedStorage:WaitForChild("OpenTreasureChest") :: RemoteEvent
	local chestOpenedEvent = ReplicatedStorage:WaitForChild("TreasureChestOpened") :: RemoteEvent
	local grimoireUsedEvent = ReplicatedStorage:WaitForChild("GrimoireUsed") :: RemoteEvent

	local equippedWeapon = WeaponConfig.DEFAULT_WEAPON
	local loadoutLocked = false
	local menuOpen = false
	local activeTab = "Equip"
	local walletGold = LobbyConfig.STARTER_GOLD
	local lobbyChests: { ChestEntry } = {}
	local grimoireCount = 0
	local weaponLevels: { [string]: number } = {}
	local unlockedWeapons: { [string]: boolean } = {
		[LobbyConfig.STARTER_WEAPON] = true,
	}
	local currentPhase = "Lobby"

	for _, weapon in WeaponConfig.getWeaponList() do
		weaponLevels[weapon.id] = 1
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "WeaponMenuUI"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local menuButton = Instance.new("TextButton")
	menuButton.Name = "WeaponsButton"
	menuButton.AnchorPoint = Vector2.new(1, 1)
	menuButton.Size = UDim2.fromOffset(220, 52)
	menuButton.Position = UDim2.new(0.5, -6, 1, -12)
	menuButton.BackgroundColor3 = ACCENT
	menuButton.BorderSizePixel = 0
	menuButton.Font = Enum.Font.GothamBold
	menuButton.Text = "Weapons"
	menuButton.TextColor3 = Color3.new(1, 1, 1)
	menuButton.TextSize = 22
	menuButton.Parent = screenGui

	UiCorner.apply(menuButton, 10)

	local panel = Instance.new("Frame")
	panel.Name = "WeaponPanel"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -70)
	panel.Size = UDim2.fromOffset(360, 360)
	panel.BackgroundColor3 = PANEL
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = screenGui

	UiCorner.apply(panel, 12)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 12)
	title.Size = UDim2.new(1, -32, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.Text = "Blacksmith"
	title.TextColor3 = GOLD
	title.TextSize = 22
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = panel

	local statusLabel = Instance.new("TextLabel")
	statusLabel.BackgroundTransparency = 1
	statusLabel.Position = UDim2.fromOffset(16, 40)
	statusLabel.Size = UDim2.new(1, -32, 0, 36)
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.Text = "Equip and upgrade your weapons in the lobby."
	statusLabel.TextColor3 = TEXT
	statusLabel.TextSize = 14
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.TextWrapped = true
	statusLabel.Parent = panel

	local tabBar = Instance.new("Frame")
	tabBar.BackgroundTransparency = 1
	tabBar.Position = UDim2.fromOffset(16, 78)
	tabBar.Size = UDim2.new(1, -32, 0, 34)
	tabBar.Parent = panel

	local tabLayout = Instance.new("UIListLayout")
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.Padding = UDim.new(0, 8)
	tabLayout.Parent = tabBar

	local equipTab = Instance.new("TextButton")
	equipTab.Size = UDim2.fromOffset(100, 32)
	equipTab.BackgroundColor3 = GOLD_DIM
	equipTab.BorderSizePixel = 0
	equipTab.Font = Enum.Font.GothamBold
	equipTab.Text = "Equip"
	equipTab.TextColor3 = TEXT
	equipTab.TextSize = 15
	equipTab.Parent = tabBar

	local upgradeTab = Instance.new("TextButton")
	upgradeTab.Size = UDim2.fromOffset(100, 32)
	upgradeTab.BackgroundColor3 = PANEL_LIGHT
	upgradeTab.BorderSizePixel = 0
	upgradeTab.Font = Enum.Font.GothamBold
	upgradeTab.Text = "Upgrade"
	upgradeTab.TextColor3 = TEXT
	upgradeTab.TextSize = 15
	upgradeTab.Parent = tabBar

	local chestsTab = Instance.new("TextButton")
	chestsTab.Size = UDim2.fromOffset(100, 32)
	chestsTab.BackgroundColor3 = PANEL_LIGHT
	chestsTab.BorderSizePixel = 0
	chestsTab.Font = Enum.Font.GothamBold
	chestsTab.Text = "Chests"
	chestsTab.TextColor3 = TEXT
	chestsTab.TextSize = 15
	chestsTab.Parent = tabBar

	for _, tab in { equipTab, upgradeTab, chestsTab } do
		UiCorner.apply(tab, 8)
	end

	local list = Instance.new("ScrollingFrame")
	list.Name = "WeaponList"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(16, 120)
	list.Size = UDim2.new(1, -32, 1, -136)
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.ScrollBarThickness = 6
	list.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		list.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 8)
	end)

	local chestList = Instance.new("ScrollingFrame")
	chestList.Name = "ChestList"
	chestList.BackgroundTransparency = 1
	chestList.BorderSizePixel = 0
	chestList.Position = UDim2.fromOffset(16, 120)
	chestList.Size = UDim2.new(1, -32, 1, -136)
	chestList.CanvasSize = UDim2.fromOffset(0, 0)
	chestList.ScrollBarThickness = 6
	chestList.Visible = false
	chestList.Parent = panel

	local chestLayout = Instance.new("UIListLayout")
	chestLayout.Padding = UDim.new(0, 10)
	chestLayout.SortOrder = Enum.SortOrder.LayoutOrder
	chestLayout.Parent = chestList

	chestLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		chestList.CanvasSize = UDim2.fromOffset(0, chestLayout.AbsoluteContentSize.Y + 8)
	end)

	local emptyChestLabel = Instance.new("TextLabel")
	emptyChestLabel.Name = "EmptyChests"
	emptyChestLabel.BackgroundTransparency = 1
	emptyChestLabel.Size = UDim2.new(1, -32, 0, 80)
	emptyChestLabel.Position = UDim2.fromOffset(16, 200)
	emptyChestLabel.Font = Enum.Font.Gotham
	emptyChestLabel.Text = "No chests or grimoires yet.\nClear dungeon rooms for treasure and grimoires."
	emptyChestLabel.TextColor3 = TEXT_DIM
	emptyChestLabel.TextSize = 15
	emptyChestLabel.TextWrapped = true
	emptyChestLabel.Visible = false
	emptyChestLabel.Parent = panel

	local weaponButtons: { [string]: TextButton } = {}

	local function getEffectiveDisplayStats(weaponId: string)
		local level = weaponLevels[weaponId] or 1
		return WeaponUpgradeConfig.getEffectiveStats(weaponId, level)
	end

	local function getChestTabCount(): number
		return #lobbyChests + grimoireCount
	end

	local function renderChestList()
		for _, child in chestList:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end

		local totalEntries = getChestTabCount()
		emptyChestLabel.Visible = activeTab == "Chests" and totalEntries == 0
		chestList.Visible = activeTab == "Chests" and totalEntries > 0

		local layoutOrder = 0

		for index, chest in lobbyChests do
			layoutOrder += 1
			local tier = TreasureConfig.getTier(chest.tierId)
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -4, 0, 96)
			row.BackgroundColor3 = PANEL_LIGHT
			row.BorderSizePixel = 0
			row.LayoutOrder = layoutOrder
			row.Parent = chestList

			UiCorner.apply(row, 8)

			local previewHost = Instance.new("Frame")
			previewHost.BackgroundTransparency = 1
			previewHost.Position = UDim2.fromOffset(8, 8)
			previewHost.Size = UDim2.fromOffset(80, 80)
			previewHost.Parent = row
			TreasureChestPreview.mount(previewHost, chest.tierId, 80)

			local nameLabel = Instance.new("TextLabel")
			nameLabel.BackgroundTransparency = 1
			nameLabel.Position = UDim2.fromOffset(96, 14)
			nameLabel.Size = UDim2.new(1, -220, 0, 24)
			nameLabel.Font = Enum.Font.GothamBold
			nameLabel.Text = chest.tierName
			nameLabel.TextColor3 = TEXT
			nameLabel.TextSize = 17
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.Parent = row

			local depthLabel = Instance.new("TextLabel")
			depthLabel.BackgroundTransparency = 1
			depthLabel.Position = UDim2.fromOffset(96, 40)
			depthLabel.Size = UDim2.new(1, -220, 0, 20)
			depthLabel.Font = Enum.Font.Gotham
			depthLabel.Text = `Depth {chest.roomDepth}`
			depthLabel.TextColor3 = TEXT_DIM
			depthLabel.TextSize = 14
			depthLabel.TextXAlignment = Enum.TextXAlignment.Left
			depthLabel.Parent = row

			local openButton = Instance.new("TextButton")
			openButton.AnchorPoint = Vector2.new(1, 0.5)
			openButton.Position = UDim2.new(1, -8, 0.5, 0)
			openButton.Size = UDim2.fromOffset(96, 40)
			openButton.BackgroundColor3 = tier.trimColor
			openButton.BorderSizePixel = 0
			openButton.Font = Enum.Font.GothamBold
			openButton.Text = "Open"
			openButton.TextColor3 = Color3.new(0.08, 0.06, 0.05)
			openButton.TextSize = 16
			openButton.Parent = row

			UiCorner.apply(openButton, 8)

			openButton.MouseButton1Click:Connect(function()
				if loadoutLocked or currentPhase ~= "Lobby" then
					return
				end
				openChestEvent:FireServer(index)
			end)
		end

		for grimoireIndex = 1, grimoireCount do
			layoutOrder += 1
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -4, 0, 96)
			row.BackgroundColor3 = PANEL_LIGHT
			row.BorderSizePixel = 0
			row.LayoutOrder = layoutOrder
			row.Parent = chestList

			UiCorner.apply(row, 8)

			local previewHost = Instance.new("Frame")
			previewHost.BackgroundTransparency = 1
			previewHost.Position = UDim2.fromOffset(8, 8)
			previewHost.Size = UDim2.fromOffset(80, 80)
			previewHost.Parent = row
			GrimoireOpenClient.mountPreview(previewHost, 80)

			local nameLabel = Instance.new("TextLabel")
			nameLabel.BackgroundTransparency = 1
			nameLabel.Position = UDim2.fromOffset(96, 14)
			nameLabel.Size = UDim2.new(1, -220, 0, 24)
			nameLabel.Font = Enum.Font.GothamBold
			nameLabel.Text = "Grimoire"
			nameLabel.TextColor3 = Color3.fromRGB(220, 180, 255)
			nameLabel.TextSize = 17
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.Parent = row

			local detailLabel = Instance.new("TextLabel")
			detailLabel.BackgroundTransparency = 1
			detailLabel.Position = UDim2.fromOffset(96, 40)
			detailLabel.Size = UDim2.new(1, -220, 0, 36)
			detailLabel.Font = Enum.Font.Gotham
			detailLabel.Text = "Open to learn a random spell."
			detailLabel.TextColor3 = TEXT_DIM
			detailLabel.TextSize = 14
			detailLabel.TextWrapped = true
			detailLabel.TextXAlignment = Enum.TextXAlignment.Left
			detailLabel.Parent = row

			local openButton = Instance.new("TextButton")
			openButton.AnchorPoint = Vector2.new(1, 0.5)
			openButton.Position = UDim2.new(1, -8, 0.5, 0)
			openButton.Size = UDim2.fromOffset(96, 40)
			openButton.BackgroundColor3 = GRIMOIRE_ACCENT
			openButton.BorderSizePixel = 0
			openButton.Font = Enum.Font.GothamBold
			openButton.Text = "Open"
			openButton.TextColor3 = Color3.new(1, 1, 1)
			openButton.TextSize = 16
			openButton.Parent = row

			UiCorner.apply(openButton, 8)

			openButton.MouseButton1Click:Connect(function()
				if loadoutLocked or currentPhase ~= "Lobby" or grimoireCount <= 0 then
					return
				end

				panel.Visible = false
				menuOpen = false
				GrimoireOpenClient.open(function()
					if currentPhase == "Lobby" then
						activeTab = "Chests"
						menuOpen = true
						panel.Visible = true
					end
					updateMenuState()
				end)
			end)
		end
	end

	local function updateWeaponButtons()
		for weaponId, button in weaponButtons do
			local stats = getEffectiveDisplayStats(weaponId)
			local level = weaponLevels[weaponId] or 1
			local unlocked = unlockedWeapons[weaponId] == true
			local selected = weaponId == equippedWeapon

			if activeTab == "Equip" then
				if unlocked then
					button.Text = `{stats.displayName}  Lv {level}\n{stats.damageMin}-{stats.damageMax} dmg  |  {stats.cooldown}s`
					button.BackgroundColor3 = if selected then GOLD_DIM else PANEL_LIGHT
					button.TextColor3 = if loadoutLocked then LOCKED else TEXT
					button.AutoButtonColor = not loadoutLocked
				else
					local cost = WeaponUpgradeConfig.getUnlockCost(weaponId)
					button.Text = `{stats.displayName}  LOCKED\nUnlock for {cost} gold`
					button.BackgroundColor3 = PANEL_LIGHT
					button.TextColor3 = if walletGold >= cost and not loadoutLocked then GOLD else LOCKED
					button.AutoButtonColor = walletGold >= cost and not loadoutLocked
				end
			else
				if unlocked then
					local cost = WeaponUpgradeConfig.getUpgradeCost(weaponId, level)
					if level >= WeaponUpgradeConfig.MAX_LEVEL then
						button.Text = `{stats.displayName}  Lv {level} MAX\n{stats.damageMin}-{stats.damageMax} dmg`
						button.BackgroundColor3 = GOLD_DIM
						button.TextColor3 = TEXT
						button.AutoButtonColor = false
					else
						button.Text = `{stats.displayName}  Lv {level} -> {level + 1}\nUpgrade for {cost} gold`
						button.BackgroundColor3 = PANEL_LIGHT
						button.TextColor3 = if walletGold >= cost and not loadoutLocked then TEXT else LOCKED
						button.AutoButtonColor = walletGold >= cost and not loadoutLocked
					end
				else
					local cost = WeaponUpgradeConfig.getUnlockCost(weaponId)
					button.Text = `{stats.displayName}  LOCKED\nUnlock for {cost} gold`
					button.BackgroundColor3 = PANEL_LIGHT
					button.TextColor3 = if walletGold >= cost and not loadoutLocked then GOLD else LOCKED
					button.AutoButtonColor = walletGold >= cost and not loadoutLocked
				end
			end
		end
	end

	local function updateMenuState()
		local inLobby = currentPhase == "Lobby"
		menuButton.Visible = inLobby or not LobbyConfig.USE_LOBBY
		menuButton.BackgroundColor3 = if loadoutLocked or not inLobby then LOCKED else ACCENT
		menuButton.AutoButtonColor = not loadoutLocked and inLobby

		equipTab.BackgroundColor3 = if activeTab == "Equip" then GOLD_DIM else PANEL_LIGHT
		upgradeTab.BackgroundColor3 = if activeTab == "Upgrade" then GOLD_DIM else PANEL_LIGHT
		chestsTab.BackgroundColor3 = if activeTab == "Chests" then GOLD_DIM else PANEL_LIGHT
		chestsTab.Text = if getChestTabCount() > 0 then `Chests ({getChestTabCount()})` else "Chests"

		list.Visible = activeTab ~= "Chests"
		renderChestList()

		if loadoutLocked or not inLobby then
			statusLabel.Text = "Loadout locked during a dungeon run."
		elseif activeTab == "Equip" then
			statusLabel.Text = `Equipped: {WeaponConfig.getWeapon(equippedWeapon).displayName}  |  Gold: {walletGold}`
		elseif activeTab == "Upgrade" then
			statusLabel.Text = `Spend gold to upgrade weapons. Wallet: {walletGold}`
		elseif activeTab == "Chests" then
			if getChestTabCount() > 0 then
				statusLabel.Text =
					`{#lobbyChests} chest(s), {grimoireCount} grimoire(s). Open them here to claim rewards.`
			else
				statusLabel.Text = "Find chests and grimoires in the dungeon, then open them here."
			end
		else
			statusLabel.Text = "Find chests in the dungeon, then open them here."
		end

		updateWeaponButtons()
	end

	for index, stats in WeaponConfig.getWeaponList() do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -4, 0, 78)
		button.BackgroundColor3 = PANEL_LIGHT
		button.BorderSizePixel = 0
		button.Font = Enum.Font.GothamBold
		button.TextSize = 15
		button.TextWrapped = true
		button.LayoutOrder = index
		button.Parent = list

		UiCorner.apply(button, 8)

		button.MouseButton1Click:Connect(function()
			if loadoutLocked or currentPhase ~= "Lobby" then
				return
			end

			local unlocked = unlockedWeapons[stats.id] == true
			if activeTab == "Equip" then
				if unlocked then
					equipWeaponEvent:FireServer(stats.id)
				else
					unlockWeaponEvent:FireServer(stats.id)
				end
			else
				if unlocked then
					upgradeWeaponEvent:FireServer(stats.id)
				else
					unlockWeaponEvent:FireServer(stats.id)
				end
			end
		end)

		weaponButtons[stats.id] = button
	end

	equipTab.MouseButton1Click:Connect(function()
		activeTab = "Equip"
		updateMenuState()
	end)

	upgradeTab.MouseButton1Click:Connect(function()
		activeTab = "Upgrade"
		updateMenuState()
	end)

	chestsTab.MouseButton1Click:Connect(function()
		activeTab = "Chests"
		updateMenuState()
	end)

	menuButton.MouseButton1Click:Connect(function()
		if loadoutLocked or currentPhase ~= "Lobby" then
			menuOpen = false
			panel.Visible = false
			return
		end

		menuOpen = not menuOpen
		panel.Visible = menuOpen
	end)

	loadoutUpdatedEvent.OnClientEvent:Connect(function(weaponId: string, locked: boolean)
		equippedWeapon = weaponId
		loadoutLocked = locked
		if locked then
			menuOpen = false
			panel.Visible = false
		end
		updateMenuState()
	end)

	profileStateEvent.OnClientEvent:Connect(function(snapshot)
		if typeof(snapshot) ~= "table" then
			return
		end

		if typeof(snapshot.gold) == "number" then
			walletGold = snapshot.gold
		end
		if typeof(snapshot.equippedWeapon) == "string" then
			equippedWeapon = snapshot.equippedWeapon
		end
		if typeof(snapshot.weaponLevels) == "table" then
			for weaponId, level in snapshot.weaponLevels do
				if typeof(level) == "number" then
					weaponLevels[weaponId] = level
				end
			end
		end
		if typeof(snapshot.unlockedWeapons) == "table" then
			for weaponId, unlocked in snapshot.unlockedWeapons do
				if typeof(unlocked) == "boolean" then
					unlockedWeapons[weaponId] = unlocked
				end
			end
		end
		if typeof(snapshot.grimoireCount) == "number" then
			grimoireCount = snapshot.grimoireCount
		end

		updateMenuState()
	end)

	phaseStateEvent.OnClientEvent:Connect(function(phase: string)
		if phase == "Lobby" or phase == "Dungeon" then
			currentPhase = phase
			if phase == "Dungeon" then
				menuOpen = false
				panel.Visible = false
			elseif #lobbyChests > 0 or grimoireCount > 0 then
				activeTab = "Chests"
				menuOpen = true
				panel.Visible = true
			end
			updateMenuState()
		end
	end)

	chestStateEvent.OnClientEvent:Connect(function(payload)
		lobbyChests = {}
		if typeof(payload) == "table" then
			for _, entry in payload do
				if typeof(entry) == "table" and typeof(entry.tierId) == "string" then
					table.insert(lobbyChests, {
						tierId = entry.tierId,
						roomDepth = if typeof(entry.roomDepth) == "number" then entry.roomDepth else 1,
						tierName = if typeof(entry.tierName) == "string"
							then entry.tierName
							else TreasureConfig.getTier(entry.tierId).displayName,
					})
				end
			end
		end

		if currentPhase == "Lobby" and getChestTabCount() > 0 then
			activeTab = "Chests"
			menuOpen = true
			panel.Visible = true
		end
		updateMenuState()
	end)

	chestOpenedEvent.OnClientEvent:Connect(function(loot)
		if typeof(loot) == "table" and typeof(loot.gold) == "number" then
			local tierName = if typeof(loot.tierName) == "string" then loot.tierName else "Chest"
			local message = `{tierName} opened for {loot.gold} gold!`
			if loot.grimoireDropped == true then
				message ..= " You found a grimoire!"
			end
			statusLabel.Text = message
		end
		if typeof(loot) == "table" and typeof(loot.grimoireCount) == "number" then
			grimoireCount = loot.grimoireCount
		end
		updateMenuState()
	end)

	grimoireUsedEvent.OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end

		if typeof(payload.grimoireCount) == "number" then
			grimoireCount = payload.grimoireCount
		end
		if typeof(payload.message) == "string" then
			statusLabel.Text = payload.message
		end
		updateMenuState()
	end)

	WeaponMenuClient._openToTab = function(tab: string)
		if loadoutLocked or currentPhase ~= "Lobby" then
			return
		end

		if tab == "Equip" or tab == "Upgrade" or tab == "Chests" then
			activeTab = tab
		end

		menuOpen = true
		panel.Visible = true
		updateMenuState()
	end

	updateMenuState()
end

function WeaponMenuClient.openToTab(tab: string)
	if WeaponMenuClient._openToTab then
		WeaponMenuClient._openToTab(tab)
	end
end

return WeaponMenuClient
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
