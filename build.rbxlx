      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">AnimationOverrideService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")

local AnimationOverrideService = {}

local function clearAnimationPacks(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local description = humanoid:GetAppliedDescription()
	description.IdleAnimation = 0
	description.WalkAnimation = 0
	description.RunAnimation = 0
	description.JumpAnimation = 0
	description.FallAnimation = 0
	description.ClimbAnimation = 0
	description.SwimAnimation = 0

	local ok, err = pcall(function()
		humanoid:ApplyDescription(description)
	end)

	if not ok then
		warn(`Failed to clear animation packs: {err}`)
	end
end

function AnimationOverrideService.init()
	local function onCharacter(character: Model)
		task.defer(clearAnimationPacks, character)
	end

	for _, player in Players:GetPlayers() do
		player.CharacterAppearanceLoaded:Connect(onCharacter)
		if player.Character then
			onCharacter(player.Character)
		end
	end

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAppearanceLoaded:Connect(onCharacter)
	end)
end

return AnimationOverrideService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">BossService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BossConfig = require(ReplicatedStorage.Shared.BossConfig)
local DungeonConfig = require(ReplicatedStorage.Shared.DungeonConfig)

local BossService = {}

type BossAttackState = {
	attackId: string,
	phase: "windup" | "active" | "recover",
	startTime: number,
	startCFrame: CFrame?,
	targetPosition: Vector3?,
}

type BossRuntime = {
	lastAttackTime: number,
	busy: boolean,
	state: BossAttackState?,
}

local bossRuntimes: { [Model]: BossRuntime } = {}
local attackingBosses: { [Model]: boolean } = {}
BossService.onPlayerDamagedCallback = nil

local function weld(part0: BasePart, part1: BasePart)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = part0
	constraint.Part1 = part1
	constraint.Parent = part0
end

local function attachMotor(part0: BasePart, part1: BasePart, name: string, restOffset: CFrame): Motor6D
	local motor = Instance.new("Motor6D")
	motor.Name = name
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = restOffset
	motor.C1 = CFrame.new()
	motor.Parent = part0
	return motor
end

local function createPart(
	name: string,
	size: Vector3,
	color: Color3,
	parent: Instance,
	options: {
		material: Enum.Material?,
		canCollide: boolean?,
		massless: boolean?,
		shape: Enum.PartType?,
		transparency: number?,
	}?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = if options and options.material then options.material else Enum.Material.SmoothPlastic
	part.CanCollide = if options and options.canCollide ~= nil then options.canCollide else false
	part.Massless = if options and options.massless ~= nil then options.massless else false
	part.Transparency = if options and options.transparency then options.transparency else 0
	if options and options.shape then
		part.Shape = options.shape
	end
	part.Anchored = false
	part.Parent = parent
	return part
end

local function getMotor(root: BasePart, monster: Model, attributeName: string): Motor6D?
	return root:FindFirstChild(monster:GetAttribute(attributeName) :: string) :: Motor6D?
end

local function spawnTelegraph(position: Vector3, radius: number, color: Color3, duration: number)
	local ring = Instance.new("Part")
	ring.Name = "BossTelegraph"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.45
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.35, radius * 2, radius * 2)
	ring.CFrame = CFrame.new(position.X, position.Y + 0.12, position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace

	task.delay(duration, function()
		if ring.Parent then
			ring:Destroy()
		end
	end)
end

local function damagePlayersInRadius(origin: Vector3, radius: number, damage: number, ownerUserId: number?)
	local Players = game:GetService("Players")
	for _, player in Players:GetPlayers() do
		if ownerUserId and player.UserId ~= ownerUserId then
			continue
		end

		local character = player.Character
		local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoidRootPart and humanoid and humanoid.Health > 0 then
			local distance = (humanoidRootPart.Position - origin).Magnitude
			if distance <= radius then
				humanoid:TakeDamage(damage)
				if BossService.onPlayerDamagedCallback then
					BossService.onPlayerDamagedCallback(player)
				end
			end
		end
	end
end

local function pickAttack(monster: Model, target: Model): string?
	local root = monster.PrimaryPart
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not targetRoot then
		return nil
	end

	local distance = (root.Position - targetRoot.Position).Magnitude
	local candidates: { { id: string, weight: number } } = {}

	for _, attack in BossConfig.ATTACKS do
		if distance >= attack.minRange and distance <= attack.maxRange then
			table.insert(candidates, { id = attack.id, weight = attack.weight })
		end
	end

	if #candidates == 0 then
		return "GroundSlam"
	end

	local totalWeight = 0
	for _, entry in candidates do
		totalWeight += entry.weight
	end

	local roll = math.random() * totalWeight
	local cumulative = 0
	for _, entry in candidates do
		cumulative += entry.weight
		if roll <= cumulative then
			return entry.id
		end
	end

	return candidates[1].id
end

local function finishAttack(monster: Model)
	attackingBosses[monster] = nil
	local runtime = bossRuntimes[monster]
	if runtime then
		runtime.busy = false
		runtime.state = nil
	end
end

local function executeGroundSlam(monster: Model, target: Model, attackConfig: typeof(BossConfig.ATTACKS.GroundSlam))
	local root = monster.PrimaryPart
	if not root then
		finishAttack(monster)
		return
	end

	local ownerUserId = monster:GetAttribute("DungeonOwner")
	spawnTelegraph(root.Position, attackConfig.radius, Color3.fromRGB(255, 72, 48), attackConfig.windup)

	task.delay(attackConfig.windup, function()
		if not monster.Parent or not root.Parent then
			finishAttack(monster)
			return
		end

		spawnTelegraph(root.Position, attackConfig.radius, Color3.fromRGB(255, 120, 48), 0.25)
		damagePlayersInRadius(
			root.Position,
			attackConfig.radius,
			attackConfig.damage,
			if typeof(ownerUserId) == "number" then ownerUserId else nil
		)
		task.delay(0.35, function()
			finishAttack(monster)
		end)
	end)
end

local function executeSavageCharge(monster: Model, target: Model, attackConfig: typeof(BossConfig.ATTACKS.SavageCharge))
	local root = monster.PrimaryPart
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not targetRoot then
		finishAttack(monster)
		return
	end

	local ownerUserId = monster:GetAttribute("DungeonOwner")
	local startCFrame = root.CFrame
	local direction = (targetRoot.Position - root.Position).Unit
	local chargeTarget = startCFrame.Position + direction * attackConfig.chargeDistance
	local lookTarget = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)

	spawnTelegraph(root.Position, 4, Color3.fromRGB(255, 180, 48), attackConfig.windup)

	task.delay(attackConfig.windup, function()
		if not monster.Parent or not root.Parent then
			finishAttack(monster)
			return
		end

		local steps = 10
		for step = 1, steps do
			if not monster.Parent then
				break
			end
			local alpha = step / steps
			local nextPos = startCFrame.Position:Lerp(chargeTarget, alpha)
			root.CFrame = CFrame.lookAt(nextPos, lookTarget)
			damagePlayersInRadius(
				root.Position,
				5.5,
				attackConfig.damage,
				if typeof(ownerUserId) == "number" then ownerUserId else nil
			)
			task.wait(0.04)
		end

		task.delay(0.25, function()
			finishAttack(monster)
		end)
	end)
end

local function executeDarkHowl(monster: Model, attackConfig: typeof(BossConfig.ATTACKS.DarkHowl))
	local root = monster.PrimaryPart
	local body = monster:FindFirstChild("Body") :: BasePart?
	if not root or not body then
		finishAttack(monster)
		return
	end

	local ownerUserId = monster:GetAttribute("DungeonOwner")
	local neckMotor = getMotor(body, monster, "NeckMotorName")
	local tailMotor = getMotor(root, monster, "TailMotorName")
	local neckRest = monster:GetAttribute("NeckRest") :: CFrame?
	local tailRest = monster:GetAttribute("TailRest") :: CFrame?

	spawnTelegraph(root.Position, attackConfig.radius, Color3.fromRGB(140, 48, 255), attackConfig.windup * 0.7)

	task.spawn(function()
		for step = 1, 6 do
			if not monster.Parent or not neckMotor or not tailMotor or not neckRest or not tailRest then
				break
			end
			local alpha = step / 6
			neckMotor.C0 = neckRest * CFrame.Angles(math.rad(-28 * alpha), 0, 0)
			tailMotor.C0 = tailRest * CFrame.Angles(math.rad(18 * alpha), math.rad(12 * alpha), 0)
			task.wait(attackConfig.windup / 6)
		end

		if monster.Parent and root.Parent then
			spawnTelegraph(root.Position, attackConfig.radius, Color3.fromRGB(180, 72, 255), 0.35)
			damagePlayersInRadius(
				root.Position,
				attackConfig.radius,
				attackConfig.damage,
				if typeof(ownerUserId) == "number" then ownerUserId else nil
			)
		end

		if neckMotor and tailMotor and neckRest and tailRest then
			for step = 1, 4 do
				if not monster.Parent then
					break
				end
				local alpha = step / 4
				neckMotor.C0 = (neckRest * CFrame.Angles(math.rad(-28), 0, 0)):Lerp(neckRest, alpha)
				tailMotor.C0 = (tailRest * CFrame.Angles(math.rad(18), math.rad(12), 0)):Lerp(tailRest, alpha)
				task.wait(0.05)
			end
		end

		finishAttack(monster)
	end)
end

local function startBossAttack(monster: Model, target: Model, attackId: string)
	local attackConfig = BossConfig.ATTACKS[attackId]
	if not attackConfig then
		return false
	end

	attackingBosses[monster] = true
	local runtime = bossRuntimes[monster]
	if runtime then
		runtime.busy = true
		runtime.lastAttackTime = os.clock()
	end

	if attackId == "GroundSlam" then
		executeGroundSlam(monster, target, attackConfig)
	elseif attackId == "SavageCharge" then
		executeSavageCharge(monster, target, attackConfig)
	elseif attackId == "DarkHowl" then
		executeDarkHowl(monster, attackConfig)
	else
		finishAttack(monster)
		return false
	end

	return true
end

function BossService.isBoss(monster: Model): boolean
	return monster:GetAttribute("IsBoss") == true
end

function BossService.isBusy(monster: Model): boolean
	return attackingBosses[monster] == true
end

function BossService.cleanup(monster: Model)
	bossRuntimes[monster] = nil
	attackingBosses[monster] = nil
end

function BossService.updateBoss(monster: Model, target: Model)
	if BossService.isBusy(monster) then
		return
	end

	local runtime = bossRuntimes[monster]
	if not runtime then
		return
	end

	local now = os.clock()
	if now - runtime.lastAttackTime < BossConfig.ATTACK_COOLDOWN then
		return
	end

	local root = monster.PrimaryPart
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not targetRoot then
		return
	end

	local distance = (root.Position - targetRoot.Position).Magnitude
	if distance > BossConfig.ATTACK_RANGE + 8 then
		return
	end

	local attackId = pickAttack(monster, target)
	if attackId then
		startBossAttack(monster, target, attackId)
	end
end

local function snapBossToGround(position: Vector3, hipHeight: number, ignore: { Instance }): Vector3
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignore

	local result = workspace:Raycast(position + Vector3.new(0, 40, 0), Vector3.new(0, -120, 0), rayParams)
	if result then
		return Vector3.new(position.X, result.Position.Y + hipHeight, position.Z)
	end

	return position
end

function BossService.createBoss(
	spawnPosition: Vector3,
	roomDepth: number,
	ownerUserId: number,
	monstersFolder: Folder,
	configureStableHumanoid: (Humanoid) -> ()
): Model
	local scale = BossConfig.SCALE
	local bossDepthIndex = BossConfig.getBossDepthIndex(roomDepth, DungeonConfig.BOSS_EVERY_N_ROOMS)
	local maxHealth = BossConfig.getHealthForDepth(bossDepthIndex)

	local function s(vector: Vector3): Vector3
		return vector * scale
	end

	local function sOffset(offset: CFrame): CFrame
		return CFrame.new(s(offset.Position)) * (offset - offset.Position)
	end

	local fur = Color3.fromRGB(42, 38, 48)
	local darkFur = Color3.fromRGB(22, 18, 28)
	local glow = Color3.fromRGB(255, 64, 72)

	local model = Instance.new("Model")
	model.Name = "WaveMonster"

	local humanoidRootPart = createPart("HumanoidRootPart", s(Vector3.new(1.1, 0.65, 1.45)), fur, model, {
		canCollide = false,
		massless = true,
	})
	humanoidRootPart.Transparency = 1

	local body = createPart("Body", s(Vector3.new(1.12, 0.78, 2.05)), fur, model)
	local chest = createPart("Chest", s(Vector3.new(0.95, 0.72, 0.82)), darkFur, model)
	local head = createPart("Head", s(Vector3.new(0.68, 0.62, 0.78)), fur, model)
	local snout = createPart("Snout", s(Vector3.new(0.42, 0.36, 0.72)), darkFur, model, { massless = true })
	local leftHorn = createPart("LeftHorn", s(Vector3.new(0.16, 0.52, 0.16)), Color3.fromRGB(92, 88, 96), model, { massless = true })
	local rightHorn = createPart("RightHorn", s(Vector3.new(0.16, 0.52, 0.16)), Color3.fromRGB(92, 88, 96), model, { massless = true })
	local leftEye = createPart("LeftEye", s(Vector3.new(0.14, 0.14, 0.08)), glow, model, {
		massless = true,
		material = Enum.Material.Neon,
	})
	local rightEye = createPart("RightEye", s(Vector3.new(0.14, 0.14, 0.08)), glow, model, {
		massless = true,
		material = Enum.Material.Neon,
	})
	local biteHitbox = createPart("BiteHitbox", s(Vector3.new(0.55, 0.42, 0.65)), fur, model, {
		massless = true,
		transparency = 1,
	})
	local tail = createPart("Tail", s(Vector3.new(0.22, 0.22, 0.82)), darkFur, model, { massless = true })

	local frontLeftLeg = createPart("FrontLeftLeg", s(Vector3.new(0.28, 0.88, 0.28)), darkFur, model, { canCollide = true })
	local frontRightLeg = createPart("FrontRightLeg", s(Vector3.new(0.28, 0.88, 0.28)), darkFur, model, { canCollide = true })
	local backLeftLeg = createPart("BackLeftLeg", s(Vector3.new(0.28, 0.92, 0.3)), darkFur, model, { canCollide = true })
	local backRightLeg = createPart("BackRightLeg", s(Vector3.new(0.28, 0.92, 0.3)), darkFur, model, { canCollide = true })
	local frontLeftPaw = createPart("FrontLeftPaw", s(Vector3.new(0.32, 0.12, 0.36)), darkFur, model, { massless = true, canCollide = true })
	local frontRightPaw = createPart("FrontRightPaw", s(Vector3.new(0.32, 0.12, 0.36)), darkFur, model, { massless = true, canCollide = true })
	local backLeftPaw = createPart("BackLeftPaw", s(Vector3.new(0.34, 0.12, 0.38)), darkFur, model, { massless = true, canCollide = true })
	local backRightPaw = createPart("BackRightPaw", s(Vector3.new(0.34, 0.12, 0.38)), darkFur, model, { massless = true, canCollide = true })

	local rootCFrame = CFrame.new(snapBossToGround(spawnPosition, BossConfig.getHipHeight(scale), { monstersFolder }))
	humanoidRootPart.CFrame = rootCFrame
	body.CFrame = rootCFrame
	chest.CFrame = rootCFrame * sOffset(CFrame.new(0, 0.08, -0.72))
	head.CFrame = rootCFrame * sOffset(CFrame.new(0, 0.34, -1.02))
	snout.CFrame = rootCFrame * sOffset(CFrame.new(0, 0.18, -1.42))
	leftHorn.CFrame = head.CFrame * sOffset(CFrame.new(-0.18, 0.42, -0.12)) * CFrame.Angles(0, 0, math.rad(24))
	rightHorn.CFrame = head.CFrame * sOffset(CFrame.new(0.18, 0.42, -0.12)) * CFrame.Angles(0, 0, math.rad(-24))
	leftEye.CFrame = rootCFrame * sOffset(CFrame.new(-0.18, 0.36, -1.28))
	rightEye.CFrame = rootCFrame * sOffset(CFrame.new(0.18, 0.36, -1.28))
	biteHitbox.CFrame = snout.CFrame * sOffset(CFrame.new(0, -0.02, -0.18))
	tail.CFrame = rootCFrame * sOffset(CFrame.new(0, 0.08, 1.02) * CFrame.Angles(math.rad(28), 0, 0))
	frontLeftLeg.CFrame = rootCFrame * sOffset(CFrame.new(-0.38, -0.42, -0.68))
	frontRightLeg.CFrame = rootCFrame * sOffset(CFrame.new(0.38, -0.42, -0.68))
	backLeftLeg.CFrame = rootCFrame * sOffset(CFrame.new(-0.34, -0.42, 0.72))
	backRightLeg.CFrame = rootCFrame * sOffset(CFrame.new(0.34, -0.42, 0.72))
	frontLeftPaw.CFrame = frontLeftLeg.CFrame * sOffset(CFrame.new(0, -0.48, -0.04))
	frontRightPaw.CFrame = frontRightLeg.CFrame * sOffset(CFrame.new(0, -0.48, -0.04))
	backLeftPaw.CFrame = backLeftLeg.CFrame * sOffset(CFrame.new(0, -0.5, 0.02))
	backRightPaw.CFrame = backRightLeg.CFrame * sOffset(CFrame.new(0, -0.5, 0.02))

	weld(humanoidRootPart, body)
	weld(body, chest)
	weld(head, snout)
	weld(snout, biteHitbox)
	weld(head, leftHorn)
	weld(head, rightHorn)
	weld(head, leftEye)
	weld(head, rightEye)
	weld(body, tail)

	local neckRest = sOffset(CFrame.new(0, 0.28, -0.92) * CFrame.Angles(math.rad(-12), 0, 0))
	local tailRest = sOffset(CFrame.new(0, 0.08, 1.02) * CFrame.Angles(math.rad(28), 0, 0))
	local frontLeftLegRest = sOffset(CFrame.new(-0.38, -0.42, -0.68))
	local frontRightLegRest = sOffset(CFrame.new(0.38, -0.42, -0.68))
	local backLeftLegRest = sOffset(CFrame.new(-0.34, -0.42, 0.72))
	local backRightLegRest = sOffset(CFrame.new(0.34, -0.42, 0.72))

	weld(frontLeftLeg, frontLeftPaw)
	weld(frontRightLeg, frontRightPaw)
	weld(backLeftLeg, backLeftPaw)
	weld(backRightLeg, backRightPaw)

	local neckMotor = attachMotor(body, head, "NeckMotor", neckRest)
	local tailMotor = attachMotor(body, tail, "TailMotor", tailRest)
	local frontLeftLegMotor = attachMotor(humanoidRootPart, frontLeftLeg, "FrontLeftLegMotor", frontLeftLegRest)
	local frontRightLegMotor = attachMotor(humanoidRootPart, frontRightLeg, "FrontRightLegMotor", frontRightLegRest)
	local backLeftLegMotor = attachMotor(humanoidRootPart, backLeftLeg, "BackLeftLegMotor", backLeftLegRest)
	local backRightLegMotor = attachMotor(humanoidRootPart, backRightLeg, "BackRightLegMotor", backRightLegRest)

	local humanoid = Instance.new("Humanoid")
	humanoid.WalkSpeed = BossConfig.WALK_SPEED
	humanoid.HipHeight = BossConfig.getHipHeight(scale)
	humanoid.MaxHealth = maxHealth
	humanoid.Health = maxHealth
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	configureStableHumanoid(humanoid)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HealthBar"
	billboard.Size = UDim2.fromOffset(110, 16)
	billboard.StudsOffset = Vector3.new(0, 2.1 * scale, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = true
	billboard.Parent = head

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 10)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 10
	title.TextColor3 = Color3.fromRGB(255, 92, 92)
	title.Text = BossConfig.DISPLAY_NAME
	title.Parent = billboard

	local background = Instance.new("Frame")
	background.Name = "Background"
	background.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	background.BorderSizePixel = 0
	background.Position = UDim2.fromOffset(0, 12)
	background.Size = UDim2.new(1, 0, 0, 8)
	background.Parent = billboard

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = background

	local function updateHealthBar()
		local ratio = if humanoid.MaxHealth > 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
		fill.Size = UDim2.new(ratio, 0, 1, 0)
	end

	humanoid.HealthChanged:Connect(updateHealthBar)
	updateHealthBar()

	model:SetAttribute("IsBoss", true)
	model:SetAttribute("MonsterType", BossConfig.ID)
	model:SetAttribute("MonsterDamage", BossConfig.DAMAGE)
	model:SetAttribute("AttackRange", BossConfig.ATTACK_RANGE)
	model:SetAttribute("AttackCooldown", BossConfig.ATTACK_COOLDOWN)
	model:SetAttribute("DungeonOwner", ownerUserId)
	model:SetAttribute("NeckMotorName", neckMotor.Name)
	model:SetAttribute("TailMotorName", tailMotor.Name)
	model:SetAttribute("FrontLeftLegMotorName", frontLeftLegMotor.Name)
	model:SetAttribute("FrontRightLegMotorName", frontRightLegMotor.Name)
	model:SetAttribute("BackLeftLegMotorName", backLeftLegMotor.Name)
	model:SetAttribute("BackRightLegMotorName", backRightLegMotor.Name)
	model:SetAttribute("NeckRest", neckRest)
	model:SetAttribute("TailRest", tailRest)
	model:SetAttribute("FrontLeftLegRest", frontLeftLegRest)
	model:SetAttribute("FrontRightLegRest", frontRightLegRest)
	model:SetAttribute("BackLeftLegRest", backLeftLegRest)
	model:SetAttribute("BackRightLegRest", backRightLegRest)
	model:SetAttribute("BossScale", scale)
	model:SetAttribute("MonsterScale", scale)

	model.PrimaryPart = humanoidRootPart
	model:PivotTo(rootCFrame)
	model.Parent = monstersFolder

	bossRuntimes[model] = {
		lastAttackTime = 0,
		busy = false,
		state = nil,
	}

	return model
end

function BossService.setOnPlayerDamagedCallback(callback: ((Player) -> ())?)
	BossService.onPlayerDamagedCallback = callback
end

return BossService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">CardService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardConfig = require(ReplicatedStorage.Shared.CardConfig)

local CardService = {}

export type CardModifiers = {
	damageMult: number,
	cooldownMult: number,
	maxHealthBonus: number,
	healOnRoomClear: number,
	lifestealPercent: number,
}

local activeCards: { [Player]: { string } } = {}
local baseMaxHealth: { [Player]: number } = {}

local function getDefaultModifiers(): CardModifiers
	return {
		damageMult = 1,
		cooldownMult = 1,
		maxHealthBonus = 0,
		healOnRoomClear = 0,
		lifestealPercent = 0,
	}
end

function CardService.getModifiers(player: Player): CardModifiers
	local modifiers = getDefaultModifiers()

	for _, cardId in activeCards[player] or {} do
		local card = CardConfig.getCard(cardId)
		if card then
			local effects = card.effects
			if effects.damageMult then
				modifiers.damageMult *= effects.damageMult
			end
			if effects.cooldownMult then
				modifiers.cooldownMult *= effects.cooldownMult
			end
			if effects.maxHealthBonus then
				modifiers.maxHealthBonus += effects.maxHealthBonus
			end
			if effects.healOnRoomClear then
				modifiers.healOnRoomClear += effects.healOnRoomClear
			end
			if effects.lifestealPercent then
				modifiers.lifestealPercent += effects.lifestealPercent
			end
		end
	end

	return modifiers
end

function CardService.getActiveCardIds(player: Player): { string }
	return table.clone(activeCards[player] or {})
end

function CardService.rollDraftOptions(_player: Player, count: number): { string }
	local pool = CardConfig.getAllIds()
	local options: { string } = {}

	while #options < count and #pool > 0 do
		local index = math.random(1, #pool)
		table.insert(options, pool[index])
		table.remove(pool, index)
	end

	return options
end

local function applyHealthBonus(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if not baseMaxHealth[player] then
		baseMaxHealth[player] = humanoid.MaxHealth
	end

	local modifiers = CardService.getModifiers(player)
	local targetMax = math.max(20, baseMaxHealth[player] + modifiers.maxHealthBonus)
	local healthRatio = if humanoid.MaxHealth > 0 then humanoid.Health / humanoid.MaxHealth else 1

	humanoid.MaxHealth = targetMax
	humanoid.Health = math.min(targetMax, targetMax * healthRatio)
end

function CardService.applyCard(player: Player, cardId: string): boolean
	local card = CardConfig.getCard(cardId)
	if not card then
		return false
	end

	if not activeCards[player] then
		activeCards[player] = {}
	end

	table.insert(activeCards[player], cardId)
	applyHealthBonus(player)
	return true
end

function CardService.healOnRoomClear(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local healAmount = CardService.getModifiers(player).healOnRoomClear
	if healAmount > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + healAmount)
	end
end

function CardService.applyLifesteal(player: Player, damageDealt: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or damageDealt <= 0 then
		return
	end

	local percent = CardService.getModifiers(player).lifestealPercent
	if percent <= 0 then
		return
	end

	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + damageDealt * percent)
end

function CardService.resetRun(player: Player)
	activeCards[player] = nil
	baseMaxHealth[player] = nil
end

function CardService.bindCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	baseMaxHealth[player] = humanoid.MaxHealth
	applyHealthBonus(player)
end

function CardService.init()
	Players.PlayerRemoving:Connect(function(player)
		activeCards[player] = nil
		baseMaxHealth[player] = nil
	end)
end

return CardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">DashService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MovementConfig = require(ReplicatedStorage.Shared.MovementConfig)
local StaminaConfig = require(ReplicatedStorage.Shared.StaminaConfig)

local StaminaService = require(script.Parent.StaminaService)

local DashService = {}

local dashEvent: RemoteEvent
local lastDashTimes: { [Player]: number } = {}
local activeDashes: { [Player]: boolean } = {}

local function smoothstep(alpha: number): number
	alpha = math.clamp(alpha, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

local function flattenDirection(direction: Vector3): Vector3
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.05 then
		return Vector3.zero
	end
	return flat.Unit
end

local function applyDash(player: Player, direction: Vector3)
	local character = player.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end

	local dashDirection = flattenDirection(direction)
	if dashDirection == Vector3.zero then
		dashDirection = flattenDirection(root.CFrame.LookVector)
	end
	if dashDirection == Vector3.zero then
		return
	end

	activeDashes[player] = true

	local attachment = root:FindFirstChild("RootRigAttachment") or root:FindFirstChild("RootAttachment") :: Attachment?
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "DashAttachment"
		attachment.Parent = root
	end

	local linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Name = "DashVelocity"
	linearVelocity.Attachment0 = attachment
	linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVelocity.MaxForce = MovementConfig.DASH_MAX_FORCE
	linearVelocity.VectorVelocity = dashDirection * MovementConfig.DASH_SPEED
	linearVelocity.Parent = root

	local startTime = os.clock()
	local dashConnection: RBXScriptConnection

	dashConnection = RunService.Heartbeat:Connect(function()
		if not root.Parent or not linearVelocity.Parent then
			if dashConnection then
				dashConnection:Disconnect()
			end
			activeDashes[player] = nil
			return
		end

		local elapsed = os.clock() - startTime
		if elapsed >= MovementConfig.DASH_DURATION then
			dashConnection:Disconnect()
			linearVelocity:Destroy()
			activeDashes[player] = nil
			return
		end

		local progress = elapsed / MovementConfig.DASH_DURATION
		local ease = 1 - smoothstep(progress)
		linearVelocity.VectorVelocity = dashDirection * MovementConfig.DASH_SPEED * ease
	end)
end

local function onDashRequested(player: Player, direction: Vector3)
	if typeof(direction) ~= "Vector3" or activeDashes[player] then
		return
	end

	local now = os.clock()
	local lastDash = lastDashTimes[player] or 0
	if now - lastDash < MovementConfig.DASH_COOLDOWN then
		return
	end

	if not StaminaService.trySpend(player, StaminaConfig.DASH_COST) then
		return
	end

	lastDashTimes[player] = now
	applyDash(player, direction)
end

function DashService.init()
	dashEvent = Instance.new("RemoteEvent")
	dashEvent.Name = "Dash"
	dashEvent.Parent = ReplicatedStorage

	dashEvent.OnServerEvent:Connect(onDashRequested)

	Players.PlayerRemoving:Connect(function(player)
		lastDashTimes[player] = nil
		activeDashes[player] = nil
	end)
end

return DashService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">DungeonRunService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CardService = require(script.Parent.CardService)
local DungeonConfig = require(ReplicatedStorage.Shared.DungeonConfig)
local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local TreasureChestService = require(script.Parent.TreasureChestService)
local TreasureConfig = require(ReplicatedStorage.Shared.TreasureConfig)
local WaveService = require(script.Parent.WaveService)

local DungeonRunService = {}

export type RunStatus = "starting" | "fighting" | "card_draft" | "intermission" | "ended"

export type RunState = {
	room: number,
	gold: number,
	status: RunStatus,
	monstersRemaining: number,
	isBossRoom: boolean,
	activeCards: { string },
	runChestCount: number,
}

local CardServiceModule = CardService
local cardDraftPickEvent: RemoteEvent
local dungeonRunStateEvent: RemoteEvent

local playerRuns: { [Player]: RunState } = {}
local pendingDraftOptions: { [Player]: { string } } = {}
local runTokens: { [Player]: number } = {}
local runEndedHandler: ((Player, number) -> ())? = nil

local function getCardDraftPickEvent(): RemoteEvent
	if cardDraftPickEvent then
		return cardDraftPickEvent
	end

	cardDraftPickEvent = ReplicatedStorage:FindFirstChild("CardDraftPick") :: RemoteEvent?
	if not cardDraftPickEvent then
		cardDraftPickEvent = Instance.new("RemoteEvent")
		cardDraftPickEvent.Name = "CardDraftPick"
		cardDraftPickEvent.Parent = ReplicatedStorage
	end

	return cardDraftPickEvent
end

local function getDungeonRunStateEvent(): RemoteEvent
	if dungeonRunStateEvent then
		return dungeonRunStateEvent
	end

	dungeonRunStateEvent = ReplicatedStorage:FindFirstChild("DungeonRunState") :: RemoteEvent?
	if not dungeonRunStateEvent then
		dungeonRunStateEvent = Instance.new("RemoteEvent")
		dungeonRunStateEvent.Name = "DungeonRunState"
		dungeonRunStateEvent.Parent = ReplicatedStorage
	end

	return dungeonRunStateEvent
end

local function getRun(player: Player): RunState?
	return playerRuns[player]
end

local function buildSnapshot(player: Player): RunState?
	local run = getRun(player)
	if not run then
		return nil
	end

	return {
		room = run.room,
		gold = run.gold,
		status = run.status,
		monstersRemaining = run.monstersRemaining,
		isBossRoom = run.isBossRoom,
		activeCards = CardServiceModule.getActiveCardIds(player),
		runChestCount = TreasureChestService.getRunChestCount(player),
	}
end

local function sendRunState(player: Player, draftOptions: { string }?)
	local snapshot = buildSnapshot(player)
	if snapshot then
		getDungeonRunStateEvent():FireClient(player, snapshot, draftOptions)
	end
end

local function bumpToken(player: Player): number
	runTokens[player] = (runTokens[player] or 0) + 1
	return runTokens[player]
end

local function isTokenValid(player: Player, token: number): boolean
	return runTokens[player] == token
end

local function shouldOfferCards(room: number): boolean
	if room < DungeonConfig.FIRST_CARD_ROOM then
		return false
	end
	return room % DungeonConfig.CARD_OFFER_EVERY_N_ROOMS == 0
end

local function beginRoom(player: Player)
	local run = getRun(player)
	if not run or run.status == "ended" then
		return
	end

	run.status = "fighting"
	run.isBossRoom = run.room > 0 and run.room % DungeonConfig.BOSS_EVERY_N_ROOMS == 0

	run.monstersRemaining = WaveService.spawnDungeonMonsters(
		run.room,
		player.UserId,
		run.isBossRoom,
		DungeonConfig.SPAWN_RADIUS_MIN,
		DungeonConfig.SPAWN_RADIUS_MAX
	)

	sendRunState(player)
end

local function proceedAfterRoomClear(player: Player, clearedRoom: number)
	local token = bumpToken(player)
	task.delay(DungeonConfig.ROOM_CLEAR_DELAY, function()
		if not isTokenValid(player, token) then
			return
		end

		local activeRun = getRun(player)
		if not activeRun or activeRun.status ~= "intermission" then
			return
		end

		if shouldOfferCards(clearedRoom) then
			activeRun.status = "card_draft"
			local options = CardServiceModule.rollDraftOptions(player, 3)
			pendingDraftOptions[player] = options
			sendRunState(player, options)

			local draftToken = bumpToken(player)
			task.delay(DungeonConfig.CARD_DRAFT_TIMEOUT, function()
				if not isTokenValid(player, draftToken) then
					return
				end

				local draftRun = getRun(player)
				if draftRun and draftRun.status == "card_draft" and pendingDraftOptions[player] then
					local fallback = pendingDraftOptions[player][1]
					if fallback then
						CardServiceModule.applyCard(player, fallback)
					end
					pendingDraftOptions[player] = nil
					draftRun.room += 1
					beginRoom(player)
				end
			end)
			return
		end

		activeRun.room += 1
		beginRoom(player)
	end)
end

local function continueAfterRoomClear(player: Player)
	local run = getRun(player)
	if not run then
		return
	end

	CardServiceModule.healOnRoomClear(player)

	run.gold += if run.isBossRoom then DungeonConfig.GOLD_PER_BOSS else DungeonConfig.GOLD_PER_ROOM
	local clearedRoom = run.room

	if TreasureConfig.shouldSpawnChest(run.isBossRoom) then
		local tierId = TreasureConfig.rollTier(run.isBossRoom, clearedRoom)
		TreasureChestService.awardRunChest(player, tierId, clearedRoom)
	end

	run.status = "intermission"
	sendRunState(player)
	proceedAfterRoomClear(player, clearedRoom)
end

local function onRoomCleared(player: Player)
	local run = getRun(player)
	if not run or run.status ~= "fighting" then
		return
	end

	run.monstersRemaining = 0
	continueAfterRoomClear(player)
end

local function healPlayerToFull(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = humanoid.MaxHealth
	end
end

local function onMonsterDeath(monster: Model)
	local ownerUserId = monster:GetAttribute("DungeonOwner")
	if typeof(ownerUserId) ~= "number" then
		return
	end

	local player = Players:GetPlayerByUserId(ownerUserId)
	if not player then
		return
	end

	local run = getRun(player)
	if not run or run.status ~= "fighting" then
		return
	end

	if monster:GetAttribute("IsBoss") == true then
		healPlayerToFull(player)
	end

	run.monstersRemaining = math.max(0, run.monstersRemaining - 1)
	sendRunState(player)

	if run.monstersRemaining <= 0 then
		onRoomCleared(player)
	end
end

function DungeonRunService.hasActiveRun(player: Player): boolean
	return playerRuns[player] ~= nil
end

function DungeonRunService.startRun(player: Player)
	WaveService.clearMonstersForOwner(player.UserId)
	bumpToken(player)
	CardServiceModule.resetRun(player)
	pendingDraftOptions[player] = nil
	TreasureChestService.clearRunChests(player)

	playerRuns[player] = {
		room = 1,
		gold = 0,
		status = "starting",
		monstersRemaining = 0,
		isBossRoom = false,
		activeCards = {},
		runChestCount = 0,
	}

	sendRunState(player)

	local token = bumpToken(player)
	task.delay(DungeonConfig.RUN_START_DELAY, function()
		if not isTokenValid(player, token) then
			return
		end

		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			CardServiceModule.bindCharacter(player, player.Character)
		end

		beginRoom(player)
	end)
end

function DungeonRunService.endRun(player: Player)
	WaveService.clearMonstersForOwner(player.UserId)
	TreasureChestService.clearRunChests(player)
	playerRuns[player] = nil
	pendingDraftOptions[player] = nil
	bumpToken(player)
	getDungeonRunStateEvent():FireClient(player, nil, nil)
end

function DungeonRunService.setRunEndedHandler(handler: (Player, number) -> ())
	runEndedHandler = handler
end

function DungeonRunService.bankRunChests(player: Player)
	TreasureChestService.transferRunChestsToLobby(player)
end

function DungeonRunService.handlePlayerDeath(player: Player)
	if not player.Parent then
		return
	end

	local run = getRun(player)
	local runGold = if run then run.gold else 0

	if LobbyConfig.USE_LOBBY and runEndedHandler then
		runEndedHandler(player, runGold)
		return
	end

	DungeonRunService.endRun(player)
end

function DungeonRunService.init()
	WaveService.setDungeonMode(true)
	WaveService.onMonsterDied(onMonsterDeath)

	getDungeonRunStateEvent()
	getCardDraftPickEvent()

	getCardDraftPickEvent().OnServerEvent:Connect(function(player, cardId: string)
		if typeof(cardId) ~= "string" then
			return
		end

		local run = getRun(player)
		local options = pendingDraftOptions[player]
		if not run or run.status ~= "card_draft" or not options then
			return
		end

		local valid = false
		for _, optionId in options do
			if optionId == cardId then
				valid = true
				break
			end
		end

		if not valid then
			return
		end

		CardServiceModule.applyCard(player, cardId)
		pendingDraftOptions[player] = nil
		bumpToken(player)
		run.room += 1
		beginRoom(player)
	end)

	local function bindPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			if not DungeonConfig.USE_DUNGEON_MODE then
				return
			end

			local humanoid = character:WaitForChild("Humanoid") :: Humanoid
			humanoid.Died:Connect(function()
				DungeonRunService.handlePlayerDeath(player)
			end)
		end)

		if not LobbyConfig.USE_LOBBY and player.Character then
			DungeonRunService.startRun(player)
		end
	end

	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end

	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		playerRuns[player] = nil
		pendingDraftOptions[player] = nil
		runTokens[player] = nil
	end)
end

return DungeonRunService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">GamePhaseService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)

local GamePhaseService = {}

export type Phase = "Lobby" | "Dungeon"

local playerPhases: { [Player]: Phase } = {}
local phaseStateEvent: RemoteEvent
local enterDungeonEvent: RemoteEvent

local DungeonRunServiceModule = nil
local PlayerDataServiceModule = nil
local WeaponServiceModule = nil
local SpellServiceModule = nil
local portalPromptConnection: RBXScriptConnection? = nil
local lastPortalEnterAt: { [Player]: number } = {}

local function getPhaseStateEvent(): RemoteEvent
	if phaseStateEvent then
		return phaseStateEvent
	end

	phaseStateEvent = ReplicatedStorage:FindFirstChild("PlayerPhaseState") :: RemoteEvent?
	if not phaseStateEvent then
		phaseStateEvent = Instance.new("RemoteEvent")
		phaseStateEvent.Name = "PlayerPhaseState"
		phaseStateEvent.Parent = ReplicatedStorage
	end

	return phaseStateEvent
end

local function getEnterDungeonEvent(): RemoteEvent
	if enterDungeonEvent then
		return enterDungeonEvent
	end

	enterDungeonEvent = ReplicatedStorage:FindFirstChild("EnterDungeon") :: RemoteEvent?
	if not enterDungeonEvent then
		enterDungeonEvent = Instance.new("RemoteEvent")
		enterDungeonEvent.Name = "EnterDungeon"
		enterDungeonEvent.Parent = ReplicatedStorage
	end

	return enterDungeonEvent
end

function GamePhaseService.getPhase(player: Player): Phase
	if not LobbyConfig.USE_LOBBY then
		return "Dungeon"
	end
	return playerPhases[player] or "Lobby"
end

function GamePhaseService.isInLobby(player: Player): boolean
	return GamePhaseService.getPhase(player) == "Lobby"
end

function GamePhaseService.isInDungeon(player: Player): boolean
	return GamePhaseService.getPhase(player) == "Dungeon"
end

function GamePhaseService.isLoadoutLocked(player: Player): boolean
	return GamePhaseService.isInDungeon(player)
end

local function sendPhase(player: Player)
	getPhaseStateEvent():FireClient(player, GamePhaseService.getPhase(player))
end

local function isPlayerActive(player: Player): boolean
	return player.Parent ~= nil
end

local function teleportCharacter(player: Player, position: Vector3)
	if not isPlayerActive(player) then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local lookVector = root.CFrame.LookVector
	local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
	if flatLook.Magnitude < 0.05 then
		flatLook = Vector3.new(0, 0, 1)
	else
		flatLook = flatLook.Unit
	end

	character:PivotTo(CFrame.new(position, position + flatLook))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

local function rescueFallenLobbyPlayer(player: Player)
	if not isPlayerActive(player) then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	if root.Position.Y < LobbyConfig.LOBBY_FALL_Y then
		GamePhaseService.teleportToLobby(player)
		humanoid.Health = humanoid.MaxHealth
	end
end

function GamePhaseService.teleportToLobby(player: Player)
	teleportCharacter(player, LobbyConfig.LOBBY_SPAWN)
end

function GamePhaseService.teleportToDungeon(player: Player)
	teleportCharacter(player, LobbyConfig.DUNGEON_SPAWN)
end

function GamePhaseService.returnToLobby(player: Player, runGold: number?)
	if not player.Parent then
		return
	end

	lastPortalEnterAt[player] = nil

	playerPhases[player] = "Lobby"
	player:SetAttribute("GamePhase", "Lobby")

	if runGold and runGold > 0 and PlayerDataServiceModule then
		PlayerDataServiceModule.addGold(player, runGold)
	end

	if DungeonRunServiceModule then
		DungeonRunServiceModule.bankRunChests(player)
		DungeonRunServiceModule.endRun(player)
	end

	GamePhaseService.teleportToLobby(player)
	sendPhase(player)

	if WeaponServiceModule then
		WeaponServiceModule.refreshPlayerLoadout(player)
	end
	if SpellServiceModule then
		SpellServiceModule.refreshPlayerLoadout(player)
	end
end

function GamePhaseService.enterDungeon(player: Player): boolean
	if not LobbyConfig.USE_LOBBY or not isPlayerActive(player) then
		return false
	end

	if DungeonRunServiceModule and DungeonRunServiceModule.hasActiveRun(player) then
		return false
	end

	local now = os.clock()
	if lastPortalEnterAt[player] and now - lastPortalEnterAt[player] < 1.5 then
		return false
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	lastPortalEnterAt[player] = now

	playerPhases[player] = "Dungeon"
	player:SetAttribute("GamePhase", "Dungeon")

	GamePhaseService.teleportToDungeon(player)
	sendPhase(player)

	if WeaponServiceModule then
		WeaponServiceModule.refreshPlayerLoadout(player)
	end
	if SpellServiceModule then
		SpellServiceModule.refreshPlayerLoadout(player)
	end

	if DungeonRunServiceModule then
		DungeonRunServiceModule.startRun(player)
	end

	return true
end

function GamePhaseService.wireDungeonPortal()
	local folder = workspace:FindFirstChild("Lobby")
	if not folder then
		return
	end

	local trigger = folder:FindFirstChild("PortalTrigger", true) :: BasePart?
	if not trigger then
		return
	end

	for _, child in trigger:GetChildren() do
		if child:IsA("ProximityPrompt") then
			child:Destroy()
		end
	end

	if portalPromptConnection then
		portalPromptConnection:Disconnect()
		portalPromptConnection = nil
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EnterDungeonPrompt"
	prompt.ActionText = "Enter Dungeon"
	prompt.ObjectText = "Dungeon Gate"
	prompt.HoldDuration = LobbyConfig.PORTAL_HOLD_SECONDS
	prompt.MaxActivationDistance = LobbyConfig.PORTAL_PROMPT_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.Enabled = true
	prompt.Parent = trigger

	portalPromptConnection = prompt.Triggered:Connect(function(player)
		GamePhaseService.enterDungeon(player)
	end)
end

function GamePhaseService.onPlayerReady(player: Player)
	if not isPlayerActive(player) then
		return
	end

	playerPhases[player] = "Lobby"
	player:SetAttribute("GamePhase", "Lobby")

	GamePhaseService.teleportToLobby(player)
	sendPhase(player)

	if WeaponServiceModule then
		WeaponServiceModule.refreshPlayerLoadout(player)
	end
	if SpellServiceModule then
		SpellServiceModule.refreshPlayerLoadout(player)
	end
end

local function runLobbySafetyLoop()
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				if not isPlayerActive(player) then
					continue
				end

				if GamePhaseService.isInLobby(player) then
					rescueFallenLobbyPlayer(player)
				end
			end
			task.wait(0.15)
		end
	end)
end

local function runPortalZoneLoop()
	local portalHoldTimes: { [Player]: number } = {}

	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				if not isPlayerActive(player) then
					continue
				end

				if DungeonRunServiceModule and DungeonRunServiceModule.hasActiveRun(player) then
					portalHoldTimes[player] = nil
				else
					local character = player.Character
					local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					if root and humanoid and humanoid.Health > 0 then
						local portalPos = LobbyConfig.PORTAL_POSITION
						local flatDistance = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(portalPos.X, 0, portalPos.Z)).Magnitude
						local inPortalZone = flatDistance <= LobbyConfig.PORTAL_ZONE_RADIUS
							and math.abs(root.Position.Y - portalPos.Y) <= 10

						if inPortalZone then
							local startedAt = portalHoldTimes[player]
							if not startedAt then
								portalHoldTimes[player] = os.clock()
							elseif os.clock() - startedAt >= LobbyConfig.PORTAL_HOLD_SECONDS then
								portalHoldTimes[player] = nil
								GamePhaseService.enterDungeon(player)
							end
						else
							portalHoldTimes[player] = nil
						end
					else
						portalHoldTimes[player] = nil
					end
				end
			end
			task.wait(0.1)
		end
	end)
end

function GamePhaseService.init(deps: {
	dungeonRunService: any,
	playerDataService: any,
	weaponService: any,
	spellService: any?,
})
	if not LobbyConfig.USE_LOBBY then
		return
	end

	DungeonRunServiceModule = deps.dungeonRunService
	PlayerDataServiceModule = deps.playerDataService
	WeaponServiceModule = deps.weaponService
	SpellServiceModule = deps.spellService

	getPhaseStateEvent()
	getEnterDungeonEvent()

	getEnterDungeonEvent().OnServerEvent:Connect(function(player)
		GamePhaseService.enterDungeon(player)
	end)

	local function bindPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			task.defer(function()
				if not isPlayerActive(player) or player.Character ~= character or not character.Parent then
					return
				end

				if GamePhaseService.isInLobby(player) then
					GamePhaseService.teleportToLobby(player)
				elseif GamePhaseService.isInDungeon(player) then
					GamePhaseService.teleportToDungeon(player)
				end

				if WeaponServiceModule then
					WeaponServiceModule.refreshPlayerLoadout(player)
				end
				if SpellServiceModule then
					SpellServiceModule.refreshPlayerLoadout(player)
				end
			end)
		end)

		if player.Character then
			GamePhaseService.onPlayerReady(player)
		else
			player.CharacterAdded:Once(function()
				GamePhaseService.onPlayerReady(player)
			end)
		end
	end

	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end

	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		playerPhases[player] = nil
		lastPortalEnterAt[player] = nil
	end)

	runLobbySafetyLoop()
	runPortalZoneLoop()
end

return GamePhaseService
]]></string>
        </Properties>
