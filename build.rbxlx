      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">BobConfig</string>
          <string name="Source"><![CDATA[local DungeonConfig = require(script.Parent.DungeonConfig)
local LobbyConfig = require(script.Parent.LobbyConfig)

local BobConfig = {}

BobConfig.DISPLAY_NAME = "Bob"
BobConfig.PROMPT_OBJECT_TEXT = "Bob the Guide"
BobConfig.PROMPT_ACTION_TEXT = "Talk"
BobConfig.PROMPT_DISTANCE = 11

BobConfig.POSITION = LobbyConfig.LOBBY_SPAWN + Vector3.new(14, 0, -8)
BobConfig.LOOK_AT = LobbyConfig.LOBBY_CENTER + Vector3.new(0, 5, 0)

function BobConfig.getDialogueLines(): { string }
	local bossInterval = DungeonConfig.BOSS_EVERY_N_ROOMS
	local cardInterval = DungeonConfig.CARD_OFFER_EVERY_N_ROOMS

	return {
		"Ah, another hunter. The depths below swallow the unprepared — steel yourself before you step through that gate.",
		"Each room you clear pushes you deeper. More beasts spill in every depth, and the old ones grow meaner as you descend.",
		`Every {bossInterval} depths, the Gravewarden Alpha rises to block the way. Break it, or it breaks you.`,
		`Clear rooms for run gold. Every {cardInterval} depths the dungeon offers relic choices — pick wisely, they last the whole run.`,
		"If you fall down there, the gold you earned on that run still lands in your purse. Talk to Harold at the forge to upgrade your weapons before you march.",
	}
end

return BobConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">BossConfig</string>
          <string name="Source"><![CDATA[local BossConfig = {}

BossConfig.ID = "Gravewarden"
BossConfig.DISPLAY_NAME = "Gravewarden Alpha"

BossConfig.BASE_HEALTH = 180
BossConfig.HEALTH_PER_BOSS_DEPTH = 38
BossConfig.DAMAGE = 11
BossConfig.WALK_SPEED = 15
BossConfig.ATTACK_RANGE = 8
BossConfig.ATTACK_COOLDOWN = 2.75
BossConfig.SCALE = 2.65
BossConfig.HIP_HEIGHT = 2.45

BossConfig.ATTACKS = {
	GroundSlam = {
		id = "GroundSlam",
		displayName = "Ground Slam",
		minRange = 0,
		maxRange = 14,
		windup = 0.9,
		damage = 14,
		radius = 11,
		weight = 3,
	},
	SavageCharge = {
		id = "SavageCharge",
		displayName = "Savage Charge",
		minRange = 12,
		maxRange = 42,
		windup = 0.6,
		damage = 13,
		chargeSpeed = 62,
		chargeDistance = 26,
		weight = 3,
	},
	DarkHowl = {
		id = "DarkHowl",
		displayName = "Dark Howl",
		minRange = 0,
		maxRange = 26,
		windup = 1.15,
		damage = 8,
		radius = 19,
		weight = 2,
	},
}

function BossConfig.getHealthForDepth(bossDepthIndex: number): number
	return math.floor(BossConfig.BASE_HEALTH + bossDepthIndex * BossConfig.HEALTH_PER_BOSS_DEPTH)
end

function BossConfig.getBossDepthIndex(room: number, bossEveryN: number): number
	return math.max(1, math.floor(room / bossEveryN))
end

function BossConfig.getHipHeight(scale: number): number
	return BossConfig.HIP_HEIGHT * (scale / BossConfig.SCALE)
end

return BossConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">BroadswordConfig</string>
          <string name="Source"><![CDATA[local BroadswordPose = require(script.Parent.BroadswordPose)

local BroadswordConfig = {}

local IDENTITY = CFrame.new()

-- Blade flat on the right shoulder, hilt still in the right hand.
local SHOULDER_GRIP = CFrame.new(0, -0.55, 0.35) * CFrame.Angles(math.rad(108), math.rad(180), math.rad(92))
local TWO_HAND_GRIP = CFrame.new(0.04, -0.34, 0.46) * CFrame.Angles(math.rad(72), math.rad(178), math.rad(94))
local WINDUP_GRIP = CFrame.new(0.62, -0.94, 0.24) * CFrame.Angles(math.rad(-38), math.rad(164), math.rad(106))
local STRIKE_GRIP = CFrame.new(0.08, -0.18, 0.52) * CFrame.Angles(math.rad(12), math.rad(172), math.rad(88))
local FOLLOW_GRIP = CFrame.new(-0.68, 0.4, 0.1) * CFrame.Angles(math.rad(114), math.rad(-20), math.rad(34))

BroadswordConfig.SHOULDER_POSE = {
	rightShoulder = CFrame.Angles(math.rad(-20), math.rad(30), math.rad(148)),
	rightElbow = CFrame.Angles(math.rad(-58), math.rad(6), math.rad(16)),
	rightWrist = CFrame.Angles(math.rad(32), math.rad(-28), math.rad(48)),
	leftShoulder = IDENTITY,
	leftElbow = IDENTITY,
	leftWrist = IDENTITY,
	grip = SHOULDER_GRIP,
}

BroadswordConfig.SHOULDER_GRIP = SHOULDER_GRIP

BroadswordConfig.SWING_ANIMATION_ID = "rbxassetid://131022963827845"
BroadswordConfig.USES_ANIMATION = true
BroadswordConfig.ANIMATION_SWING_DURATION = 0.92
BroadswordConfig.ANIMATION_END_RATIO = 0.88

-- GIF-style horizontal two-handed slash: shoulder -> wind-up -> edge-led arc -> follow-through -> shoulder.
BroadswordConfig.ANIMATION_GRIP_KEYFRAMES = {
	{ time = 0, grip = SHOULDER_GRIP },
	{ time = 0.07, grip = TWO_HAND_GRIP },
	{ time = 0.16, grip = WINDUP_GRIP },
	{ time = 0.3, grip = STRIKE_GRIP },
	{ time = 0.46, grip = FOLLOW_GRIP },
	{ time = 0.62, grip = TWO_HAND_GRIP },
	{ time = 0.78, grip = SHOULDER_GRIP },
}

local TWO_HAND_HILT: BroadswordPose.Pose = {
	rightShoulder = CFrame.Angles(math.rad(18), math.rad(-8), math.rad(92)),
	rightElbow = CFrame.Angles(math.rad(-58), math.rad(6), math.rad(10)),
	rightWrist = CFrame.Angles(math.rad(8), math.rad(-18), math.rad(12)),
	leftShoulder = CFrame.Angles(math.rad(12), math.rad(18), math.rad(-72)),
	leftElbow = CFrame.Angles(math.rad(-48), math.rad(-8), math.rad(6)),
	leftWrist = CFrame.Angles(math.rad(10), math.rad(22), math.rad(-8)),
	grip = TWO_HAND_GRIP,
}

local BOTTOM_RIGHT: BroadswordPose.Pose = {
	rightShoulder = CFrame.Angles(math.rad(42), math.rad(-24), math.rad(118)),
	rightElbow = CFrame.Angles(math.rad(-28), math.rad(18), math.rad(14)),
	rightWrist = CFrame.Angles(math.rad(-12), math.rad(-8), math.rad(18)),
	leftShoulder = CFrame.Angles(math.rad(36), math.rad(8), math.rad(-96)),
	leftElbow = CFrame.Angles(math.rad(-22), math.rad(-12), math.rad(4)),
	leftWrist = CFrame.Angles(math.rad(-6), math.rad(16), math.rad(-6)),
	grip = WINDUP_GRIP,
}

local TOP_RIGHT: BroadswordPose.Pose = {
	rightShoulder = CFrame.Angles(math.rad(-34), math.rad(-18), math.rad(108)),
	rightElbow = CFrame.Angles(math.rad(-18), math.rad(12), math.rad(8)),
	rightWrist = CFrame.Angles(math.rad(14), math.rad(-6), math.rad(10)),
	leftShoulder = CFrame.Angles(math.rad(-28), math.rad(12), math.rad(-88)),
	leftElbow = CFrame.Angles(math.rad(-12), math.rad(-8), math.rad(2)),
	leftWrist = CFrame.Angles(math.rad(8), math.rad(10), math.rad(-4)),
	grip = FOLLOW_GRIP,
}

BroadswordConfig.SWING_COOLDOWN = 0.65
BroadswordConfig.SWING_DURATION = 0.52
BroadswordConfig.STRIKE_START_RATIO = 0.24
BroadswordConfig.STRIKE_END_RATIO = 0.56

BroadswordConfig.PoseKeyframes = {
	{ time = 0, pose = BroadswordConfig.SHOULDER_POSE },
	{ time = 0.08, pose = TWO_HAND_HILT },
	{ time = 0.2, pose = BOTTOM_RIGHT },
	{ time = 0.34, pose = TOP_RIGHT },
	{ time = 0.52, pose = BroadswordConfig.SHOULDER_POSE },
}

function BroadswordConfig.smoothstep(alpha: number): number
	alpha = math.clamp(alpha, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

function BroadswordConfig.getSwingDuration(): number
	if BroadswordConfig.USES_ANIMATION then
		return BroadswordConfig.ANIMATION_SWING_DURATION * BroadswordConfig.ANIMATION_END_RATIO
	end
	return BroadswordConfig.SWING_DURATION
end

function BroadswordConfig.getGripForAnimationSwing(progress: number): CFrame
	local keyframes = BroadswordConfig.ANIMATION_GRIP_KEYFRAMES
	local time = math.clamp(progress, 0, BroadswordConfig.ANIMATION_END_RATIO)

	for index = 1, #keyframes - 1 do
		local current = keyframes[index]
		local nextKeyframe = keyframes[index + 1]
		if time >= current.time and time <= nextKeyframe.time then
			local span = nextKeyframe.time - current.time
			local alpha = if span > 0 then (time - current.time) / span else 1
			return current.grip:Lerp(nextKeyframe.grip, BroadswordConfig.smoothstep(alpha))
		end
	end

	return keyframes[#keyframes].grip
end

function BroadswordConfig.getPoseForSwing(elapsed: number): BroadswordPose.Pose
	local keyframes = BroadswordConfig.PoseKeyframes
	local time = math.clamp(elapsed, 0, BroadswordConfig.SWING_DURATION)

	for index = 1, #keyframes - 1 do
		local current = keyframes[index]
		local nextKeyframe = keyframes[index + 1]
		if time >= current.time and time <= nextKeyframe.time then
			local span = nextKeyframe.time - current.time
			local alpha = if span > 0 then (time - current.time) / span else 1
			return BroadswordPose.lerp(current.pose, nextKeyframe.pose, BroadswordConfig.smoothstep(alpha))
		end
	end

	return keyframes[#keyframes].pose
end

function BroadswordConfig.getGripForSwing(elapsed: number): CFrame
	return BroadswordConfig.getPoseForSwing(elapsed).grip
end

function BroadswordConfig.isStrikePhase(elapsed: number): boolean
	local duration = BroadswordConfig.getSwingDuration()
	local progress = elapsed / duration
	return progress >= BroadswordConfig.STRIKE_START_RATIO and progress <= BroadswordConfig.STRIKE_END_RATIO
end

return BroadswordConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">BroadswordPose</string>
          <string name="Source"><![CDATA[local BroadswordPose = {}

export type Pose = {
	rightShoulder: CFrame,
	rightElbow: CFrame,
	rightWrist: CFrame,
	leftShoulder: CFrame,
	leftElbow: CFrame,
	leftWrist: CFrame,
	grip: CFrame,
}

export type ArmMotors = {
	rightShoulder: Motor6D?,
	rightElbow: Motor6D?,
	rightWrist: Motor6D?,
	leftShoulder: Motor6D?,
	leftElbow: Motor6D?,
	leftWrist: Motor6D?,
}

local IDENTITY = CFrame.new()

function BroadswordPose.identity(): Pose
	return {
		rightShoulder = IDENTITY,
		rightElbow = IDENTITY,
		rightWrist = IDENTITY,
		leftShoulder = IDENTITY,
		leftElbow = IDENTITY,
		leftWrist = IDENTITY,
		grip = IDENTITY,
	}
end

function BroadswordPose.lerp(fromPose: Pose, toPose: Pose, alpha: number): Pose
	alpha = math.clamp(alpha, 0, 1)
	return {
		rightShoulder = fromPose.rightShoulder:Lerp(toPose.rightShoulder, alpha),
		rightElbow = fromPose.rightElbow:Lerp(toPose.rightElbow, alpha),
		rightWrist = fromPose.rightWrist:Lerp(toPose.rightWrist, alpha),
		leftShoulder = fromPose.leftShoulder:Lerp(toPose.leftShoulder, alpha),
		leftElbow = fromPose.leftElbow:Lerp(toPose.leftElbow, alpha),
		leftWrist = fromPose.leftWrist:Lerp(toPose.leftWrist, alpha),
		grip = fromPose.grip:Lerp(toPose.grip, alpha),
	}
end

function BroadswordPose.getMotors(character: Model): ArmMotors
	local upperTorso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not upperTorso then
		return {}
	end

	if character:FindFirstChild("UpperTorso") then
		local rightUpperArm = character:FindFirstChild("RightUpperArm")
		local rightLowerArm = character:FindFirstChild("RightLowerArm")
		local leftUpperArm = character:FindFirstChild("LeftUpperArm")
		local leftLowerArm = character:FindFirstChild("LeftLowerArm")

		return {
			rightShoulder = upperTorso:FindFirstChild("RightShoulder") :: Motor6D?,
			rightElbow = if rightUpperArm then rightUpperArm:FindFirstChild("RightElbow") :: Motor6D? else nil,
			rightWrist = if rightLowerArm then rightLowerArm:FindFirstChild("RightWrist") :: Motor6D? else nil,
			leftShoulder = upperTorso:FindFirstChild("LeftShoulder") :: Motor6D?,
			leftElbow = if leftUpperArm then leftUpperArm:FindFirstChild("LeftElbow") :: Motor6D? else nil,
			leftWrist = if leftLowerArm then leftLowerArm:FindFirstChild("LeftWrist") :: Motor6D? else nil,
		}
	end

	return {
		rightShoulder = upperTorso:FindFirstChild("Right Shoulder") :: Motor6D?,
		rightElbow = nil,
		rightWrist = nil,
		leftShoulder = upperTorso:FindFirstChild("Left Shoulder") :: Motor6D?,
		leftElbow = nil,
		leftWrist = nil,
	}
end

function BroadswordPose.apply(motors: ArmMotors, pose: Pose, tool: Tool?)
	if motors.rightShoulder then
		motors.rightShoulder.Transform = pose.rightShoulder
	end
	if motors.rightElbow then
		motors.rightElbow.Transform = pose.rightElbow
	end
	if motors.rightWrist then
		motors.rightWrist.Transform = pose.rightWrist
	end
	if motors.leftShoulder then
		motors.leftShoulder.Transform = pose.leftShoulder
	end
	if motors.leftElbow then
		motors.leftElbow.Transform = pose.leftElbow
	end
	if motors.leftWrist then
		motors.leftWrist.Transform = pose.leftWrist
	end
	if tool then
		tool.Grip = pose.grip
	end
end

function BroadswordPose.reset(motors: ArmMotors, tool: Tool?, idleGrip: CFrame?)
	BroadswordPose.apply(motors, BroadswordPose.identity(), tool)
	if tool and idleGrip then
		tool.Grip = idleGrip
	end
end

return BroadswordPose
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">CardConfig</string>
          <string name="Source"><![CDATA[local CardConfig = {}

export type CardEffects = {
	damageMult: number?,
	cooldownMult: number?,
	maxHealthBonus: number?,
	healOnRoomClear: number?,
	lifestealPercent: number?,
}

export type CardDefinition = {
	id: string,
	name: string,
	description: string,
	effects: CardEffects,
}

CardConfig.Cards = {
	BloodOath = {
		id = "BloodOath",
		name = "Blood Oath",
		description = "+18% damage, -12 max health.",
		effects = { damageMult = 1.18, maxHealthBonus = -12 },
	},
	IronHide = {
		id = "IronHide",
		name = "Iron Hide",
		description = "+25 max health.",
		effects = { maxHealthBonus = 25 },
	},
	BeastBane = {
		id = "BeastBane",
		name = "Beast Bane",
		description = "+22% damage against dungeon beasts.",
		effects = { damageMult = 1.22 },
	},
	QuickHands = {
		id = "QuickHands",
		name = "Quick Hands",
		description = "15% faster weapon swings.",
		effects = { cooldownMult = 0.85 },
	},
	VampiricEdge = {
		id = "VampiricEdge",
		name = "Vampiric Edge",
		description = "8% of damage dealt heals you.",
		effects = { lifestealPercent = 0.08 },
	},
	SecondWind = {
		id = "SecondWind",
		name = "Second Wind",
		description = "Restore 12 health after each cleared room.",
		effects = { healOnRoomClear = 12 },
	},
	Relentless = {
		id = "Relentless",
		name = "Relentless",
		description = "+10% damage and +10 max health.",
		effects = { damageMult = 1.1, maxHealthBonus = 10 },
	},
	StoneSkin = {
		id = "StoneSkin",
		name = "Stone Skin",
		description = "+35 max health, 8% slower swings.",
		effects = { maxHealthBonus = 35, cooldownMult = 1.08 },
	},
	HunterFocus = {
		id = "HunterFocus",
		name = "Hunter's Focus",
		description = "+14% damage.",
		effects = { damageMult = 1.14 },
	},
	GraveHarvest = {
		id = "GraveHarvest",
		name = "Grave Harvest",
		description = "Heal 6 HP on room clear and steal 5% life from hits.",
		effects = { healOnRoomClear = 6, lifestealPercent = 0.05 },
	},
}

function CardConfig.getCard(id: string): CardDefinition?
	return CardConfig.Cards[id]
end

function CardConfig.getAllIds(): { string }
	local ids: { string } = {}
	for id in CardConfig.Cards do
		table.insert(ids, id)
	end
	table.sort(ids)
	return ids
end

return CardConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
