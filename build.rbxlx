      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">WeaponCombatConfig</string>
          <string name="Source"><![CDATA[local BroadswordConfig = require(script.Parent.BroadswordConfig)
local HalberdConfig = require(script.Parent.HalberdConfig)
local RapierConfig = require(script.Parent.RapierConfig)
local WarAxeConfig = require(script.Parent.WarAxeConfig)
local WarHammerConfig = require(script.Parent.WarHammerConfig)
local WeaponConfig = require(script.Parent.WeaponConfig)

local WeaponCombatConfig = {}

local CONFIG_BY_WEAPON = {
	Broadsword = BroadswordConfig,
	Rapier = RapierConfig,
	WarAxe = WarAxeConfig,
	Halberd = HalberdConfig,
	WarHammer = WarHammerConfig,
}

function WeaponCombatConfig.getConfig(weaponId: string)
	return CONFIG_BY_WEAPON[weaponId] or BroadswordConfig
end

function WeaponCombatConfig.getConfigForTool(tool: Tool)
	local weaponId = tool:GetAttribute(WeaponConfig.WEAPON_ATTRIBUTE) or tool.Name
	return WeaponCombatConfig.getConfig(weaponId :: string)
end

function WeaponCombatConfig.usesAnimationSwing(weaponId: string): boolean
	return weaponId == "Broadsword" and BroadswordConfig.USES_ANIMATION
end

function WeaponCombatConfig.usesAnimationSwingForTool(tool: Tool): boolean
	local weaponId = tool:GetAttribute(WeaponConfig.WEAPON_ATTRIBUTE) or tool.Name
	return WeaponCombatConfig.usesAnimationSwing(weaponId :: string)
end

return WeaponCombatConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">WeaponConfig</string>
          <string name="Source"><![CDATA[local WeaponConfig = {}

export type WeaponStats = {
	id: string,
	displayName: string,
	description: string,
	damageMin: number,
	damageMax: number,
	cooldown: number,
	hitboxScale: number,
}

WeaponConfig.Weapons = {
	Broadsword = {
		id = "Broadsword",
		displayName = "Broadsword",
		description = "Heavy two-handed slashes.",
		damageMin = 5,
		damageMax = 10,
		cooldown = 0.65,
		hitboxScale = 2.35,
	},
	Rapier = {
		id = "Rapier",
		displayName = "Rapier",
		description = "Fast one-handed thrusts.",
		damageMin = 4,
		damageMax = 7,
		cooldown = 0.2,
		hitboxScale = 1.85,
	},
	WarAxe = {
		id = "WarAxe",
		displayName = "War Axe",
		description = "Quick overhead chops with a wide edge.",
		damageMin = 6,
		damageMax = 11,
		cooldown = 0.48,
		hitboxScale = 2.1,
	},
	Halberd = {
		id = "Halberd",
		displayName = "Halberd",
		description = "Long reach polearm sweeps.",
		damageMin = 7,
		damageMax = 12,
		cooldown = 0.72,
		hitboxScale = 2.55,
	},
	WarHammer = {
		id = "WarHammer",
		displayName = "War Hammer",
		description = "Slow crushing blows that hit hard.",
		damageMin = 9,
		damageMax = 16,
		cooldown = 0.95,
		hitboxScale = 1.95,
	},
}

WeaponConfig.DEFAULT_WEAPON = "Broadsword"
WeaponConfig.WEAPON_ATTRIBUTE = "WeaponId"

function WeaponConfig.getWeapon(id: string): WeaponStats?
	return WeaponConfig.Weapons[id]
end

function WeaponConfig.getWeaponList(): { WeaponStats }
	local list: { WeaponStats } = {}
	for _, weapon in WeaponConfig.Weapons do
		table.insert(list, weapon)
	end
	return list
end

function WeaponConfig.isValid(id: string): boolean
	return WeaponConfig.Weapons[id] ~= nil
end

function WeaponConfig.getStatsForTool(tool: Tool): WeaponStats
	local weaponId = tool:GetAttribute(WeaponConfig.WEAPON_ATTRIBUTE) or tool.Name
	return WeaponConfig.getWeapon(weaponId :: string) or WeaponConfig.Weapons.Broadsword
end

return WeaponConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">WeaponUpgradeConfig</string>
          <string name="Source"><![CDATA[local WeaponConfig = require(script.Parent.WeaponConfig)

local WeaponUpgradeConfig = {}

WeaponUpgradeConfig.MAX_LEVEL = 20
WeaponUpgradeConfig.DAMAGE_PER_LEVEL = 0.08
WeaponUpgradeConfig.COOLDOWN_REDUCTION_PER_LEVEL = 0.015
WeaponUpgradeConfig.MIN_COOLDOWN_MULT = 0.72

WeaponUpgradeConfig.UNLOCK_COSTS = {
	Broadsword = 0,
	Rapier = 120,
	WarAxe = 180,
	Halberd = 240,
	WarHammer = 300,
}

WeaponUpgradeConfig.BASE_UPGRADE_COST = 35
WeaponUpgradeConfig.UPGRADE_COST_GROWTH = 1.38

function WeaponUpgradeConfig.getUnlockCost(weaponId: string): number
	return WeaponUpgradeConfig.UNLOCK_COSTS[weaponId] or 9999
end

function WeaponUpgradeConfig.getUpgradeCost(weaponId: string, currentLevel: number): number
	if currentLevel >= WeaponUpgradeConfig.MAX_LEVEL then
		return 0
	end

	local base = WeaponUpgradeConfig.BASE_UPGRADE_COST + (WeaponUpgradeConfig.getUnlockCost(weaponId) * 0.08)
	return math.floor(base * (WeaponUpgradeConfig.UPGRADE_COST_GROWTH ^ (currentLevel - 1)))
end

function WeaponUpgradeConfig.getEffectiveStats(weaponId: string, level: number): WeaponConfig.WeaponStats
	local base = WeaponConfig.getWeapon(weaponId) or WeaponConfig.Weapons.Broadsword
	local clampedLevel = math.clamp(level, 1, WeaponUpgradeConfig.MAX_LEVEL)
	local damageMult = 1 + (clampedLevel - 1) * WeaponUpgradeConfig.DAMAGE_PER_LEVEL
	local cooldownMult = math.max(
		WeaponUpgradeConfig.MIN_COOLDOWN_MULT,
		1 - (clampedLevel - 1) * WeaponUpgradeConfig.COOLDOWN_REDUCTION_PER_LEVEL
	)

	return {
		id = base.id,
		displayName = base.displayName,
		description = base.description,
		damageMin = math.max(1, math.floor(base.damageMin * damageMult)),
		damageMax = math.max(1, math.floor(base.damageMax * damageMult)),
		cooldown = math.floor(base.cooldown * cooldownMult * 100) / 100,
		hitboxScale = base.hitboxScale,
	}
end

return WeaponUpgradeConfig
]]></string>
        </Properties>
      </Item>
    </Item>
