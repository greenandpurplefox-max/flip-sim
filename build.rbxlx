function LobbyEnvironmentService.init()
	if not LobbyConfig.USE_LOBBY then
		return
	end

	local folder = workspace:FindFirstChild("Lobby")
	if folder then
		folder:ClearAllChildren()
	else
		folder = Instance.new("Folder")
		folder.Name = "Lobby"
		folder.Parent = workspace
	end

	local center = LobbyConfig.LOBBY_CENTER
	local platform = createPart(
		"LobbyPlatform",
		LobbyConfig.LOBBY_PLATFORM_SIZE,
		CFrame.new(center),
		Color3.fromRGB(88, 84, 78),
		folder,
		{ material = Enum.Material.Cobblestone }
	)

	createPart(
		"LobbyTrim",
		Vector3.new(LobbyConfig.LOBBY_PLATFORM_SIZE.X + 4, 0.5, LobbyConfig.LOBBY_PLATFORM_SIZE.Z + 4),
		CFrame.new(center.X, center.Y - 1.1, center.Z),
		Color3.fromRGB(58, 54, 50),
		folder,
		{ material = Enum.Material.Slate }
	)

	createSign(folder, BlacksmithConfig.POSITION + Vector3.new(0, 6.5, 0), "Blacksmith", Color3.fromRGB(255, 196, 96))
	createSign(folder, BobConfig.POSITION + Vector3.new(0, 6.5, 0), "Bob", Color3.fromRGB(144, 196, 255))
	createSign(folder, InfuserConfig.POSITION + Vector3.new(0, 6.5, 0), "Infuser", Color3.fromRGB(180, 120, 255))
	createSign(folder, LobbyConfig.PORTAL_POSITION + Vector3.new(0, 0, 8), "Dungeon Gate", Color3.fromRGB(120, 255, 160))

	local forge = createPart(
		"ForgeAnvil",
		Vector3.new(4, 1.2, 2.4),
		CFrame.new(LobbyConfig.FORGE_POSITION),
		Color3.fromRGB(72, 72, 78),
		folder,
		{ material = Enum.Material.Metal }
	)
	createPart(
		"ForgeFire",
		Vector3.new(2.4, 1.4, 2.4),
		CFrame.new(LobbyConfig.FORGE_POSITION + Vector3.new(0, 1.1, -2.2)),
		Color3.fromRGB(255, 118, 48),
		folder,
		{ material = Enum.Material.Neon, canCollide = false, canTouch = false }
	)

	createBlacksmith(folder)
	createBob(folder)
	createInfuser(folder)

	local portalBase = createPart(
		"DungeonPortal",
		Vector3.new(12, 0.4, 12),
		CFrame.new(LobbyConfig.PORTAL_POSITION),
		Color3.fromRGB(48, 48, 52),
		folder,
		{ material = Enum.Material.Slate, canCollide = false, canTouch = false }
	)

	local portalTrigger = createPart(
		"PortalTrigger",
		Vector3.new(14, 8, 14),
		CFrame.new(LobbyConfig.PORTAL_POSITION + Vector3.new(0, 1, 0)),
		Color3.fromRGB(72, 220, 128),
		folder,
		{
			material = Enum.Material.Neon,
			canCollide = false,
			canTouch = true,
			canQuery = true,
			transparency = 0.88,
		}
	)

	local portalRing = createPart(
		"PortalRing",
		Vector3.new(0.35, 11, 11),
		CFrame.new(LobbyConfig.PORTAL_POSITION + Vector3.new(0, 0.35, 0)),
		Color3.fromRGB(48, 180, 96),
		folder,
		{ material = Enum.Material.Neon, canCollide = false, canTouch = false, shape = Enum.PartType.Cylinder }
	)
	portalRing.Orientation = Vector3.new(0, 0, 90)

	local portalGlow = createPart(
		"PortalGlow",
		Vector3.new(8, 8, 1),
		CFrame.new(LobbyConfig.PORTAL_POSITION + Vector3.new(0, 4.5, 0)),
		Color3.fromRGB(72, 220, 128),
		folder,
		{ material = Enum.Material.Neon, canCollide = false, canTouch = false, transparency = 0.35 }
	)

	portalTrigger:SetAttribute("PortalTrigger", true)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(LobbyConfig.LOBBY_SPAWN)
	spawn.Anchored = true
	spawn.CanCollide = false
	spawn.Transparency = 1
	spawn.Neutral = true
	spawn.Parent = folder

	for _, offset in { Vector3.new(-36, 1.5, -36), Vector3.new(36, 1.5, -36), Vector3.new(-36, 1.5, 36), Vector3.new(36, 1.5, 36) } do
		createPart(
			"LobbyPillar",
			Vector3.new(2.4, 8, 2.4),
			CFrame.new(center + offset),
			Color3.fromRGB(72, 68, 64),
			folder,
			{ material = Enum.Material.Brick }
		)
	end

	folder:SetAttribute("LobbyBuilt", true)
	platform:SetAttribute("LobbyBuilt", true)
	forge:SetAttribute("LobbyProp", true)
	portalBase:SetAttribute("LobbyProp", true)
end

return LobbyEnvironmentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GrimoireConfig = require(ReplicatedStorage.Shared.GrimoireConfig)
local InfuserConfig = require(ReplicatedStorage.Shared.InfuserConfig)
local LobbyConfig = require(ReplicatedStorage.Shared.LobbyConfig)
local SpellConfig = require(ReplicatedStorage.Shared.SpellConfig)
local SpellUpgradeConfig = require(ReplicatedStorage.Shared.SpellUpgradeConfig)
local TreasureConfig = require(ReplicatedStorage.Shared.TreasureConfig)
local WeaponConfig = require(ReplicatedStorage.Shared.WeaponConfig)
local WeaponUpgradeConfig = require(ReplicatedStorage.Shared.WeaponUpgradeConfig)

local PlayerDataService = {}

export type LobbyChest = {
	tierId: string,
	roomDepth: number,
}

export type PlayerProfile = {
	gold: number,
	equippedWeapon: string,
	weaponLevels: { [string]: number },
	unlockedWeapons: { [string]: boolean },
	ownedSpells: { [string]: boolean },
	weaponInfusions: { [string]: string },
	spellLevels: { [string]: number },
	unlockedSpells: { [string]: boolean },
	grimoireCount: number,
	lobbyChests: { LobbyChest },
}

local DATASTORE_NAME = "FlipSimPlayerProfiles_v1"
local AUTO_SAVE_INTERVAL_SECONDS = 45
local SAVE_DEBOUNCE_SECONDS = 6
local SAVE_RETRY_COUNT = 3

local profileStore: GlobalDataStore? = nil
local dataStoreEnabled = false
local profiles: { [Player]: PlayerProfile } = {}
local profileStateEvent: RemoteEvent
local pendingSaveTasks: { [Player]: thread } = {}

local function getDefaultProfile(): PlayerProfile
	local weaponLevels: { [string]: number } = {}
	local unlockedWeapons: { [string]: boolean } = {
		[LobbyConfig.STARTER_WEAPON] = true,
	}

	for _, weapon in WeaponConfig.getWeaponList() do
		weaponLevels[weapon.id] = 1
		if weapon.id ~= LobbyConfig.STARTER_WEAPON then
			unlockedWeapons[weapon.id] = false
		end
	end

	local spellLevels: { [string]: number } = {}
	local ownedSpells: { [string]: boolean } = {
		[LobbyConfig.STARTER_ACTIVE_SPELL] = true,
	}
	local unlockedSpells: { [string]: boolean } = {
		[LobbyConfig.STARTER_ACTIVE_SPELL] = true,
	}

	for _, spell in SpellConfig.getSpellList() do
		spellLevels[spell.id] = 1
		if spell.id ~= LobbyConfig.STARTER_ACTIVE_SPELL then
			unlockedSpells[spell.id] = false
		end
	end

	return {
		gold = LobbyConfig.STARTER_GOLD,
		equippedWeapon = LobbyConfig.STARTER_WEAPON,
		weaponLevels = weaponLevels,
		unlockedWeapons = unlockedWeapons,
		ownedSpells = ownedSpells,
		weaponInfusions = {},
		spellLevels = spellLevels,
		unlockedSpells = unlockedSpells,
		grimoireCount = 0,
		lobbyChests = {},
	}
end

local function sanitizeLobbyChests(data: any): { LobbyChest }
	local chests: { LobbyChest } = {}
	if typeof(data) ~= "table" then
		return chests
	end

	for _, chest in data do
		if typeof(chest) == "table" and typeof(chest.tierId) == "string" then
			local tier = TreasureConfig.getTier(chest.tierId)
			if tier then
				local roomDepth = if typeof(chest.roomDepth) == "number"
					then math.max(1, math.floor(chest.roomDepth))
					else 1
				table.insert(chests, {
					tierId = chest.tierId,
					roomDepth = roomDepth,
				})
			end
		end
	end

	return chests
end

local function sanitizeProfile(data: any): PlayerProfile
	local defaults = getDefaultProfile()
	if typeof(data) ~= "table" then
		return defaults
	end

	local profile = table.clone(defaults)
	profile.gold = if typeof(data.gold) == "number" then math.max(0, math.floor(data.gold)) else defaults.gold
	profile.equippedWeapon = if WeaponConfig.isValid(data.equippedWeapon)
		then data.equippedWeapon
		else defaults.equippedWeapon

	if typeof(data.weaponLevels) == "table" then
		for weaponId, level in data.weaponLevels do
			if WeaponConfig.isValid(weaponId) and typeof(level) == "number" then
				profile.weaponLevels[weaponId] = math.clamp(math.floor(level), 1, WeaponUpgradeConfig.MAX_LEVEL)
			end
		end
	end

	if typeof(data.unlockedWeapons) == "table" then
		for weaponId, unlocked in data.unlockedWeapons do
			if WeaponConfig.isValid(weaponId) and typeof(unlocked) == "boolean" then
				profile.unlockedWeapons[weaponId] = unlocked
			end
		end
	end

	profile.unlockedWeapons[LobbyConfig.STARTER_WEAPON] = true
	if not profile.unlockedWeapons[profile.equippedWeapon] then
		profile.equippedWeapon = LobbyConfig.STARTER_WEAPON
	end

	profile.weaponInfusions = {}
	if typeof(data.weaponInfusions) == "table" then
		for weaponId, spellId in data.weaponInfusions do
			if WeaponConfig.isValid(weaponId) and typeof(spellId) == "string" and SpellConfig.isValid(spellId) then
				profile.weaponInfusions[weaponId] = spellId
			end
		end
	end

	if typeof(data.infusedSpellId) == "string" and SpellConfig.isValid(data.infusedSpellId) then
		if profile.weaponInfusions[profile.equippedWeapon] == nil then
			profile.weaponInfusions[profile.equippedWeapon] = data.infusedSpellId
		end
	elseif typeof(data.equippedActiveSpell) == "string" and SpellConfig.isValid(data.equippedActiveSpell) then
		if profile.weaponInfusions[profile.equippedWeapon] == nil then
			profile.weaponInfusions[profile.equippedWeapon] = data.equippedActiveSpell
		end
	end

	for weaponId, spellId in profile.weaponInfusions do
		if not profile.ownedSpells[spellId] then
			profile.weaponInfusions[weaponId] = nil
		end
	end

	profile.grimoireCount = if typeof(data.grimoireCount) == "number"
		then math.max(0, math.floor(data.grimoireCount))
		else defaults.grimoireCount

	if typeof(data.spellLevels) == "table" then
		for spellId, level in data.spellLevels do
			if SpellConfig.isValid(spellId) and typeof(level) == "number" then
				profile.spellLevels[spellId] = math.clamp(math.floor(level), 1, SpellUpgradeConfig.MAX_LEVEL)
			end
		end
	end

	if typeof(data.unlockedSpells) == "table" then
		for spellId, unlocked in data.unlockedSpells do
			if SpellConfig.isValid(spellId) and typeof(unlocked) == "boolean" then
				profile.unlockedSpells[spellId] = unlocked
			end
		end
	end

	if typeof(data.ownedSpells) == "table" then
		for spellId, owned in data.ownedSpells do
			if SpellConfig.isValid(spellId) and typeof(owned) == "boolean" then
				profile.ownedSpells[spellId] = owned
			end
		end
	end

	profile.unlockedSpells[LobbyConfig.STARTER_ACTIVE_SPELL] = true
	profile.ownedSpells[LobbyConfig.STARTER_ACTIVE_SPELL] = true

	for spellId, unlocked in profile.unlockedSpells do
		if unlocked then
			profile.ownedSpells[spellId] = true
		end
	end

	profile.lobbyChests = sanitizeLobbyChests(data.lobbyChests)

	return profile
end

local function getProfileStateEvent(): RemoteEvent
	if profileStateEvent then
		return profileStateEvent
	end

	profileStateEvent = ReplicatedStorage:FindFirstChild("PlayerProfileState") :: RemoteEvent?
	if not profileStateEvent then
		profileStateEvent = Instance.new("RemoteEvent")
		profileStateEvent.Name = "PlayerProfileState"
		profileStateEvent.Parent = ReplicatedStorage
	end

	return profileStateEvent
end

local function buildSnapshot(profile: PlayerProfile)
	local weaponLevels: { [string]: number } = {}
	local unlockedWeapons: { [string]: boolean } = {}
	for _, weapon in WeaponConfig.getWeaponList() do
		weaponLevels[weapon.id] = profile.weaponLevels[weapon.id] or 1
		unlockedWeapons[weapon.id] = profile.unlockedWeapons[weapon.id] == true
	end

	local spellLevels: { [string]: number } = {}
	local unlockedSpells: { [string]: boolean } = {}
	local ownedSpells: { [string]: boolean } = {}
	for _, spell in SpellConfig.getSpellList() do
		spellLevels[spell.id] = profile.spellLevels[spell.id] or 1
		unlockedSpells[spell.id] = profile.unlockedSpells[spell.id] == true
		ownedSpells[spell.id] = profile.ownedSpells[spell.id] == true
	end

	local weaponInfusions: { [string]: string } = {}
	for _, weapon in WeaponConfig.getWeaponList() do
		local spellId = profile.weaponInfusions[weapon.id]
		if typeof(spellId) == "string" and spellId ~= "" then
			weaponInfusions[weapon.id] = spellId
		end
	end

	local equippedInfusion = weaponInfusions[profile.equippedWeapon] or ""

	return {
		gold = profile.gold,
		equippedWeapon = profile.equippedWeapon,
		weaponLevels = weaponLevels,
		unlockedWeapons = unlockedWeapons,
		ownedSpells = ownedSpells,
		weaponInfusions = weaponInfusions,
		infusedSpellId = equippedInfusion,
		spellLevels = spellLevels,
		unlockedSpells = unlockedSpells,
		grimoireCount = profile.grimoireCount,
		lobbyChests = profile.lobbyChests,
	}
end

local function getProfileKey(player: Player): string
	return `player_{player.UserId}`
end

local function scheduleSave(player: Player)
	if not dataStoreEnabled or not profiles[player] then
		return
	end

	local pending = pendingSaveTasks[player]
	if pending then
		task.cancel(pending)
	end

	pendingSaveTasks[player] = task.delay(SAVE_DEBOUNCE_SECONDS, function()
		pendingSaveTasks[player] = nil
		PlayerDataService.saveProfile(player)
	end)
end

function PlayerDataService.saveProfileNow(player: Player)
	local pending = pendingSaveTasks[player]
	if pending then
		task.cancel(pending)
		pendingSaveTasks[player] = nil
	end

	PlayerDataService.saveProfile(player)
end

function PlayerDataService.sendProfile(player: Player)
	local profile = profiles[player]
	if profile then
		getProfileStateEvent():FireClient(player, buildSnapshot(profile))
	end
end

function PlayerDataService.getProfile(player: Player): PlayerProfile?
	return profiles[player]
end

function PlayerDataService.getGold(player: Player): number
	local profile = profiles[player]
	return if profile then profile.gold else 0
end

function PlayerDataService.addGold(player: Player, amount: number)
	local profile = profiles[player]
	if not profile or amount <= 0 then
		return
	end

	profile.gold += math.floor(amount)
	PlayerDataService.sendProfile(player)
	scheduleSave(player)
end

function PlayerDataService.trySpendGold(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or amount <= 0 or profile.gold < amount then
		return false
	end

	profile.gold -= math.floor(amount)
	PlayerDataService.sendProfile(player)
	scheduleSave(player)
	return true
end

function PlayerDataService.getEquippedWeapon(player: Player): string
	local profile = profiles[player]
	return if profile then profile.equippedWeapon else LobbyConfig.STARTER_WEAPON
end

function PlayerDataService.setEquippedWeapon(player: Player, weaponId: string): boolean
	local profile = profiles[player]
	if not profile or not profile.unlockedWeapons[weaponId] then
		return false
	end

	profile.equippedWeapon = weaponId
	PlayerDataService.sendProfile(player)
	scheduleSave(player)
	return true
end

function PlayerDataService.isWeaponUnlocked(player: Player, weaponId: string): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.unlockedWeapons[weaponId] == true
end

function PlayerDataService.getWeaponLevel(player: Player, weaponId: string): number
	local profile = profiles[player]
	if not profile then
		return 1
	end
	return profile.weaponLevels[weaponId] or 1
end

function PlayerDataService.tryUnlockWeapon(player: Player, weaponId: string): (boolean, string?)
	local profile = profiles[player]
	if not profile or not WeaponConfig.isValid(weaponId) then
		return false, "Invalid weapon."
	end

	if profile.unlockedWeapons[weaponId] then
		return false, "Already unlocked."
	end

	local cost = WeaponUpgradeConfig.getUnlockCost(weaponId)
	if profile.gold < cost then
		return false, "Not enough gold."
	end

	profile.gold -= cost
	profile.unlockedWeapons[weaponId] = true
	PlayerDataService.sendProfile(player)
	scheduleSave(player)
	return true, nil
end

function PlayerDataService.tryUpgradeWeapon(player: Player, weaponId: string): (boolean, string?)
	local profile = profiles[player]
	if not profile or not profile.unlockedWeapons[weaponId] then
		return false, "Weapon locked."
	end

	local currentLevel = profile.weaponLevels[weaponId] or 1
	if currentLevel >= WeaponUpgradeConfig.MAX_LEVEL then
		return false, "Max level reached."
	end

	local cost = WeaponUpgradeConfig.getUpgradeCost(weaponId, currentLevel)
	if profile.gold < cost then
		return false, "Not enough gold."
	end

	profile.gold -= cost
	profile.weaponLevels[weaponId] = currentLevel + 1
	PlayerDataService.sendProfile(player)
	scheduleSave(player)
	return true, nil
end

function PlayerDataService.getInfusedSpell(player: Player): string
	local profile = profiles[player]
	if not profile then
		return ""
	end

	return profile.weaponInfusions[profile.equippedWeapon] or ""
end

function PlayerDataService.getWeaponInfusion(player: Player, weaponId: string): string
	local profile = profiles[player]
	if not profile or not WeaponConfig.isValid(weaponId) then
		return ""
	end

	return profile.weaponInfusions[weaponId] or ""
end

function PlayerDataService.ownsSpell(player: Player, spellId: string): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.ownedSpells[spellId] == true
end

function PlayerDataService.tryInfuseWeapon(player: Player, weaponId: string, spellId: string): (boolean, string?)
	local profile = profiles[player]
	if not profile then
		return false, "Profile unavailable."
	end
	if not WeaponConfig.isValid(weaponId) then
		return false, "Invalid weapon."
	end
	if not profile.unlockedWeapons[weaponId] then
		return false, "Weapon locked."
	end
	if not SpellConfig.isValid(spellId) or not profile.ownedSpells[spellId] then
		return false, "Spell not owned."
	end

	local existing = profile.weaponInfusions[weaponId]
	if typeof(existing) == "string" and existing ~= "" then
		return false, "That weapon already has an infused spell."
	end

	if profile.grimoireCount < InfuserConfig.INFUSION_GRIMOIRE_COST then
		return false, "Need a grimoire to infuse a weapon."
	end

	profile.grimoireCount -= InfuserConfig.INFUSION_GRIMOIRE_COST
	profile.weaponInfusions[weaponId] = spellId
	PlayerDataService.sendProfile(player)
	PlayerDataService.saveProfileNow(player)
	return true, nil
end

function PlayerDataService.tryPurgeWeaponInfusion(player: Player, weaponId: string): (boolean, string?)
	local profile = profiles[player]
	if not profile then
		return false, "Profile unavailable."
	end
	if not WeaponConfig.isValid(weaponId) then
		return false, "Invalid weapon."
	end

	local existing = profile.weaponInfusions[weaponId]
	if typeof(existing) ~= "string" or existing == "" then
		return false, "That weapon has no infusion to remove."
	end

	local cost = InfuserConfig.PURGE_COST
	if profile.gold < cost then
		return false, `Need {cost} gold to purge.`
	end

	profile.gold -= cost
	profile.weaponInfusions[weaponId] = nil
	PlayerDataService.sendProfile(player)
	PlayerDataService.saveProfileNow(player)
	return true, nil
end

function PlayerDataService.getGrimoireCount(player: Player): number
	local profile = profiles[player]
	return if profile then profile.grimoireCount else 0
end

function PlayerDataService.addGrimoire(player: Player, amount: number)
	local profile = profiles[player]
	if not profile or amount <= 0 then
		return
	end

	profile.grimoireCount += math.floor(amount)
	PlayerDataService.sendProfile(player)
	PlayerDataService.saveProfileNow(player)
end

function PlayerDataService.grantOwnedSpell(player: Player, spellId: string): boolean
	local profile = profiles[player]
	if not profile or not SpellConfig.isValid(spellId) then
		return false
	end

	local wasOwned = profile.ownedSpells[spellId] == true
	profile.ownedSpells[spellId] = true
	profile.unlockedSpells[spellId] = true
	PlayerDataService.sendProfile(player)
	scheduleSave(player)
	return not wasOwned
end

function PlayerDataService.tryUseGrimoire(player: Player): (boolean, string?, string?)
	local profile = profiles[player]
	if not profile or profile.grimoireCount <= 0 then
		return false, nil, "No grimoires left."
	end

	profile.grimoireCount -= 1

	local unownedIds: { string } = {}
	for _, spell in SpellConfig.getSpellList() do
		if profile.ownedSpells[spell.id] ~= true then
			table.insert(unownedIds, spell.id)
		end
	end

	local spellId: string
	if #unownedIds > 0 then
		spellId = unownedIds[math.random(1, #unownedIds)]
	else
		local spellList = SpellConfig.getSpellList()
		spellId = spellList[math.random(1, #spellList)].id
	end

	local isNew = PlayerDataService.grantOwnedSpell(player, spellId)

	if not isNew then
		profile.gold += GrimoireConfig.DUPLICATE_GOLD
	end

	PlayerDataService.sendProfile(player)
	PlayerDataService.saveProfileNow(player)

	local spell = SpellConfig.getSpell(spellId)
	local message = if isNew
		then `Learned {spell.displayName}!`
		else `Already knew {spell.displayName}. +{GrimoireConfig.DUPLICATE_GOLD} gold.`

	return true, spellId, message
end

function PlayerDataService.isSpellUnlocked(player: Player, spellId: string): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.unlockedSpells[spellId] == true
end

function PlayerDataService.getSpellLevel(player: Player, spellId: string): number
	local profile = profiles[player]
	if not profile then
		return 1
	end
	return profile.spellLevels[spellId] or 1
end

function PlayerDataService.tryUnlockSpell(player: Player, spellId: string): (boolean, string?)
	local profile = profiles[player]
	if not profile or not SpellConfig.isValid(spellId) then
		return false, "Invalid spell."
	end

	if profile.unlockedSpells[spellId] then
		return false, "Already unlocked."
	end

	local cost = SpellUpgradeConfig.getUnlockCost(spellId)
	if profile.gold < cost then
		return false, "Not enough gold."
	end

	profile.gold -= cost
	profile.unlockedSpells[spellId] = true
	profile.ownedSpells[spellId] = true
	PlayerDataService.sendProfile(player)
	scheduleSave(player)
	return true, nil
end

function PlayerDataService.tryUpgradeSpell(player: Player, spellId: string): (boolean, string?)
	local profile = profiles[player]
	if not profile or not profile.unlockedSpells[spellId] then
		return false, "Spell locked."
	end

	local currentLevel = profile.spellLevels[spellId] or 1
	if currentLevel >= SpellUpgradeConfig.MAX_LEVEL then
		return false, "Max level reached."
	end

	local cost = SpellUpgradeConfig.getUpgradeCost(spellId, currentLevel)
	if profile.gold < cost then
		return false, "Not enough gold."
	end

	profile.gold -= cost
	profile.spellLevels[spellId] = currentLevel + 1
	PlayerDataService.sendProfile(player)
	scheduleSave(player)
	return true, nil
end

function PlayerDataService.getLobbyChests(player: Player): { LobbyChest }
	local profile = profiles[player]
	if not profile then
		return {}
	end
	return profile.lobbyChests
end

function PlayerDataService.setLobbyChests(player: Player, chests: { LobbyChest })
	local profile = profiles[player]
	if not profile then
		return
	end

	profile.lobbyChests = chests
	scheduleSave(player)
end

function PlayerDataService.saveProfile(player: Player)
	local profile = profiles[player]
	if not profile or not profileStore or not dataStoreEnabled then
		return
	end

	local key = getProfileKey(player)
	local snapshot = buildSnapshot(profile)

	task.spawn(function()
		for attempt = 1, SAVE_RETRY_COUNT do
			local ok = pcall(function()
				profileStore:UpdateAsync(key, function()
					return snapshot
				end)
			end)
			if ok then
				return
			end
			task.wait(attempt)
		end
	end)
end

local function loadProfile(player: Player): PlayerProfile
	if not profileStore or not dataStoreEnabled then
		return getDefaultProfile()
	end

	local loaded: any = nil
	local ok = pcall(function()
		loaded = profileStore:GetAsync(getProfileKey(player))
	end)

	if ok then
		return sanitizeProfile(loaded)
	end

	return getDefaultProfile()
end

local function initProfileStore(): boolean
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)
	if not ok or not store then
		return false
	end

	if RunService:IsStudio() then
		local apiOk = pcall(function()
			store:GetAsync("__studio_api_probe__")
		end)
		if not apiOk then
			return false
		end
	end

	profileStore = store
	return true
end

local function bindPlayer(player: Player)
	profiles[player] = loadProfile(player)
	PlayerDataService.sendProfile(player)
end

local function unbindPlayer(player: Player)
	local pending = pendingSaveTasks[player]
	if pending then
		task.cancel(pending)
		pendingSaveTasks[player] = nil
	end

	PlayerDataService.saveProfile(player)
	profiles[player] = nil
end

function PlayerDataService.init()
	dataStoreEnabled = initProfileStore()
	if not dataStoreEnabled then
		if RunService:IsStudio() then
			warn(
				"[PlayerDataService] DataStore disabled in Studio. Enable 'Studio Access to API Services' in Game Settings to save progress."
			)
		else
			warn("[PlayerDataService] DataStore unavailable. Progress will not persist this session.")
		end
	end

	getProfileStateEvent()

	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end

	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(unbindPlayer)

	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			PlayerDataService.saveProfile(player)
		end
		task.wait(2)
	end)

	task.spawn(function()
		while true do
			task.wait(AUTO_SAVE_INTERVAL_SECONDS)
			if not dataStoreEnabled then
				continue
			end
			for _, player in Players:GetPlayers() do
				PlayerDataService.saveProfile(player)
			end
		end
	end)
end

return PlayerDataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">SpellService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SpellConfig = require(ReplicatedStorage.Shared.SpellConfig)
local SpellUpgradeConfig = require(ReplicatedStorage.Shared.SpellUpgradeConfig)

local CardService = require(script.Parent.CardService)
local GamePhaseService = require(script.Parent.GamePhaseService)
local PlayerDataService = require(script.Parent.PlayerDataService)
local StaminaService = require(script.Parent.StaminaService)

local SpellService = {}

local PROJECTILE_LIFETIME = 2.5
local PROJECTILE_TARGET_RANGE = 140

local lastActiveCastAt: { [Player]: number } = {}

local infuseSpellEvent: RemoteEvent
local purgeWeaponInfusionEvent: RemoteEvent
local upgradeSpellEvent: RemoteEvent
local unlockSpellEvent: RemoteEvent
local castSpellEvent: RemoteEvent
local spellLoadoutUpdatedEvent: RemoteEvent
local spellCastEffectEvent: RemoteEvent

local function isPlayerActive(player: Player): boolean
	return player.Parent ~= nil
end

local function getInfuseSpellEvent(): RemoteEvent
	if infuseSpellEvent then
		return infuseSpellEvent
	end

	infuseSpellEvent = ReplicatedStorage:FindFirstChild("InfuseSpell") :: RemoteEvent?
	if not infuseSpellEvent then
		infuseSpellEvent = Instance.new("RemoteEvent")
		infuseSpellEvent.Name = "InfuseSpell"
		infuseSpellEvent.Parent = ReplicatedStorage
	end

	return infuseSpellEvent
end

local function getPurgeWeaponInfusionEvent(): RemoteEvent
	if purgeWeaponInfusionEvent then
		return purgeWeaponInfusionEvent
	end

	purgeWeaponInfusionEvent = ReplicatedStorage:FindFirstChild("PurgeWeaponInfusion") :: RemoteEvent?
	if not purgeWeaponInfusionEvent then
		purgeWeaponInfusionEvent = Instance.new("RemoteEvent")
		purgeWeaponInfusionEvent.Name = "PurgeWeaponInfusion"
		purgeWeaponInfusionEvent.Parent = ReplicatedStorage
	end

	return purgeWeaponInfusionEvent
end

local function getUpgradeSpellEvent(): RemoteEvent
	if upgradeSpellEvent then
		return upgradeSpellEvent
	end

	upgradeSpellEvent = ReplicatedStorage:FindFirstChild("UpgradeSpell") :: RemoteEvent?
	if not upgradeSpellEvent then
		upgradeSpellEvent = Instance.new("RemoteEvent")
		upgradeSpellEvent.Name = "UpgradeSpell"
		upgradeSpellEvent.Parent = ReplicatedStorage
	end

	return upgradeSpellEvent
end

local function getUnlockSpellEvent(): RemoteEvent
	if unlockSpellEvent then
		return unlockSpellEvent
	end

	unlockSpellEvent = ReplicatedStorage:FindFirstChild("UnlockSpell") :: RemoteEvent?
	if not unlockSpellEvent then
		unlockSpellEvent = Instance.new("RemoteEvent")
		unlockSpellEvent.Name = "UnlockSpell"
		unlockSpellEvent.Parent = ReplicatedStorage
	end

	return unlockSpellEvent
end

local function getCastSpellEvent(): RemoteEvent
	if castSpellEvent then
		return castSpellEvent
	end

	castSpellEvent = ReplicatedStorage:FindFirstChild("CastSpell") :: RemoteEvent?
	if not castSpellEvent then
		castSpellEvent = Instance.new("RemoteEvent")
		castSpellEvent.Name = "CastSpell"
		castSpellEvent.Parent = ReplicatedStorage
	end

	return castSpellEvent
end

local function getSpellLoadoutUpdatedEvent(): RemoteEvent
	if spellLoadoutUpdatedEvent then
		return spellLoadoutUpdatedEvent
	end

	spellLoadoutUpdatedEvent = ReplicatedStorage:FindFirstChild("SpellLoadoutUpdated") :: RemoteEvent?
	if not spellLoadoutUpdatedEvent then
		spellLoadoutUpdatedEvent = Instance.new("RemoteEvent")
		spellLoadoutUpdatedEvent.Name = "SpellLoadoutUpdated"
		spellLoadoutUpdatedEvent.Parent = ReplicatedStorage
	end

	return spellLoadoutUpdatedEvent
end

local function getSpellCastEffectEvent(): RemoteEvent
	if spellCastEffectEvent then
		return spellCastEffectEvent
	end

	spellCastEffectEvent = ReplicatedStorage:FindFirstChild("SpellCastEffect") :: RemoteEvent?
	if not spellCastEffectEvent then
		spellCastEffectEvent = Instance.new("RemoteEvent")
		spellCastEffectEvent.Name = "SpellCastEffect"
		spellCastEffectEvent.Parent = ReplicatedStorage
	end

	return spellCastEffectEvent
end

local function getEffectiveStats(player: Player, spellId: string): SpellUpgradeConfig.EffectiveSpellStats
	local level = PlayerDataService.getSpellLevel(player, spellId)
	return SpellUpgradeConfig.getEffectiveStats(spellId, level)
end

local function getMonstersFolder(): Folder?
	return workspace:FindFirstChild("WaveMonsters") :: Folder?
end

local function getProjectileFolder(): Folder
	local folder = workspace:FindFirstChild("SpellProjectiles") :: Folder?
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "SpellProjectiles"
		folder.Parent = workspace
	end
	return folder
end

local function createSparkEmitter(parent: Instance, color: Color3, rate: number, lifetime: NumberRange)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "SpellSparkles"
	emitter.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.65))
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(0.5, 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = lifetime
	emitter.Rate = rate
	emitter.Speed = NumberRange.new(4, 12)
	emitter.SpreadAngle = Vector2.new(35, 35)
	emitter.Drag = 2
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Parent = parent
	return emitter
end

local function decorateProjectile(part: BasePart, stats: SpellUpgradeConfig.EffectiveSpellStats)
	local glow = Instance.new("Part")
	glow.Name = "SpellGlow"
	glow.Size = part.Size * 1.55
	glow.Material = Enum.Material.Neon
	glow.Color = stats.projectileColor
	glow.Transparency = 0.55
	glow.CanCollide = false
	glow.Massless = true
	glow.Anchored = false
	glow.CFrame = part.CFrame
	glow.Parent = part

	local glowWeld = Instance.new("WeldConstraint")
	glowWeld.Part0 = part
	glowWeld.Part1 = glow
	glowWeld.Parent = part

	local light = Instance.new("PointLight")
	light.Color = stats.projectileColor
	light.Brightness = if stats.isUltimate then 4 else 2.8
	light.Range = if stats.isUltimate then 20 else 14
	light.Parent = part

	local frontAttachment = Instance.new("Attachment")
	frontAttachment.Name = "Front"
	frontAttachment.Position = Vector3.new(0, 0, -part.Size.Z * 0.45)
	frontAttachment.Parent = part

	local backAttachment = Instance.new("Attachment")
	backAttachment.Name = "Back"
	backAttachment.Position = Vector3.new(0, 0, part.Size.Z * 0.45)
	backAttachment.Parent = part

	local trail = Instance.new("Trail")
	trail.Attachment0 = backAttachment
	trail.Attachment1 = frontAttachment
	trail.Color = ColorSequence.new(stats.projectileColor, stats.projectileColor:Lerp(Color3.new(1, 1, 1), 0.5))
	trail.LightEmission = 1
	trail.Lifetime = if stats.isUltimate then 0.35 else 0.22
	trail.MinLength = 0.05
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = part

	createSparkEmitter(part, stats.projectileColor, if stats.isUltimate then 70 else 45, NumberRange.new(0.12, 0.28))
end

local function spawnImpactBurst(position: Vector3, color: Color3)
	local burst = Instance.new("Part")
	burst.Name = "SpellImpactBurst"
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanQuery = false
	burst.CanTouch = false
	burst.Material = Enum.Material.Neon
	burst.Color = color
	burst.Size = Vector3.new(2.4, 2.4, 2.4)
	burst.Transparency = 0.35
	burst.CFrame = CFrame.new(position)
	burst.Parent = getProjectileFolder()

	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 5
	light.Range = 16
	light.Parent = burst

	local emitter = createSparkEmitter(burst, color, 120, NumberRange.new(0.2, 0.45))
	emitter.Speed = NumberRange.new(8, 18)
	emitter:Emit(24)

	task.delay(0.35, function()
		emitter.Enabled = false
		task.delay(0.4, function()
			burst:Destroy()
		end)
	end)
end

local function spawnNovaBurst(center: Vector3, radius: number, color: Color3, isUltimate: boolean)
	local ring = Instance.new("Part")
	ring.Name = "SpellNovaRing"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Size = Vector3.new(radius * 0.35, 0.35, radius * 0.35)
	ring.Transparency = 0.25
	ring.CFrame = CFrame.new(center)
	ring.Parent = getProjectileFolder()

	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = if isUltimate then 6 else 4
	light.Range = radius * 1.2
	light.Parent = ring

	local emitter = createSparkEmitter(ring, color, 0, NumberRange.new(0.35, 0.7))
	emitter.Speed = NumberRange.new(radius * 0.35, radius * 0.8)
	emitter:Emit(if isUltimate then 80 else 48)

	task.spawn(function()
		local startSize = ring.Size
		local endSize = Vector3.new(radius * 2.1, 0.2, radius * 2.1)
		for step = 1, 10 do
			local alpha = step / 10
			ring.Size = startSize:Lerp(endSize, alpha)
			ring.Transparency = 0.25 + alpha * 0.55
			task.wait(0.03)
		end
		ring:Destroy()
	end)
end

local function canDamageMonster(monster: Model, player: Player): boolean
	if monster.Name ~= "WaveMonster" then
		return false
	end

	local ownerId = monster:GetAttribute("DungeonOwner")
	if typeof(ownerId) == "number" and ownerId ~= player.UserId then
		return false
	end

	return true
end

local function applySpellDamage(player: Player, monster: Model, stats: SpellUpgradeConfig.EffectiveSpellStats)
	local humanoid = monster:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or not canDamageMonster(monster, player) then
		return
	end

	local damage = math.random(stats.damageMin, stats.damageMax)
	local modifiers = CardService.getModifiers(player)
	damage = math.max(1, math.floor(damage * modifiers.damageMult))
	CardService.applyLifesteal(player, damage)
	humanoid:TakeDamage(damage)
end

local function flattenLookVector(root: BasePart): Vector3
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return look.Unit
end

local function getMonsterRoot(monster: Model): BasePart?
	return monster.PrimaryPart or monster:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getProjectileDirection(player: Player, origin: Vector3, fallback: Vector3): Vector3
	local folder = getMonstersFolder()
	if not folder then
		return fallback
	end

	local closestDistance = PROJECTILE_TARGET_RANGE
	local targetPosition: Vector3? = nil

	for _, monster in folder:GetChildren() do
		if not monster:IsA("Model") or not canDamageMonster(monster, player) then
			continue
		end

		local humanoid = monster:FindFirstChildOfClass("Humanoid")
		local monsterRoot = getMonsterRoot(monster)
		if not humanoid or humanoid.Health <= 0 or not monsterRoot then
			continue
		end

		local distance = (monsterRoot.Position - origin).Magnitude
		if distance < closestDistance then
			closestDistance = distance
			targetPosition = monsterRoot.Position + Vector3.new(0, 1.2, 0)
		end
	end

	if targetPosition then
		local direction = targetPosition - origin
		if direction.Magnitude > 0.05 then
			return direction.Unit
		end
	end

	return fallback
end

local function spawnProjectile(
	player: Player,
	origin: Vector3,
	direction: Vector3,
	stats: SpellUpgradeConfig.EffectiveSpellStats
)
	if direction.Magnitude < 0.01 or stats.projectileSpeed <= 0 then
		return
	end

	local folder = getProjectileFolder()
	local part = Instance.new("Part")
	part.Name = "SpellProjectile"
	part.Size = stats.projectileSize
	part.Material = Enum.Material.Neon
	part.Color = stats.projectileColor
	part.CanCollide = false
	part.Anchored = false
	part.Massless = true
	part.CFrame = CFrame.lookAt(origin, origin + direction)
	part.Parent = folder

	decorateProjectile(part, stats)
	part.AssemblyLinearVelocity = direction.Unit * stats.projectileSpeed

	local hitMonsters: { [Model]: boolean } = {}
	local connection = part.Touched:Connect(function(hit)
		local monster = hit:FindFirstAncestorOfClass("Model")
		if not monster or hitMonsters[monster] or not canDamageMonster(monster, player) then
			return
		end

		hitMonsters[monster] = true
		spawnImpactBurst(part.Position, stats.projectileColor)
		applySpellDamage(player, monster, stats)
	end)

	task.delay(PROJECTILE_LIFETIME, function()
		connection:Disconnect()
		part:Destroy()
	end)
end

local function fireProjectileSpell(player: Player, stats: SpellUpgradeConfig.EffectiveSpellStats)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local fallbackDirection = flattenLookVector(root)
	local count = if stats.isUltimate then 2 else 1
	for index = 0, count - 1 do
		local origin = root.Position + Vector3.new(0, 1.2, 0) + fallbackDirection * (1.5 + index * 1.2)
		local direction = getProjectileDirection(player, origin, fallbackDirection)
		spawnProjectile(player, origin, direction, stats)
	end
end

local function castFrostNova(player: Player, stats: SpellUpgradeConfig.EffectiveSpellStats)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local look = flattenLookVector(root)
	local center = root.Position + look * 5
	local radius = stats.aoeRadius or 10
	spawnNovaBurst(center, radius, stats.projectileColor, stats.isUltimate)
	local folder = getMonstersFolder()
	if not folder then
		return
	end

	for _, monster in folder:GetChildren() do
		if monster:IsA("Model") then
			local monsterRoot = getMonsterRoot(monster)
			if monsterRoot and (monsterRoot.Position - center).Magnitude <= radius then
				applySpellDamage(player, monster, stats)
			end
		end
	end
end

local function notifyCastEffect(player: Player, spellId: string, stats: SpellUpgradeConfig.EffectiveSpellStats)
	getSpellCastEffectEvent():FireClient(player, spellId, stats.resolvedName, stats.projectileColor)
end

local function notifyLoadout(player: Player)
	getSpellLoadoutUpdatedEvent():FireClient(
		player,
		PlayerDataService.getInfusedSpell(player),
		GamePhaseService.isLoadoutLocked(player)
	)
end

function SpellService.refreshPlayerLoadout(player: Player)
	if not isPlayerActive(player) then
		return
	end

	lastActiveCastAt[player] = nil
	notifyLoadout(player)
end

local function castInfusedSpell(player: Player, spellId: string): boolean
	local stats = getEffectiveStats(player, spellId)
	if (stats.aoeRadius or 0) > 0 then
		castFrostNova(player, stats)
	else
		fireProjectileSpell(player, stats)
	end
	notifyCastEffect(player, spellId, stats)
	return true
end

local function tryCastActiveSpell(player: Player): boolean
	if not isPlayerActive(player) or not GamePhaseService.isInDungeon(player) then
		return false
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return false
	end

	local spellId = PlayerDataService.getInfusedSpell(player)
	if spellId == "" or not PlayerDataService.ownsSpell(player, spellId) then
		return false
	end

	local stats = getEffectiveStats(player, spellId)
	local cooldown = stats.cooldown or 2
	local now = os.clock()
	local lastCast = lastActiveCastAt[player] or 0
	if now - lastCast < cooldown then
		return false
	end

	if not StaminaService.trySpend(player, stats.staminaCost) then
		return false
	end

	lastActiveCastAt[player] = now
	return castInfusedSpell(player, spellId)
end

function SpellService.infusePlayerSpell(player: Player, weaponId: string, spellId: string): boolean
	if not GamePhaseService.isInLobby(player) or GamePhaseService.isLoadoutLocked(player) then
		return false
	end

	local ok = PlayerDataService.tryInfuseWeapon(player, weaponId, spellId)
	if ok then
		notifyLoadout(player)
	end
	return ok
end

function SpellService.purgeWeaponInfusion(player: Player, weaponId: string): boolean
	if not GamePhaseService.isInLobby(player) or GamePhaseService.isLoadoutLocked(player) then
		return false
	end

	local ok = PlayerDataService.tryPurgeWeaponInfusion(player, weaponId)
	if ok then
		notifyLoadout(player)
	end
	return ok
end

function SpellService.upgradePlayerSpell(player: Player, spellId: string): boolean
	if not GamePhaseService.isInLobby(player) then
		return false
	end

	local ok = PlayerDataService.tryUpgradeSpell(player, spellId)
	return ok
end

function SpellService.unlockPlayerSpell(player: Player, spellId: string): boolean
	if not GamePhaseService.isInLobby(player) then
		return false
	end

	local ok = PlayerDataService.tryUnlockSpell(player, spellId)
	return ok
end

function SpellService.init()
	getInfuseSpellEvent()
	getPurgeWeaponInfusionEvent()
	getUpgradeSpellEvent()
	getUnlockSpellEvent()
	getCastSpellEvent()
	getSpellLoadoutUpdatedEvent()
	getSpellCastEffectEvent()

	getInfuseSpellEvent().OnServerEvent:Connect(function(player, weaponId: string, spellId: string)
		if typeof(weaponId) ~= "string" or typeof(spellId) ~= "string" then
			return
		end
		SpellService.infusePlayerSpell(player, weaponId, spellId)
	end)

	getPurgeWeaponInfusionEvent().OnServerEvent:Connect(function(player, weaponId: string)
		if typeof(weaponId) ~= "string" then
			return
		end
		SpellService.purgeWeaponInfusion(player, weaponId)
	end)

	getUpgradeSpellEvent().OnServerEvent:Connect(function(player, spellId: string)
		if typeof(spellId) ~= "string" then
			return
		end
		SpellService.upgradePlayerSpell(player, spellId)
	end)

	getUnlockSpellEvent().OnServerEvent:Connect(function(player, spellId: string)
		if typeof(spellId) ~= "string" then
			return
		end
		SpellService.unlockPlayerSpell(player, spellId)
	end)

	getCastSpellEvent().OnServerEvent:Connect(function(player)
		tryCastActiveSpell(player)
	end)

	for _, player in Players:GetPlayers() do
		notifyLoadout(player)
	end

	Players.PlayerAdded:Connect(function(player)
		task.defer(function()
			if isPlayerActive(player) then
				notifyLoadout(player)
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastActiveCastAt[player] = nil
	end)
end

return SpellService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">StaminaService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StaminaConfig = require(ReplicatedStorage.Shared.StaminaConfig)

local StaminaService = {}

local staminaByPlayer: { [Player]: number } = {}

local function syncStamina(player: Player)
	local stamina = staminaByPlayer[player] or StaminaConfig.MAX
	player:SetAttribute("Stamina", math.floor(stamina * 10) / 10)
	player:SetAttribute("MaxStamina", StaminaConfig.MAX)
end

function StaminaService.getStamina(player: Player): number
	return staminaByPlayer[player] or StaminaConfig.MAX
end

function StaminaService.canAfford(player: Player, amount: number): boolean
	if amount <= 0 then
		return true
	end
	return StaminaService.getStamina(player) >= amount
end

function StaminaService.trySpend(player: Player, amount: number): boolean
	if amount <= 0 then
		return true
	end

	local current = StaminaService.getStamina(player)
	if current < amount then
		return false
	end

	staminaByPlayer[player] = current - amount
	syncStamina(player)
	return true
end

function StaminaService.refill(player: Player)
	staminaByPlayer[player] = StaminaConfig.MAX
	syncStamina(player)
end

local function bindPlayer(player: Player)
	syncStamina(player)
	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			if player.Parent and player.Character == character then
				StaminaService.refill(player)
			end
		end)
	end)

	if player.Character then
		StaminaService.refill(player)
	end
end

function StaminaService.init()
	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end

	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		staminaByPlayer[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(StaminaConfig.REGEN_TICK_SECONDS)
			for _, player in Players:GetPlayers() do
				if not player.Parent then
					continue
				end

				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if not humanoid or humanoid.Health <= 0 then
					continue
				end

				local current = StaminaService.getStamina(player)
				if current >= StaminaConfig.MAX then
					continue
				end

				staminaByPlayer[player] = math.min(
					StaminaConfig.MAX,
					current + StaminaConfig.REGEN_PER_SECOND * StaminaConfig.REGEN_TICK_SECONDS
				)
				syncStamina(player)
			end
		end
	end)
end

return StaminaService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">TreasureChestService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local GrimoireConfig = require(ReplicatedStorage.Shared.GrimoireConfig)
local TreasureConfig = require(ReplicatedStorage.Shared.TreasureConfig)

local GamePhaseService = require(script.Parent.GamePhaseService)
local PlayerDataService = require(script.Parent.PlayerDataService)

local TreasureChestService = {}

export type PendingChest = {
	tierId: string,
	roomDepth: number,
}

export type ChestLoot = {
	tierId: string,
	tierName: string,
	gold: number,
	remainingChests: number,
	grimoireDropped: boolean,
	grimoireCount: number,
}

local runChests: { [Player]: { PendingChest } } = {}

local treasureChestAwardedEvent: RemoteEvent
local treasureChestStateEvent: RemoteEvent
local treasureChestOpenedEvent: RemoteEvent
local openTreasureChestEvent: RemoteEvent
local useGrimoireEvent: RemoteEvent
local grimoireUsedEvent: RemoteEvent

local function getTreasureChestAwardedEvent(): RemoteEvent
	if treasureChestAwardedEvent then
		return treasureChestAwardedEvent
	end

	treasureChestAwardedEvent = ReplicatedStorage:FindFirstChild("TreasureChestAwarded") :: RemoteEvent?
	if not treasureChestAwardedEvent then
		treasureChestAwardedEvent = Instance.new("RemoteEvent")
		treasureChestAwardedEvent.Name = "TreasureChestAwarded"
		treasureChestAwardedEvent.Parent = ReplicatedStorage
	end

	return treasureChestAwardedEvent
end

local function getTreasureChestStateEvent(): RemoteEvent
	if treasureChestStateEvent then
		return treasureChestStateEvent
	end

	treasureChestStateEvent = ReplicatedStorage:FindFirstChild("TreasureChestState") :: RemoteEvent?
	if not treasureChestStateEvent then
		treasureChestStateEvent = Instance.new("RemoteEvent")
		treasureChestStateEvent.Name = "TreasureChestState"
		treasureChestStateEvent.Parent = ReplicatedStorage
	end

	return treasureChestStateEvent
end

local function getTreasureChestOpenedEvent(): RemoteEvent
	if treasureChestOpenedEvent then
		return treasureChestOpenedEvent
	end

	treasureChestOpenedEvent = ReplicatedStorage:FindFirstChild("TreasureChestOpened") :: RemoteEvent?
	if not treasureChestOpenedEvent then
		treasureChestOpenedEvent = Instance.new("RemoteEvent")
		treasureChestOpenedEvent.Name = "TreasureChestOpened"
		treasureChestOpenedEvent.Parent = ReplicatedStorage
	end

	return treasureChestOpenedEvent
end

local function getOpenTreasureChestEvent(): RemoteEvent
	if openTreasureChestEvent then
		return openTreasureChestEvent
	end

	openTreasureChestEvent = ReplicatedStorage:FindFirstChild("OpenTreasureChest") :: RemoteEvent?
	if not openTreasureChestEvent then
		openTreasureChestEvent = Instance.new("RemoteEvent")
		openTreasureChestEvent.Name = "OpenTreasureChest"
		openTreasureChestEvent.Parent = ReplicatedStorage
	end

	return openTreasureChestEvent
end

local function getUseGrimoireEvent(): RemoteEvent
	if useGrimoireEvent then
		return useGrimoireEvent
	end

	useGrimoireEvent = ReplicatedStorage:FindFirstChild("UseGrimoire") :: RemoteEvent?
	if not useGrimoireEvent then
		useGrimoireEvent = Instance.new("RemoteEvent")
		useGrimoireEvent.Name = "UseGrimoire"
		useGrimoireEvent.Parent = ReplicatedStorage
	end

	return useGrimoireEvent
end

local function getGrimoireUsedEvent(): RemoteEvent
	if grimoireUsedEvent then
		return grimoireUsedEvent
	end

	grimoireUsedEvent = ReplicatedStorage:FindFirstChild("GrimoireUsed") :: RemoteEvent?
	if not grimoireUsedEvent then
		grimoireUsedEvent = Instance.new("RemoteEvent")
		grimoireUsedEvent.Name = "GrimoireUsed"
		grimoireUsedEvent.Parent = ReplicatedStorage
	end

	return grimoireUsedEvent
end

local function serializeChests(chests: { PendingChest }?)
	local payload: { { tierId: string, roomDepth: number, tierName: string } } = {}
	if not chests then
		return payload
	end

	for _, chest in chests do
		table.insert(payload, {
			tierId = chest.tierId,
			roomDepth = chest.roomDepth,
			tierName = TreasureConfig.getTier(chest.tierId).displayName,
		})
	end

	return payload
end

local function syncLobbyChests(player: Player)
	getTreasureChestStateEvent():FireClient(player, serializeChests(PlayerDataService.getLobbyChests(player)))
end

function TreasureChestService.getRunChestCount(player: Player): number
	local chests = runChests[player]
	return if chests then #chests else 0
end

function TreasureChestService.clearRunChests(player: Player)
	runChests[player] = nil
end

function TreasureChestService.awardRunChest(player: Player, tierId: string, roomDepth: number)
	if not runChests[player] then
		runChests[player] = {}
	end

	table.insert(runChests[player], {
		tierId = tierId,
		roomDepth = roomDepth,
	})

	local tier = TreasureConfig.getTier(tierId)
	getTreasureChestAwardedEvent():FireClient(player, {
		tierId = tierId,
		tierName = tier.displayName,
		roomDepth = roomDepth,
		runChestCount = #runChests[player],
	})
end

function TreasureChestService.transferRunChestsToLobby(player: Player)
	local earned = runChests[player]
	runChests[player] = nil

	if not earned or #earned == 0 then
		return
	end

	local chests = PlayerDataService.getLobbyChests(player)
	for _, chest in earned do
		table.insert(chests, chest)
	end
	PlayerDataService.setLobbyChests(player, chests)
	syncLobbyChests(player)
end

function TreasureChestService.openLobbyChest(player: Player, chestIndex: number): boolean
	if not GamePhaseService.isInLobby(player) then
		return false
	end

	local chests = PlayerDataService.getLobbyChests(player)
	if chestIndex < 1 or chestIndex > #chests then
		return false
	end

	local chest = table.remove(chests, chestIndex)
	if not chest then
		return false
	end

	PlayerDataService.setLobbyChests(player, chests)

	local tier = TreasureConfig.getTier(chest.tierId)
	local gold = TreasureConfig.rollGold(chest.tierId, chest.roomDepth)
	PlayerDataService.addGold(player, gold)

	local grimoireDropChance = GrimoireConfig.getChestDropChance(chest.tierId)
	local grimoireDropped = math.random() < grimoireDropChance
	if grimoireDropped then
		PlayerDataService.addGrimoire(player, 1)
	end

	local loot: ChestLoot = {
		tierId = chest.tierId,
		tierName = tier.displayName,
		gold = gold,
		remainingChests = if chests then #chests else 0,
		grimoireDropped = grimoireDropped,
		grimoireCount = PlayerDataService.getGrimoireCount(player),
	}

	syncLobbyChests(player)
	getTreasureChestOpenedEvent():FireClient(player, loot)
	return true
end

function TreasureChestService.useGrimoire(player: Player): boolean
	if not GamePhaseService.isInLobby(player) then
		return false
	end

	local ok, spellId, message = PlayerDataService.tryUseGrimoire(player)
	if not ok or not spellId or not message then
		return false
	end

	getGrimoireUsedEvent():FireClient(player, {
		spellId = spellId,
		message = message,
		grimoireCount = PlayerDataService.getGrimoireCount(player),
	})
	return true
end

function TreasureChestService.init()
	getTreasureChestAwardedEvent()
	getTreasureChestStateEvent()
	getTreasureChestOpenedEvent()
	getOpenTreasureChestEvent()
	getUseGrimoireEvent()
	getGrimoireUsedEvent()

	getOpenTreasureChestEvent().OnServerEvent:Connect(function(player, chestIndex: number)
		if typeof(chestIndex) ~= "number" then
			return
		end

		TreasureChestService.openLobbyChest(player, math.floor(chestIndex))
	end)

	getUseGrimoireEvent().OnServerEvent:Connect(function(player)
		TreasureChestService.useGrimoire(player)
	end)

	local function bindPlayer(player: Player)
		task.defer(function()
			syncLobbyChests(player)
		end)
	end

	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end

	Players.PlayerAdded:Connect(bindPlayer)

	Players.PlayerRemoving:Connect(function(player)
		runChests[player] = nil
	end)
end

return TreasureChestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">WaveService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local BossService = require(script.Parent.BossService)
local MonsterConfig = require(ReplicatedStorage.Shared.MonsterConfig)
local WaveConfig = require(ReplicatedStorage.Shared.WaveConfig)

local WaveService = {}

local activeMonsters: { Model } = {}
local lastAttackTimes: { [Model]: number } = {}
local attackingMonsters: { [Model]: boolean } = {}
local walkPhases: { [Model]: number } = {}
local monstersFolder: Folder
local waveStateEvent: RemoteEvent
local waveInProgress = false
local waveStatus = "idle"
local currentWave = 0
local waveSpawnTotal = 0
local interWaveScheduled = false
local waveTimeoutToken = 0
local aiRunning = false
local walkAnimRunning = false
local dungeonMode = false
local monsterDiedCallbacks: { (Model) -> () } = {}
WaveService.onPlayerDamagedCallback = nil

local WOLF_SCALE = WaveConfig.WOLF_SCALE

local function scaleVector(vector: Vector3): Vector3
	return vector * WOLF_SCALE
end

local function scaleOffset(offset: CFrame): CFrame
	return CFrame.new(scaleVector(offset.Position)) * (offset - offset.Position)
end

local FRONT_LEFT_LEG_REST = scaleOffset(CFrame.new(-0.38, -0.42, -0.68))
local FRONT_RIGHT_LEG_REST = scaleOffset(CFrame.new(0.38, -0.42, -0.68))
local BACK_LEFT_LEG_REST = scaleOffset(CFrame.new(-0.34, -0.42, 0.72))
local BACK_RIGHT_LEG_REST = scaleOffset(CFrame.new(0.34, -0.42, 0.72))
local NECK_REST = scaleOffset(CFrame.new(0, 0.28, -0.92) * CFrame.Angles(math.rad(-12), 0, 0))
local TAIL_REST = scaleOffset(CFrame.new(0, 0.08, 1.02) * CFrame.Angles(math.rad(28), 0, 0))

type WolfPalette = {
	fur: Color3,
	darkFur: Color3,
	belly: Color3,
	nose: Color3,
	eye: Color3,
}

local WOLF_PALETTES: { WolfPalette } = {
	{
		fur = Color3.fromRGB(118, 118, 128),
		darkFur = Color3.fromRGB(62, 62, 70),
		belly = Color3.fromRGB(176, 176, 184),
		nose = Color3.fromRGB(28, 28, 32),
		eye = Color3.fromRGB(255, 214, 96),
	},
	{
		fur = Color3.fromRGB(132, 92, 58),
		darkFur = Color3.fromRGB(78, 52, 34),
		belly = Color3.fromRGB(188, 156, 118),
		nose = Color3.fromRGB(32, 24, 20),
		eye = Color3.fromRGB(255, 208, 88),
	},
	{
		fur = Color3.fromRGB(48, 48, 56),
		darkFur = Color3.fromRGB(24, 24, 28),
		belly = Color3.fromRGB(92, 92, 100),
		nose = Color3.fromRGB(16, 16, 18),
		eye = Color3.fromRGB(255, 220, 110),
	},
}

local function weld(part0: BasePart, part1: BasePart)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = part0
	constraint.Part1 = part1
	constraint.Parent = part0
end

local function attachMotor(part0: BasePart, part1: BasePart, name: string, restOffset: CFrame): Motor6D
	local motor = Instance.new("Motor6D")
	motor.Name = name
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = restOffset
	motor.C1 = CFrame.new()
	motor.Parent = part0
	return motor
end

local function getNearestPlayerDistance(position: Vector3): number
	local nearestDistance = math.huge

	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if humanoidRootPart then
			nearestDistance = math.min(nearestDistance, (humanoidRootPart.Position - position).Magnitude)
		end
	end

	return nearestDistance
end

local function createPart(
	name: string,
	size: Vector3,
	color: Color3,
	parent: Instance,
	options: {
		material: Enum.Material?,
		canCollide: boolean?,
		massless: boolean?,
		shape: Enum.PartType?,
	}?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = if options and options.material then options.material else Enum.Material.SmoothPlastic
	part.CanCollide = if options and options.canCollide ~= nil then options.canCollide else false
	part.Massless = if options and options.massless ~= nil then options.massless else false
	if options and options.shape then
		part.Shape = options.shape
	end
	part.Anchored = false
	part.Parent = parent
	return part
end

local function scaledSize(size: Vector3): Vector3
	return scaleVector(size)
end

local function offset(position: Vector3): CFrame
	return CFrame.new(scaleVector(position))
end

local function broadcastWaveState()
	if waveStateEvent then
		local loadoutLocked = waveStatus == "fighting"
		waveStateEvent:FireAllClients(waveInProgress, #activeMonsters, waveSpawnTotal, currentWave, waveStatus, loadoutLocked)
	end
end

function WaveService.isLoadoutLocked(): boolean
	return waveStatus == "fighting"
end

local function cancelWaveTimeout()
	waveTimeoutToken += 1
end

local function startWaveTimeout()
	cancelWaveTimeout()
	local token = waveTimeoutToken

	task.delay(WaveConfig.WAVE_TIMEOUT, function()
		if token ~= waveTimeoutToken or not waveInProgress or waveStatus ~= "fighting" then
			return
		end

		for index = #activeMonsters, 1, -1 do
			local monster = activeMonsters[index]
			if monster.Parent then
				monster:Destroy()
			end
			table.remove(activeMonsters, index)
		end

		for _, child in monstersFolder:GetChildren() do
			if child:IsA("Model") and child.Name == "WaveMonster" then
				child:Destroy()
			end
		end

		onWaveCleared()
	end)
end

local function onWaveCleared()
	if dungeonMode then
		return
	end

	if interWaveScheduled then
		return
	end

	cancelWaveTimeout()
	waveInProgress = false
	waveStatus = "intermission"
	interWaveScheduled = true
	broadcastWaveState()

	task.delay(WaveConfig.INTER_WAVE_DELAY, function()
		interWaveScheduled = false
		WaveService.startWave()
	end)
end

local function checkWaveComplete()
	if not waveInProgress or waveStatus ~= "fighting" then
		broadcastWaveState()
		return
	end

	if waveSpawnTotal > 0 and #activeMonsters <= 0 then
		onWaveCleared()
	else
		broadcastWaveState()
	end
end

local function onMonsterDiedInternal(model: Model)
	lastAttackTimes[model] = nil
	attackingMonsters[model] = nil
	walkPhases[model] = nil
	BossService.cleanup(model)

	local index = table.find(activeMonsters, model)
	if index then
		table.remove(activeMonsters, index)
	end

	for _, callback in monsterDiedCallbacks do
		callback(model)
	end

	checkWaveComplete()

	local headPart = model:FindFirstChild("Head")
	local healthBar = headPart and headPart:FindFirstChild("HealthBar")
	if healthBar then
		healthBar:Destroy()
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
		end
	end

	task.delay(1.2, function()
		if model.Parent then
			model:Destroy()
		end
	end)
end

local function registerMonster(model: Model)
	table.insert(activeMonsters, model)
	lastAttackTimes[model] = 0
	walkPhases[model] = 0

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			onMonsterDiedInternal(model)
		end)
	end
end

local function keepMonsterUpright(root: BasePart)
	local lookVector = root.CFrame.LookVector
	local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
	if flatLook.Magnitude < 0.05 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end

	root.CFrame = CFrame.new(root.Position, root.Position + flatLook)
	root.AssemblyAngularVelocity = Vector3.zero
end

local function configureStableHumanoid(humanoid: Humanoid)
	humanoid.AutoRotate = true
	humanoid.BreakJointsOnDeath = false

	for _, state in {
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Physics,
	} do
		pcall(function()
			humanoid:SetStateEnabled(state, false)
		end)
	end
end

function WaveService.createMonster(spawnPosition: Vector3, monsterTypeId: string?, roomDepth: number?): Model
	local depth = roomDepth or 1
	local typeId = monsterTypeId or "Wolf"
	local baseType = MonsterConfig.getType(typeId)
	local stats = MonsterConfig.getScaledStats(baseType, depth)
	local monsterScale = WaveConfig.WOLF_SCALE * stats.scaleMult

	local function scaleVector(vector: Vector3): Vector3
		return vector * monsterScale
	end

	local function scaleOffset(offset: CFrame): CFrame
		return CFrame.new(scaleVector(offset.Position)) * (offset - offset.Position)
	end

	local function scaledSize(size: Vector3): Vector3
		return scaleVector(size)
	end

	local function offset(position: Vector3): CFrame
		return CFrame.new(scaleVector(position))
	end

	local FRONT_LEFT_LEG_REST = scaleOffset(CFrame.new(-0.38, -0.42, -0.68))
	local FRONT_RIGHT_LEG_REST = scaleOffset(CFrame.new(0.38, -0.42, -0.68))
	local BACK_LEFT_LEG_REST = scaleOffset(CFrame.new(-0.34, -0.42, 0.72))
	local BACK_RIGHT_LEG_REST = scaleOffset(CFrame.new(0.34, -0.42, 0.72))
	local NECK_REST = scaleOffset(CFrame.new(0, 0.28, -0.92) * CFrame.Angles(math.rad(-12), 0, 0))
	local TAIL_REST = scaleOffset(CFrame.new(0, 0.08, 1.02) * CFrame.Angles(math.rad(28), 0, 0))

	local palette = if stats.paletteIndex
		then WOLF_PALETTES[stats.paletteIndex]
		else WOLF_PALETTES[math.random(1, #WOLF_PALETTES)]
	local model = Instance.new("Model")
	model.Name = "WaveMonster"

	local humanoidRootPart = createPart("HumanoidRootPart", scaledSize(Vector3.new(1.1, 0.65, 1.45)), palette.fur, model, {
		canCollide = false,
		massless = true,
	})
	humanoidRootPart.Transparency = 1

	local body = createPart("Body", scaledSize(Vector3.new(1.12, 0.78, 2.05)), palette.fur, model)
	local chest = createPart("Chest", scaledSize(Vector3.new(0.95, 0.72, 0.82)), palette.fur, model)
	local belly = createPart("Belly", scaledSize(Vector3.new(0.88, 0.18, 1.45)), palette.belly, model, { massless = true })
	local haunch = createPart("Haunch", scaledSize(Vector3.new(1.02, 0.68, 0.72)), palette.darkFur, model)
	local leftPlate: Part? = nil
	local rightPlate: Part? = nil
	if stats.isArmored then
		leftPlate = createPart("LeftPlate", scaledSize(Vector3.new(0.22, 0.42, 0.62)), Color3.fromRGB(88, 92, 98), model, {
			material = Enum.Material.Metal,
			massless = true,
		})
		rightPlate = createPart("RightPlate", scaledSize(Vector3.new(0.22, 0.42, 0.62)), Color3.fromRGB(88, 92, 98), model, {
			material = Enum.Material.Metal,
			massless = true,
		})
	end

	local head = createPart("Head", scaledSize(Vector3.new(0.68, 0.62, 0.78)), palette.fur, model)
	local snout = createPart("Snout", scaledSize(Vector3.new(0.42, 0.36, 0.72)), palette.fur, model, { massless = true })
	local nose = createPart("Nose", scaledSize(Vector3.new(0.18, 0.12, 0.12)), palette.nose, model, { massless = true })
	local leftEar = createPart("LeftEar", scaledSize(Vector3.new(0.16, 0.34, 0.18)), palette.darkFur, model, { massless = true })
	local rightEar = createPart("RightEar", scaledSize(Vector3.new(0.16, 0.34, 0.18)), palette.darkFur, model, { massless = true })
	local leftEye = createPart("LeftEye", scaledSize(Vector3.new(0.12, 0.12, 0.08)), palette.eye, model, {
		massless = true,
		material = Enum.Material.Neon,
	})
	local rightEye = createPart("RightEye", scaledSize(Vector3.new(0.12, 0.12, 0.08)), palette.eye, model, {
		massless = true,
		material = Enum.Material.Neon,
	})

	local frontLeftLeg = createPart("FrontLeftLeg", scaledSize(Vector3.new(0.28, 0.88, 0.28)), palette.darkFur, model, {
		canCollide = true,
	})
	local frontRightLeg = createPart("FrontRightLeg", scaledSize(Vector3.new(0.28, 0.88, 0.28)), palette.darkFur, model, {
		canCollide = true,
	})
	local backLeftLeg = createPart("BackLeftLeg", scaledSize(Vector3.new(0.28, 0.92, 0.3)), palette.darkFur, model, {
		canCollide = true,
	})
	local backRightLeg = createPart("BackRightLeg", scaledSize(Vector3.new(0.28, 0.92, 0.3)), palette.darkFur, model, {
		canCollide = true,
	})

	local frontLeftPaw = createPart("FrontLeftPaw", scaledSize(Vector3.new(0.32, 0.12, 0.36)), palette.nose, model, {
		massless = true,
	})
	local frontRightPaw = createPart("FrontRightPaw", scaledSize(Vector3.new(0.32, 0.12, 0.36)), palette.nose, model, {
		massless = true,
	})
	local backLeftPaw = createPart("BackLeftPaw", scaledSize(Vector3.new(0.34, 0.12, 0.38)), palette.nose, model, {
		massless = true,
	})
	local backRightPaw = createPart("BackRightPaw", scaledSize(Vector3.new(0.34, 0.12, 0.38)), palette.nose, model, {
		massless = true,
	})

	local tail = createPart("Tail", scaledSize(Vector3.new(0.22, 0.22, 0.82)), palette.fur, model, { massless = true })
	local tailTip = createPart("TailTip", scaledSize(Vector3.new(0.18, 0.18, 0.42)), palette.darkFur, model, { massless = true })
	local biteHitbox = createPart("BiteHitbox", scaledSize(Vector3.new(0.55, 0.42, 0.65)), palette.fur, model, {
		massless = true,
	})
	biteHitbox.Transparency = 1

	local rootCFrame = CFrame.new(spawnPosition)
	humanoidRootPart.CFrame = rootCFrame

	body.CFrame = rootCFrame
	if leftPlate and rightPlate then
		leftPlate.CFrame = body.CFrame * offset(Vector3.new(-0.58, 0.12, -0.08))
		rightPlate.CFrame = body.CFrame * offset(Vector3.new(0.58, 0.12, -0.08))
		weld(body, leftPlate)
		weld(body, rightPlate)
	end
	chest.CFrame = rootCFrame * offset(Vector3.new(0, 0.08, -0.72))
	belly.CFrame = rootCFrame * offset(Vector3.new(0, -0.28, 0.02))
	haunch.CFrame = rootCFrame * offset(Vector3.new(0, 0.04, 0.78))
	head.CFrame = rootCFrame * offset(Vector3.new(0, 0.34, -1.02))
	snout.CFrame = rootCFrame * offset(Vector3.new(0, 0.18, -1.42))
	nose.CFrame = rootCFrame * offset(Vector3.new(0, 0.12, -1.78))
	leftEar.CFrame = rootCFrame * offset(Vector3.new(-0.24, 0.58, -1.08)) * CFrame.Angles(0, 0, math.rad(18))
	rightEar.CFrame = rootCFrame * offset(Vector3.new(0.24, 0.58, -1.08)) * CFrame.Angles(0, 0, math.rad(-18))
	leftEye.CFrame = rootCFrame * offset(Vector3.new(-0.18, 0.36, -1.28))
	rightEye.CFrame = rootCFrame * offset(Vector3.new(0.18, 0.36, -1.28))
	frontLeftLeg.CFrame = rootCFrame * FRONT_LEFT_LEG_REST
	frontRightLeg.CFrame = rootCFrame * FRONT_RIGHT_LEG_REST
	backLeftLeg.CFrame = rootCFrame * BACK_LEFT_LEG_REST
	backRightLeg.CFrame = rootCFrame * BACK_RIGHT_LEG_REST
	frontLeftPaw.CFrame = frontLeftLeg.CFrame * offset(Vector3.new(0, -0.48, -0.04))
	frontRightPaw.CFrame = frontRightLeg.CFrame * offset(Vector3.new(0, -0.48, -0.04))
	backLeftPaw.CFrame = backLeftLeg.CFrame * offset(Vector3.new(0, -0.5, 0.02))
	backRightPaw.CFrame = backRightLeg.CFrame * offset(Vector3.new(0, -0.5, 0.02))
	tail.CFrame = rootCFrame * TAIL_REST
	tailTip.CFrame = tail.CFrame * offset(Vector3.new(0, 0.04, 0.58))
	biteHitbox.CFrame = snout.CFrame * offset(Vector3.new(0, -0.02, -0.18))

	weld(humanoidRootPart, body)
	weld(body, chest)
	weld(body, belly)
	weld(body, haunch)
	weld(head, snout)
	weld(snout, nose)
	weld(snout, biteHitbox)
	weld(head, leftEar)
	weld(head, rightEar)
	weld(head, leftEye)
	weld(head, rightEye)
	weld(frontLeftLeg, frontLeftPaw)
	weld(frontRightLeg, frontRightPaw)
	weld(backLeftLeg, backLeftPaw)
	weld(backRightLeg, backRightPaw)
	weld(tail, tailTip)

	local neckMotor = attachMotor(body, head, "NeckMotor", NECK_REST)
	local tailMotor = attachMotor(body, tail, "TailMotor", TAIL_REST)
	local frontLeftLegMotor = attachMotor(humanoidRootPart, frontLeftLeg, "FrontLeftLegMotor", FRONT_LEFT_LEG_REST)
	local frontRightLegMotor = attachMotor(humanoidRootPart, frontRightLeg, "FrontRightLegMotor", FRONT_RIGHT_LEG_REST)
	local backLeftLegMotor = attachMotor(humanoidRootPart, backLeftLeg, "BackLeftLegMotor", BACK_LEFT_LEG_REST)
	local backRightLegMotor = attachMotor(humanoidRootPart, backRightLeg, "BackRightLegMotor", BACK_RIGHT_LEG_REST)

	local humanoid = Instance.new("Humanoid")
	humanoid.WalkSpeed = stats.walkSpeed
	humanoid.HipHeight = WaveConfig.MONSTER_HIP_HEIGHT * stats.scaleMult
	humanoid.MaxHealth = stats.health
	humanoid.Health = stats.health
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	configureStableHumanoid(humanoid)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HealthBar"
	billboard.Size = UDim2.fromOffset(72, 10)
	billboard.StudsOffset = Vector3.new(0, 1.35 * monsterScale, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.Parent = head

	local background = Instance.new("Frame")
	background.Name = "Background"
	background.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	background.BorderSizePixel = 0
	background.Size = UDim2.fromScale(1, 1)
	background.Parent = billboard

	local backgroundStroke = Instance.new("UIStroke")
	backgroundStroke.Color = Color3.fromRGB(0, 0, 0)
	backgroundStroke.Thickness = 1
	backgroundStroke.Parent = background

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = background

	local function updateHealthBar()
		local ratio = if humanoid.MaxHealth > 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
		fill.Size = UDim2.new(ratio, 0, 1, 0)

		local distance = getNearestPlayerDistance(humanoidRootPart.Position)
		local hasTakenDamage = humanoid.Health < humanoid.MaxHealth
		billboard.Enabled = hasTakenDamage and distance <= WaveConfig.MONSTER_HEALTHBAR_DISTANCE
	end

	humanoid.HealthChanged:Connect(updateHealthBar)
	updateHealthBar()

	model:SetAttribute("MonsterType", stats.id)
	model:SetAttribute("MonsterDamage", stats.damage)
	model:SetAttribute("AttackRange", stats.attackRange)
	model:SetAttribute("AttackCooldown", stats.attackCooldown)
	model:SetAttribute("MonsterScale", monsterScale)
	model:SetAttribute("NeckRest", NECK_REST)
	model:SetAttribute("TailRest", TAIL_REST)
	model:SetAttribute("FrontLeftLegRest", FRONT_LEFT_LEG_REST)
	model:SetAttribute("FrontRightLegRest", FRONT_RIGHT_LEG_REST)
	model:SetAttribute("BackLeftLegRest", BACK_LEFT_LEG_REST)
	model:SetAttribute("BackRightLegRest", BACK_RIGHT_LEG_REST)
	model:SetAttribute("NeckMotorName", neckMotor.Name)
	model:SetAttribute("TailMotorName", tailMotor.Name)
	model:SetAttribute("FrontLeftLegMotorName", frontLeftLegMotor.Name)
	model:SetAttribute("FrontRightLegMotorName", frontRightLegMotor.Name)
	model:SetAttribute("BackLeftLegMotorName", backLeftLegMotor.Name)
	model:SetAttribute("BackRightLegMotorName", backRightLegMotor.Name)

	model.PrimaryPart = humanoidRootPart
	model:PivotTo(rootCFrame)
	model.Parent = monstersFolder
	registerMonster(model)

	return model
end

local function getSpawnPosition(radiusMin: number?, radiusMax: number?): Vector3
	local angle = math.random() * math.pi * 2
	local minRadius = radiusMin or WaveConfig.SPAWN_RADIUS_MIN
	local maxRadius = radiusMax or WaveConfig.SPAWN_RADIUS_MAX
	local radius = math.random(minRadius, maxRadius)
	local x = math.cos(angle) * radius
	local z = math.sin(angle) * radius
	return Vector3.new(x, WaveConfig.SPAWN_HEIGHT, z)
end

local function getNearestPlayerCharacter(monster: Model): Model?
	local root = monster.PrimaryPart
	if not root then
		return nil
	end

	local ownerUserId = monster:GetAttribute("DungeonOwner")
	if typeof(ownerUserId) == "number" then
		local owner = Players:GetPlayerByUserId(ownerUserId)
		local character = owner and owner.Character
		local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoidRootPart and humanoid and humanoid.Health > 0 then
			return character
		end
		return nil
	end

	local nearestCharacter: Model? = nil
	local nearestDistance = math.huge

	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoidRootPart and humanoid and humanoid.Health > 0 then
			local distance = (humanoidRootPart.Position - root.Position).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestCharacter = character
			end
		end
	end

	return nearestCharacter
end

local function getMotor(root: BasePart, monster: Model, attributeName: string): Motor6D?
	return root:FindFirstChild(monster:GetAttribute(attributeName) :: string) :: Motor6D?
end

local function getMonsterAttackParts(monster: Model): { BasePart }
	local parts: { BasePart } = {}
	for _, name in { "BiteHitbox", "Snout", "Head" } do
		local part = monster:FindFirstChild(name, true) :: BasePart?
		if part then
			table.insert(parts, part)
		end
	end
	return parts
end

local function tryDamagePlayerFromAttack(monster: Model, target: Model): boolean
	local targetHumanoid = target:FindFirstChildOfClass("Humanoid")
	if not targetHumanoid or targetHumanoid.Health <= 0 then
		return false
	end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Include
	overlapParams.FilterDescendantsInstances = { target }

	local hitScale = WaveConfig.MONSTER_ATTACK_HITBOX_SCALE
	local damage = monster:GetAttribute("MonsterDamage") or WaveConfig.MONSTER_DAMAGE
	for _, hitPart in getMonsterAttackParts(monster) do
		local hits = workspace:GetPartBoundsInBox(hitPart.CFrame, hitPart.Size * hitScale, overlapParams)
		if #hits > 0 then
			targetHumanoid:TakeDamage(damage)
			local targetPlayer = Players:GetPlayerFromCharacter(target)
			if targetPlayer and WaveService.onPlayerDamagedCallback then
				WaveService.onPlayerDamagedCallback(targetPlayer)
			end
			return true
		end
	end

	return false
end

local function getMonsterRestCFrames(monster: Model): {
	neck: CFrame,
	tail: CFrame,
	frontLeftLeg: CFrame,
	frontRightLeg: CFrame,
	backLeftLeg: CFrame,
	backRightLeg: CFrame,
	scale: number,
}
	local scale = monster:GetAttribute("MonsterScale") or WOLF_SCALE
	return {
		neck = monster:GetAttribute("NeckRest") or NECK_REST,
		tail = monster:GetAttribute("TailRest") or TAIL_REST,
		frontLeftLeg = monster:GetAttribute("FrontLeftLegRest") or FRONT_LEFT_LEG_REST,
		frontRightLeg = monster:GetAttribute("FrontRightLegRest") or FRONT_RIGHT_LEG_REST,
		backLeftLeg = monster:GetAttribute("BackLeftLegRest") or BACK_LEFT_LEG_REST,
		backRightLeg = monster:GetAttribute("BackRightLegRest") or BACK_RIGHT_LEG_REST,
		scale = scale,
	}
end

local function playAttackAnimation(monster: Model, target: Model): boolean
	if attackingMonsters[monster] then
		return false
	end

	local root = monster.PrimaryPart
	local body = monster:FindFirstChild("Body") :: BasePart?
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not body or not targetRoot then
		return false
	end

	local neckMotor = getMotor(body, monster, "NeckMotorName")
	local tailMotor = getMotor(body, monster, "TailMotorName")
	local frontLeftLegMotor = getMotor(root, monster, "FrontLeftLegMotorName")
	local frontRightLegMotor = getMotor(root, monster, "FrontRightLegMotorName")
	local backLeftLegMotor = getMotor(root, monster, "BackLeftLegMotorName")
	local backRightLegMotor = getMotor(root, monster, "BackRightLegMotorName")

	if not neckMotor or not tailMotor or not frontLeftLegMotor or not frontRightLegMotor or not backLeftLegMotor or not backRightLegMotor then
		return false
	end

	attackingMonsters[monster] = true

	local rests = getMonsterRestCFrames(monster)
	local startCFrame = root.CFrame
	local direction = (targetRoot.Position - root.Position).Unit
	local lungeTarget = CFrame.lookAt(
		startCFrame.Position + direction * (1.35 * rests.scale) + Vector3.new(0, 0.08, 0),
		Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
	)

	local neckCrouch = rests.neck * CFrame.Angles(math.rad(18), 0, 0)
	local neckBite = rests.neck * CFrame.new(0, -0.08 * rests.scale, -0.22 * rests.scale) * CFrame.Angles(math.rad(42), 0, 0)
	local tailRaise = rests.tail * CFrame.Angles(math.rad(-24), 0, 0)
	local haunchCompress = CFrame.new(0, 0.08 * rests.scale, 0.06 * rests.scale) * CFrame.Angles(math.rad(28), 0, 0)
	local frontExtend = CFrame.new(0, -0.06 * rests.scale, -0.12 * rests.scale) * CFrame.Angles(math.rad(-24), 0, 0)
	local didDamage = false

	task.spawn(function()
		for step = 1, 3 do
			if not monster.Parent then
				break
			end
			local alpha = step / 3
			root.CFrame = startCFrame:Lerp(lungeTarget, alpha * 0.35)
			neckMotor.C0 = rests.neck:Lerp(neckCrouch, alpha)
			tailMotor.C0 = rests.tail:Lerp(tailRaise, alpha)
			backLeftLegMotor.C0 = rests.backLeftLeg:Lerp(rests.backLeftLeg * haunchCompress, alpha)
			backRightLegMotor.C0 = rests.backRightLeg:Lerp(rests.backRightLeg * haunchCompress, alpha)
			task.wait(0.035)
		end

		for step = 1, 4 do
			if not monster.Parent then
				break
			end
			local alpha = step / 4
			root.CFrame = startCFrame:Lerp(lungeTarget, 0.35 + alpha * 0.65)
			neckMotor.C0 = neckCrouch:Lerp(neckBite, alpha)
			frontLeftLegMotor.C0 = rests.frontLeftLeg:Lerp(rests.frontLeftLeg * frontExtend, alpha)
			frontRightLegMotor.C0 = rests.frontRightLeg:Lerp(rests.frontRightLeg * frontExtend, alpha)
			backLeftLegMotor.C0 = rests.backLeftLeg * haunchCompress:Lerp(rests.backLeftLeg, alpha)
			backRightLegMotor.C0 = rests.backRightLeg * haunchCompress:Lerp(rests.backRightLeg, alpha)

			if step >= 3 and not didDamage then
				didDamage = tryDamagePlayerFromAttack(monster, target)
			end

			task.wait(0.03)
		end

		if not didDamage then
			didDamage = tryDamagePlayerFromAttack(monster, target)
		end

		task.wait(0.04)

		for step = 1, 5 do
			if not monster.Parent then
				break
			end
			local alpha = step / 5
			root.CFrame = lungeTarget:Lerp(startCFrame, alpha)
			neckMotor.C0 = neckBite:Lerp(rests.neck, alpha)
			tailMotor.C0 = tailRaise:Lerp(rests.tail, alpha)
			frontLeftLegMotor.C0 = (rests.frontLeftLeg * frontExtend):Lerp(rests.frontLeftLeg, alpha)
			frontRightLegMotor.C0 = (rests.frontRightLeg * frontExtend):Lerp(rests.frontRightLeg, alpha)
			backLeftLegMotor.C0 = rests.backLeftLeg
			backRightLegMotor.C0 = rests.backRightLeg
			task.wait(0.03)
		end

		neckMotor.C0 = rests.neck
		tailMotor.C0 = rests.tail
		frontLeftLegMotor.C0 = rests.frontLeftLeg
		frontRightLegMotor.C0 = rests.frontRightLeg
		backLeftLegMotor.C0 = rests.backLeftLeg
		backRightLegMotor.C0 = rests.backRightLeg
		attackingMonsters[monster] = nil
	end)

	return true
end

local function tryAttack(monster: Model, target: Model)
	if BossService.isBoss(monster) then
		return
	end

	local now = os.clock()
	local lastAttack = lastAttackTimes[monster] or 0
	local attackCooldown = monster:GetAttribute("AttackCooldown") or WaveConfig.ATTACK_COOLDOWN
	if now - lastAttack < attackCooldown then
		return
	end

	local monsterRoot = monster.PrimaryPart
	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	local targetHumanoid = target:FindFirstChildOfClass("Humanoid")

	if not monsterRoot or not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
		return
	end

	local attackRange = monster:GetAttribute("AttackRange") or WaveConfig.ATTACK_RANGE
	if (monsterRoot.Position - targetRoot.Position).Magnitude > attackRange then
		return
	end

	lastAttackTimes[monster] = now
	playAttackAnimation(monster, target)
end

local function updateMonster(monster: Model)
	if not monster.Parent then
		return
	end

	local humanoid = monster:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local target = getNearestPlayerCharacter(monster)
	if not target then
		return
	end

	local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not targetRoot then
		return
	end

	local monsterRoot = monster.PrimaryPart
	if not monsterRoot then
		return
	end

	tryAttack(monster, target)

	local head = monster:FindFirstChild("Head")
	local billboard = head and head:FindFirstChild("HealthBar") :: BillboardGui?
	if billboard then
		local distance = getNearestPlayerDistance(monsterRoot.Position)
		local hasTakenDamage = humanoid.Health < humanoid.MaxHealth
		billboard.Enabled = hasTakenDamage and distance <= WaveConfig.MONSTER_HEALTHBAR_DISTANCE
	end

	if BossService.isBoss(monster) then
		BossService.updateBoss(monster, target)
		if not BossService.isBusy(monster) then
			local attackRange = monster:GetAttribute("AttackRange") or WaveConfig.ATTACK_RANGE
			if (monsterRoot.Position - targetRoot.Position).Magnitude > attackRange then
				humanoid:MoveTo(targetRoot.Position)
			end
		end
		return
	end

	if (monsterRoot.Position - targetRoot.Position).Magnitude > (monster:GetAttribute("AttackRange") or WaveConfig.ATTACK_RANGE)
		and not attackingMonsters[monster]
	then
		humanoid:MoveTo(targetRoot.Position)
	end
end

local function updateMonsterWalkAnimation(monster: Model, deltaTime: number)
	local humanoid = monster:FindFirstChildOfClass("Humanoid")
	local root = monster.PrimaryPart
	local body = monster:FindFirstChild("Body") :: BasePart?
	if not humanoid or not root or not body or humanoid.Health <= 0 then
		return
	end

	local neckMotor = getMotor(body, monster, "NeckMotorName")
	local tailMotor = getMotor(body, monster, "TailMotorName")
	local frontLeftLegMotor = getMotor(root, monster, "FrontLeftLegMotorName")
	local frontRightLegMotor = getMotor(root, monster, "FrontRightLegMotorName")
	local backLeftLegMotor = getMotor(root, monster, "BackLeftLegMotorName")
	local backRightLegMotor = getMotor(root, monster, "BackRightLegMotorName")

	if not neckMotor or not tailMotor or not frontLeftLegMotor or not frontRightLegMotor or not backLeftLegMotor or not backRightLegMotor then
		return
	end

	if attackingMonsters[monster] or BossService.isBusy(monster) then
		return
	end

	local rests = getMonsterRestCFrames(monster)
	local velocity = root.AssemblyLinearVelocity
	local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local moving = horizontalSpeed > 1 or humanoid.MoveDirection.Magnitude > 0.05
	local phase = walkPhases[monster] or 0

	if moving then
		phase += deltaTime * WaveConfig.MONSTER_WALK_ANIM_SPEED
		walkPhases[monster] = phase

		local stride = math.sin(phase) * WaveConfig.MONSTER_LEG_SWING
		local oppositeStride = math.sin(phase + math.pi) * WaveConfig.MONSTER_LEG_SWING
		local bodyBob = math.abs(math.sin(phase)) * WaveConfig.MONSTER_BODY_BOB
		local headBob = math.sin(phase * 2) * WaveConfig.MONSTER_HEAD_BOB
		local tailSway = math.sin(phase) * WaveConfig.MONSTER_TAIL_SWING

		frontLeftLegMotor.C0 = rests.frontLeftLeg
			* CFrame.new(0, bodyBob * 0.12, stride * 0.14)
			* CFrame.Angles(stride, 0, stride * 0.18)
		backRightLegMotor.C0 = rests.backRightLeg
			* CFrame.new(0, bodyBob * 0.12, stride * 0.12)
			* CFrame.Angles(stride, 0, -stride * 0.12)
		frontRightLegMotor.C0 = rests.frontRightLeg
			* CFrame.new(0, bodyBob * 0.12, oppositeStride * 0.14)
			* CFrame.Angles(oppositeStride, 0, -oppositeStride * 0.18)
		backLeftLegMotor.C0 = rests.backLeftLeg
			* CFrame.new(0, bodyBob * 0.12, oppositeStride * 0.12)
			* CFrame.Angles(oppositeStride, 0, oppositeStride * 0.12)

		neckMotor.C0 = rests.neck * CFrame.Angles(headBob, 0, 0)
		tailMotor.C0 = rests.tail * CFrame.Angles(math.rad(-tailSway * 28), math.rad(tailSway * 18), 0)
	else
		walkPhases[monster] = phase
		frontLeftLegMotor.C0 = rests.frontLeftLeg
		frontRightLegMotor.C0 = rests.frontRightLeg
		backLeftLegMotor.C0 = rests.backLeftLeg
		backRightLegMotor.C0 = rests.backRightLeg
		neckMotor.C0 = rests.neck
		tailMotor.C0 = rests.tail * CFrame.Angles(0, 0, math.rad(math.sin(phase) * 4))
	end
end

local function runWalkAnimation()
	if walkAnimRunning then
		return
	end

	walkAnimRunning = true

	RunService.Heartbeat:Connect(function(deltaTime)
		for _, monster in activeMonsters do
			if monster.Parent then
				local humanoid = monster:FindFirstChildOfClass("Humanoid")
				local root = monster.PrimaryPart
				if humanoid and humanoid.Health > 0 and root then
					keepMonsterUpright(root)
				end
				updateMonsterWalkAnimation(monster, deltaTime)
			end
		end
	end)
end

local function runAI()
	if aiRunning then
		return
	end

	aiRunning = true

	task.spawn(function()
		while true do
			for index = #activeMonsters, 1, -1 do
				local monster = activeMonsters[index]
				if monster.Parent then
					updateMonster(monster)
				else
					lastAttackTimes[monster] = nil
					walkPhases[monster] = nil
					table.remove(activeMonsters, index)
					checkWaveComplete()
				end
			end
			task.wait(WaveConfig.AI_TICK)
		end
	end)
end

function WaveService.clearMonstersForOwner(ownerUserId: number)
	for index = #activeMonsters, 1, -1 do
		local monster = activeMonsters[index]
		if monster:GetAttribute("DungeonOwner") == ownerUserId then
			if monster.Parent then
				monster:Destroy()
			end
			table.remove(activeMonsters, index)
		end
	end
end

function WaveService.setDungeonMode(enabled: boolean)
	dungeonMode = enabled
end

function WaveService.onMonsterDied(callback: (Model) -> ())
	table.insert(monsterDiedCallbacks, callback)
end

function WaveService.setOnPlayerDamagedCallback(callback: ((Player) -> ())?)
	WaveService.onPlayerDamagedCallback = callback
end

function WaveService.spawnDungeonMonsters(
	roomDepth: number,
	ownerUserId: number,
	isBossRoom: boolean,
	radiusMin: number,
	radiusMax: number
): number
	local spawnCount = 0

	if isBossRoom then
		local boss = BossService.createBoss(
			getSpawnPosition(radiusMin, radiusMax),
			roomDepth,
			ownerUserId,
			monstersFolder,
			configureStableHumanoid
		)
		registerMonster(boss)
		spawnCount += 1
	end

	local minionCount = MonsterConfig.getMinionCountForRoom(roomDepth, isBossRoom)
	for _ = 1, minionCount do
		local monsterTypeId = MonsterConfig.rollTypeForDepth(roomDepth)
		local monster = WaveService.createMonster(getSpawnPosition(radiusMin, radiusMax), monsterTypeId, roomDepth)
		monster:SetAttribute("DungeonOwner", ownerUserId)
		spawnCount += 1
	end

	return spawnCount
end

function WaveService.startWave(): boolean
	if waveInProgress or interWaveScheduled then
		return false
	end

	cancelWaveTimeout()
	currentWave += 1
	waveSpawnTotal = WaveConfig.MONSTER_COUNT
	waveInProgress = true
	waveStatus = "fighting"

	for _ = 1, waveSpawnTotal do
		WaveService.createMonster(getSpawnPosition())
	end

	startWaveTimeout()
	broadcastWaveState()
	return true
end

function WaveService.init()
	monstersFolder = workspace:FindFirstChild("WaveMonsters") :: Folder?
	if not monstersFolder then
		monstersFolder = Instance.new("Folder")
		monstersFolder.Name = "WaveMonsters"
		monstersFolder.Parent = workspace
	end

	local startWaveEvent = ReplicatedStorage:FindFirstChild("StartWave") :: RemoteEvent?
	if not startWaveEvent then
		startWaveEvent = Instance.new("RemoteEvent")
		startWaveEvent.Name = "StartWave"
		startWaveEvent.Parent = ReplicatedStorage
	end

	waveStateEvent = ReplicatedStorage:FindFirstChild("WaveState") :: RemoteEvent?
	if not waveStateEvent then
		waveStateEvent = Instance.new("RemoteEvent")
		waveStateEvent.Name = "WaveState"
		waveStateEvent.Parent = ReplicatedStorage
	end

	for _, child in monstersFolder:GetChildren() do
		if child:IsA("Model") and child.Name == "WaveMonster" then
			table.insert(activeMonsters, child)
			waveInProgress = true
			waveStatus = "fighting"
			waveSpawnTotal = math.max(waveSpawnTotal, #activeMonsters)
			currentWave = math.max(currentWave, 1)
		end
	end
	if waveInProgress and #activeMonsters > 0 then
		startWaveTimeout()
	end
	broadcastWaveState()

	startWaveEvent.OnServerEvent:Connect(function(player)
		if dungeonMode then
			return
		end

		if waveInProgress or interWaveScheduled then
			return
		end

		print(`{player.Name} started a wave!`)
		WaveService.startWave()
	end)

	runAI()
	runWalkAnimation()
end

return WaveService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local BroadswordConfig = require(ReplicatedStorage.Shared.BroadswordConfig)
local BroadswordPose = require(ReplicatedStorage.Shared.BroadswordPose)
local HalberdConfig = require(ReplicatedStorage.Shared.HalberdConfig)
local RapierConfig = require(ReplicatedStorage.Shared.RapierConfig)
local WarAxeConfig = require(ReplicatedStorage.Shared.WarAxeConfig)
local WarHammerConfig = require(ReplicatedStorage.Shared.WarHammerConfig)
local WaveConfig = require(ReplicatedStorage.Shared.WaveConfig)
local WeaponCombatConfig = require(ReplicatedStorage.Shared.WeaponCombatConfig)
local WeaponConfig = require(ReplicatedStorage.Shared.WeaponConfig)
local WeaponUpgradeConfig = require(ReplicatedStorage.Shared.WeaponUpgradeConfig)

local CardService = require(script.Parent.CardService)
local GamePhaseService = require(script.Parent.GamePhaseService)
local PlayerDataService = require(script.Parent.PlayerDataService)
local SpellService = require(script.Parent.SpellService)

local WeaponService = {}

local weaponTemplates: { [string]: Tool } = {}
local playerWeapons: { [Player]: string } = {}
local swordHitEvent: RemoteEvent
local equipWeaponEvent: RemoteEvent
local loadoutUpdatedEvent: RemoteEvent
local upgradeWeaponEvent: RemoteEvent
local unlockWeaponEvent: RemoteEvent

local function getSwordHitEvent(): RemoteEvent
	if swordHitEvent then
		return swordHitEvent
	end

	swordHitEvent = ReplicatedStorage:FindFirstChild("SwordHitMonster") :: RemoteEvent?
	if not swordHitEvent then
		swordHitEvent = Instance.new("RemoteEvent")
		swordHitEvent.Name = "SwordHitMonster"
		swordHitEvent.Parent = ReplicatedStorage
	end

	return swordHitEvent
end

local function getEquipWeaponEvent(): RemoteEvent
	if equipWeaponEvent then
		return equipWeaponEvent
	end

	equipWeaponEvent = ReplicatedStorage:FindFirstChild("EquipWeapon") :: RemoteEvent?
	if not equipWeaponEvent then
		equipWeaponEvent = Instance.new("RemoteEvent")
		equipWeaponEvent.Name = "EquipWeapon"
		equipWeaponEvent.Parent = ReplicatedStorage
	end

	return equipWeaponEvent
end

local function getLoadoutUpdatedEvent(): RemoteEvent
	if loadoutUpdatedEvent then
		return loadoutUpdatedEvent
	end

	loadoutUpdatedEvent = ReplicatedStorage:FindFirstChild("LoadoutUpdated") :: RemoteEvent?
	if not loadoutUpdatedEvent then
		loadoutUpdatedEvent = Instance.new("RemoteEvent")
		loadoutUpdatedEvent.Name = "LoadoutUpdated"
		loadoutUpdatedEvent.Parent = ReplicatedStorage
	end

	return loadoutUpdatedEvent
end

