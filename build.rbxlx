	weld(leftLeg, leftShoe, CFrame.new(0, -1.05, 0.08), CFrame.new())

	local rightShoe = createPart("RightShoe", Vector3.new(1.05, 0.35, 1.2), rootCFrame * CFrame.new(0.55, -3.05, 0.08), shoes, model, {
