		description = "Press E to fire an unstable chaos bolt.",
		ultimateDescription = "Press E to hurl an entropy lance.",
		damageMin = 13,
		damageMax = 22,
		projectileSpeed = 96,
		projectileSize = Vector3.new(0.95, 0.95, 3.0),
		projectileColor = Color3.fromRGB(255, 72, 180),
		cooldown = 3.0,
		staminaCost = 35,
		aoeRadius = 0,
	},
}

function SpellConfig.getSpell(id: string): SpellStats?
	return SpellConfig.Spells[id]
end

function SpellConfig.getSpellList(): { SpellStats }
	local list: { SpellStats } = {}
	for _, spell in SpellConfig.Spells do
		table.insert(list, spell)
	end
	table.sort(list, function(a, b)
		return a.displayName < b.displayName
	end)
	return list
end

function SpellConfig.isValid(id: string): boolean
	return SpellConfig.Spells[id] ~= nil
end

return SpellConfig
]]></string>
